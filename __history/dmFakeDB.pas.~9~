unit dmFakeDB;

interface

uses
  System.SysUtils, System.Classes;

const
  DEFAULT_TYPE_CERT_YEARS = 5;

  StdDN: array[0..24] of Integer = (
    2, 4, 6, 8, 10,
    15, 20, 25, 32, 40,
    50, 65, 80, 100, 125,
    150, 200, 250, 300, 400,
    500, 600, 800, 1000, 1200
  );

  StdPointRates: array[0..4] of Double =
    (0.0125, 0.025, 0.25, 0.5, 1.0);

  const
  BaudRates: array[0..4] of Integer = (
    2400,
    4800,
    9600,
    19200,
    115200);

type

  TMeasuredDimension = (
    mdUnknown        = -1,

    mdVolumeFlow     = 0, // Объемный расход (м3/ч)
    mdMassFlow       = 1, // Массовый расход (т/ч, кг/ч)

    mdVolume         = 2, // Объем (л, м3)
    mdMass           = 3, // Масса (кг, т)

    mdSpeed          = 4, // Скорость (м/с)
    mdHeat           = 5  // Теплота (Гкал, МДж)
  );

  TOutputType = (
    otFrequency = 0,
    otImpulse   = 1,
    otVoltage   = 2,
    otCurrent   = 3,
    otInterface = 4,
    otVisual    = 5
  );

  TDeviceCategory = record
    ID: Integer;                          // код категории (как в БД)
    Name: string;                         // отображаемое имя
    MeasuredDimension: TMeasuredDimension;// измеряемая величина
    DefaultOutputType: TOutputType;       // тип сигнала по умолчанию
  end;

  TFlowmeterType = record
    { --- Идентификатор --- }
    ID: Integer;                 // Уникальный идентификатор (PK)

    { --- Текстовые поля --- }
    Name: string;                // Наименование
    Modification: string;        // Модификация (полное имя для АРШИН)
    Manufacturer: string;        // Изготовитель
    ReestrNumber: string;        // ГРСИ

    { --- Даты --- }
    RegDate: TDate;              // Дата регистрации
    ValidityDate: TDate;         // Действие до

    { --- Числовые параметры --- }
    IVI: Integer;                // МПИ (лет)

    Category: Integer;           // Категория СИ
    CategoryName : string;       // Производная

    RangeDynamic: Double;        // Динамический диапазон (Qmax / Qmin)

    { --- Процедуры и методики --- }
    VerificationMethod: string;  // Методика поверки
    ProcedureName: string;       // Тип проводимой процедуры

    { --- Классификация --- }
    AccuracyClass: string;       // Класс точности

    { --- Шаблоны и описания --- }
    SerialNumTemplate: string;   // Шаблон серийного номера
    ReportingForm: string;       // Отчетная форма
    Description: string;         // Описание / примечание

    { --- Выходы --- }
    DimensionCoef : Integer;
    { --- Импульсы --- }
    OutputSet : Integer;
    Freq : Integer;
    Coef: Double;


    FreqFlowRate: Double;


        // --- Напряжение ---
    VoltageRange: Integer;
    // 0 – 1..10 В
    // 1 – 0..10 В
    // 2 – 0..5 В

    VoltageQminRate: Double;
    // Часть от Qmax

    VoltageQmaxRate: Double;
    // Часть от Qmax

        // --- Ток ---
    CurrentRange: Integer;
    // 0 – 4..20 мА
    // 1 – 0..20 мА
    // 2 – 0..5 мА

    CurrentQminRate: Double;
    // Часть от Qmax (0..1)

    CurrentQmaxRate: Double;
    // Часть от Qmax (0..1)

    IntegrationTime: Integer;
    // сек

    // --- Интерфейс ---
    ProtocolName: string;

    BaudRate: Integer;
    // 2400, 4800, 9600, 19200, 115200

    Parity: Integer;
    // 0 – Нет
    // 1 – Четность
    // 2 – Нечетность

    DeviceAddress: Integer;

    // --- Визуальный ввод ---
    InputType: Integer;
    // 0 – Ручной
    // 1 – Фотофиксация


    Documentation: string;
    MeasuredDimension: Integer;
    OutputType: Integer;

    SpillageType: Integer;
    SpillageStop: Integer;
    Repeats: Integer;
    RepeatsProtocol : Integer;

    Error: Double;

  end;

  TDiameter = record
    ID: Integer;
    FlowmeterTypeID: Integer;   // ← ПРИВЯЗКА К ТИПУ

    Name: string;
    DN: string;
    Description: string;

    Qmax: Double;
    Qmin: Double;

    Kp: Double;
    QFmax: Double;

    Vmax: Double;
    Vmin: Double;
  end;

  TFlowmeterTypePoint = record
    { --- Общие данные --- }
    ID: Integer;
    FlowmeterTypeID: Integer;     // привязка к типу
    Name: string;
    Description: string;

    { --- Основные параметры расхода --- }
    FlowRate: Double;             // Q / Qmax (0..1)
    FlowAccuracy: string;         // допустимое отклонение расхода ("±5%", "-5%", "+5%")

    { --- Условия измерения --- }
    Pressure: Double;             // давление, МПа (0 = не применяется)
    Temp: Double;                 // температура, °C (0 = не применяется)
    TempAccuracy: string;         // точность задания температуры, °C

    { --- Ограничения измерения --- }
    LimitImp: Integer;            // количество импульсов
    LimitVolume: Double;          // объем / масса (л, кг)
    LimitTime: Double;            // время измерения, сек

    { --- Погрешности --- }
    Error: Double;                // допустимая относительная погрешность, %

    { --- Прочее --- }
    Pause: Integer;               // время стабилизации, сек

    { --- Повторы измерений --- }
    RepeatsProtocol: Integer;     // повторы, идущие в зачёт
    Repeats: Integer;             // серия измерений (всего)
  end;

  TdmFakeDB = class
