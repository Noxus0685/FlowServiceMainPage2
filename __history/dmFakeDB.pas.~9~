function CategoryToText(ACategory: Integer): string;
begin
  case ACategory of
    1: Result := 'Расходомер электромагнитный';
    2: Result := 'Расходомер кориолисовый';
    3: Result := 'Расходомер вихревой';
    4: Result := 'Расходомер механический';
    5: Result := 'Счётчик воды механический';
    6: Result := 'Ротаметр';
    7: Result := 'Весы';
    8: Result := 'Ёмкость (мерник)';
  else
    Result := 'Неизвестная категория';
  end;
end;

function TdmFakeDB.FindDiameterIndexByID(ADiameterID: Integer): Integer;
var
  I: Integer;
begin
  for I := 0 to High(Diameters) do
    if Diameters[I].ID = ADiameterID then
      Exit(I);

  Result := -1; // не найден
end;

function TdmFakeDB.GetDiameterByID(
  ADiameterID: Integer;
  out ADiameter: TDiameter
): Boolean;
var
  Index: Integer;
begin
  Index := FindDiameterIndexByID(ADiameterID);
  if Index < 0 then
    Exit(False);

  ADiameter := Diameters[Index];
  Result := True;
end;
