    function GetDiameterByID(ADiameterID: Integer; out ADiameter: TDiameter): Boolean;
    function GetDiametersForType(ATypeID: Integer): TArray<TDiameter>;
    function GetNextDiameterID: Integer;

  procedure InitTypePoints;

  function FindTypePointIndexByID(APointID: Integer): Integer;
  function GetTypePointByID(APointID: Integer; out APoint: TFlowmeterTypePoint): Boolean;
  function GetTypePointsForType(ATypeID: Integer): TArray<TFlowmeterTypePoint>;
  function GetNextTypePointID: Integer;

  procedure InitDeviceCategories;
  function  FindCategoryIndexByID(AID: Integer): Integer;
  procedure GetDeviceCategories(out ACategories: TArray<TDeviceCategory>);

  function UpdateType(const AType: TFlowmeterType): Boolean;
  function SaveType(const AType: TFlowmeterType): Boolean;

  // Возвращает точки конкретного типа
  function LoadTypePointsForType(
  ATypeID: Integer
): TArray<TFlowmeterTypePoint>;
  // Возвращает диаметры конкретного типа
  function LoadDiametersForType(
