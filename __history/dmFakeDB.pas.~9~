function TdmFakeDB.FindCategoryIndexByID(AID: Integer): Integer;
var
  I: Integer;
begin
  Result := -1;
  for I := 0 to High(DeviceCategories) do
    if DeviceCategories[I].ID = AID then
      Exit(I);
end;

function TdmFakeDB.FindTypePointIndexByID(APointID: Integer): Integer;
var
  I: Integer;
begin
  for I := 0 to High(TypePoints) do
    if TypePoints[I].ID = APointID then
      Exit(I);
  Result := -1;
end;

function TdmFakeDB.GetTypePointByID(
  APointID: Integer;
  out APoint: TFlowmeterTypePoint
): Boolean;
var
  Idx: Integer;
begin
  Idx := FindTypePointIndexByID(APointID);
  Result := Idx >= 0;
  if Result then
    APoint := TypePoints[Idx];
end;

function TdmFakeDB.GetTypePointsForType(ATypeID: Integer): TArray<TFlowmeterTypePoint>;
var
  I, Cnt: Integer;
begin
  Cnt := 0;
  for I := 0 to High(TypePoints) do
    if TypePoints[I].FlowmeterTypeID = ATypeID then
      Inc(Cnt);

  SetLength(Result, Cnt);
  Cnt := 0;

  for I := 0 to High(TypePoints) do
    if TypePoints[I].FlowmeterTypeID = ATypeID then
    begin
      Result[Cnt] := TypePoints[I];
      Inc(Cnt);
    end;
end;



function TdmFakeDB.GetDiametersForType(ATypeID: Integer): TArray<TDiameter>;
var
  I, Cnt: Integer;
begin
  Cnt := 0;
  for I := 0 to High(Diameters) do
    if Diameters[I].FlowmeterTypeID = ATypeID then
      Inc(Cnt);

  SetLength(Result, Cnt);
  Cnt := 0;

  for I := 0 to High(Diameters) do
    if Diameters[I].FlowmeterTypeID = ATypeID then
    begin
      Result[Cnt] := Diameters[I];
      Inc(Cnt);
    end;
end;


procedure TdmFakeDB.SaveFlowmeterType(const AType: TFlowmeterType);
var
  I: Integer;
begin
  for I := 0 to High(Types) do
    if Types[I].ID = AType.ID then
    begin
      Types[I] := AType;
      Exit;
    end;
end;

