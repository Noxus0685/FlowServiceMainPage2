procedure TFormTypeSelect.ShowTypeInGrid(ANode: TTreeViewItem);
var
  I, Cnt: Integer;
  Kind: TTreeNodeKind;
  Manufacturer, CategoryName, Modification: string;
begin
  // очистка предыдущего результата
  SetLength(FFilteredTypes, 0);
  GridTypes.RowCount := 0;

  if ANode = nil then Exit;

  // определяем тип узла
  Kind := TTreeNodeKind(ANode.TagObject);

  // извлекаем критерии фильтра
  case Kind of
    tnManufacturer:
      Manufacturer := ANode.Text;

    tnCategory:
      begin
        Manufacturer := ANode.ParentItem.Text;
        CategoryName := ANode.Text;
      end;

    tnModification:
      begin
        Manufacturer := ANode.ParentItem.ParentItem.Text;
        CategoryName := ANode.ParentItem.Text;
        Modification := ANode.Text;
      end;
  end;

  // фильтрация типов
  Cnt := 0;
  for I := 0 to High(FTypes) do
  begin
    if (Kind = tnManufacturer) and
       SameText(FTypes[I].Manufacturer, Manufacturer) then
    begin
      Inc(Cnt);
      SetLength(FFilteredTypes, Cnt);
      FFilteredTypes[Cnt - 1] := FTypes[I];
    end
    else
    if (Kind = tnCategory) and
       SameText(FTypes[I].Manufacturer, Manufacturer) and
       SameText(dmFakeDB.CategoryToText(FTypes[I].Category), CategoryName) then
    begin
      Inc(Cnt);
      SetLength(FFilteredTypes, Cnt);
      FFilteredTypes[Cnt - 1] := FTypes[I];
    end
    else
    if (Kind = tnModification) and
       SameText(FTypes[I].Manufacturer, Manufacturer) and
       SameText(dmFakeDB.CategoryToText(FTypes[I].Category), CategoryName) and
       SameText(FTypes[I].Modification, Modification) then
    begin
      Inc(Cnt);
      SetLength(FFilteredTypes, Cnt);
      FFilteredTypes[Cnt - 1] := FTypes[I];
    end;
  end;

  // сообщаем гриду, сколько строк отображать
  GridTypes.BeginUpdate;
  GridTypes.RowCount := Length(FFilteredTypes);
  GridTypes.EndUpdate;
end;

