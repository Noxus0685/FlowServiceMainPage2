procedure TFormTypeSelect.LoadTestData;
var
  I: Integer;
  T: TFlowmeterType;
begin
  SetLength(FTypes, 0);

  for I := 0 to High(FakeDB.Types) do
    if FakeDB.GetTypeByID(FakeDB.Types[I].ID, T) then
    begin
      SetLength(FTypes, Length(FTypes) + 1);
      FTypes[High(FTypes)] := T;
    end;

  UpdateGridTypes;
end;

function IsDateInRange(const ADate, AFrom, ATo: TDate): Boolean;
begin
  Result := (ADate >= AFrom) and (ADate <= ATo);
end;


function NormalizeTreeText(const S: string): string;
begin
  if Trim(S) = '' then
    Result := '<пусто>'
  else
    Result := Trim(S);
end;

function FindChildInTree(
  ATree: TTreeView;
  ATag: Integer;
  const AKey: string
): TTreeViewItem;
var
  I: Integer;
  Item: TTreeViewItem;
begin
  Result := nil;

  for I := 0 to ATree.Count - 1 do
  begin
    Item := ATree.Items[I];
    if (Item.Tag = ATag) and (Item.TagString = AKey) then
      Exit(Item);
  end;
end;

function FindChildInNode(
  AParent: TTreeViewItem;
  ATag: Integer;
  const AKey: string
): TTreeViewItem;
var
  I: Integer;
  Item: TTreeViewItem;
begin
  Result := nil;

  for I := 0 to AParent.Count - 1 do
  begin
    Item := TTreeViewItem(AParent.Items[I]);
    if (Item.Tag = ATag) and (Item.TagString = AKey) then
      Exit(Item);
  end;
end;

function TFormTypeSelect.PassTreeFilter(const AType: TFlowmeterType): Boolean;
var
  Cur: TTreeViewItem;
begin
  Result := True;

  Cur := TreeViewTypes.Selected;
  if Cur = nil then
    Exit(True);

  // Узел "Все"
  if Cur.Tag = Ord(tnAll) then
    Exit(True);

  // -------------------------------------------------
  // Идём ВВЕРХ по дереву и СРАЗУ проверяем
  // -------------------------------------------------
  while Cur <> nil do
  begin
    case Cur.Tag of

      // ---------- ИЗГОТОВИТЕЛЬ ----------
      Ord(tnManufacturer):
        begin
          // TagString = ''  → пустой изготовитель
          if AType.Manufacturer <> Cur.TagString then
            Exit(False);
        end;

      // ---------- КАТЕГОРИЯ ----------
      Ord(tnCategory):
        begin
          if AType.Category <> StrToIntDef(Cur.TagString, -1) then
            Exit(False);
        end;

      // ---------- МОДИФИКАЦИЯ ----------
      Ord(tnModification):
        begin
          // TagString = '' → пустая модификация
          if AType.Modification <> Cur.TagString then
            Exit(False);
        end;
    end;

    Cur := Cur.ParentItem; // 🔴 ТОЛЬКО ParentItem
  end;

  // если дошли сюда — ВСЕ уровни прошли проверку
  Result := True;
end;

procedure TFormTypeSelect.BuildFilteredByTree;
var
  I: Integer;
begin
  SetLength(FFilteredByTree, 0);

  for I := 0 to High(FTypes) do
    if PassTreeFilter(FTypes[I]) then
    begin
      SetLength(FFilteredByTree, Length(FFilteredByTree) + 1);
      FFilteredByTree[High(FFilteredByTree)] := FTypes[I];
    end;
end;

procedure TFormTypeSelect.BuildTree;
var
  T: TFlowmeterType;
  AllNode, ManNode, CatNode, ModNode: TTreeViewItem;

  ManText, ManKey: string;
  CatText, CatKey: string;
  ModText, ModKey: string;

  ManPass, CatPass, ModPass: Integer;
begin
  TreeViewTypes.BeginUpdate;
  try
    TreeViewTypes.Clear;

    // =================================================
    // ВСЕ
    // =================================================
    AllNode := TTreeViewItem.Create(TreeViewTypes);
    AllNode.Text := '...';
    AllNode.Tag := Ord(tnAll);
    AllNode.TagString := '';
    TreeViewTypes.AddObject(AllNode);

    // =================================================
    // ИЗГОТОВИТЕЛИ
    // ManPass = 0 → заполненные
    // ManPass = 1 → пустые (Manufacturer = '')
    // =================================================
    for ManPass := 0 to 1 do
    begin
      for T in FTypes do
      begin
        if (Trim(T.Manufacturer) = '') xor (ManPass = 1) then
          Continue;

        // ---------- Изготовитель ----------
        if Trim(T.Manufacturer) <> '' then
        begin
          ManText := T.Manufacturer;
          ManKey  := T.Manufacturer;
        end
        else
        begin
          ManText := '<изготовитель>';
          ManKey  := '';
        end;

        ManNode := FindChildInTree(
          TreeViewTypes,
          Ord(tnManufacturer),
          ManKey
        );

        if ManNode = nil then
        begin
          ManNode := TTreeViewItem.Create(TreeViewTypes);
          ManNode.Text := ManText;
          ManNode.Tag := Ord(tnManufacturer);
          ManNode.TagString := ManKey;
          TreeViewTypes.AddObject(ManNode);
        end;

        // =================================================
        // КАТЕГОРИИ
        // CatPass = 0 → заполненные
        // CatPass = 1 → пустые (Category = -1)
        // =================================================
        for CatPass := 0 to 1 do
        begin
          if (T.Category = -1) xor (CatPass = 1) then
            Continue;

          if T.Category <> -1 then
          begin
            CatText := FakeDB.CategoryToText(T.Category);
            CatKey  := IntToStr(T.Category);
          end
          else
          begin
            CatText := '<категория>';
            CatKey  := '-1';
          end;

          CatNode := FindChildInNode(
            ManNode,
            Ord(tnCategory),
            CatKey
          );

          if CatNode = nil then
          begin
            CatNode := TTreeViewItem.Create(TreeViewTypes);
            CatNode.Text := CatText;
            CatNode.Tag := Ord(tnCategory);
            CatNode.TagString := CatKey;
            ManNode.AddObject(CatNode);
          end;

          // =================================================
          // МОДИФИКАЦИИ
          // ModPass = 0 → заполненные
          // ModPass = 1 → пустые (Modification = '')
          // =================================================
          for ModPass := 0 to 1 do
          begin
            if (Trim(T.Modification) = '') xor (ModPass = 1) then
              Continue;

            if Trim(T.Modification) <> '' then
            begin
              ModText := T.Modification;
              ModKey  := T.Modification;
            end
            else
            begin
              ModText := '<модификация>';
              ModKey  := '';
            end;

            ModNode := FindChildInNode(
              CatNode,
              Ord(tnModification),
              ModKey
            );

            if ModNode = nil then
            begin
              ModNode := TTreeViewItem.Create(TreeViewTypes);
              ModNode.Text := ModText;
              ModNode.Tag := Ord(tnModification);
              ModNode.TagString := ModKey;
              CatNode.AddObject(ModNode);
            end;
          end;
        end;
      end;
    end;

    TreeViewTypes.ExpandAll;
    TreeViewTypes.Selected := AllNode;

  finally
    TreeViewTypes.EndUpdate;
  end;
end;

procedure TFormTypeSelect.ApplyFilter;
begin
  // формирует FFilteredTypes на основе FFilteredByTree
  ApplyTextFilter;
  ApplyDateFilter;

  // сортировка (утверждённый алгоритм)
  SortFilteredTypes;

  // обновление таблицы
  UpdateGridTypes;
end;

procedure TFormTypeSelect.ButtonTypeAddClick(Sender: TObject);
var
  NewType: TFlowmeterType;
  SelRow: Integer;
begin
  // -------------------------------------------------
  // 1. Формируем новый тип
  // -------------------------------------------------
  SelRow := GridTypes.Row;

  if (SelRow >= 0) and (SelRow < Length(FFilteredTypes)) then
  begin
    // копия выбранного
    NewType := FFilteredTypes[SelRow];
  end
  else
  begin
    // новый пустой
    NewType := Default(TFlowmeterType);
    NewType.Name := 'Новый тип';
    NewType.ProcedureName := 'Поверка';
  end;

  // всегда новый ID
  NewType.ID := GetNextTypeID;

  // -------------------------------------------------
  // 2. Добавляем в основной массив
  // -------------------------------------------------
  AddType(NewType);

  // -------------------------------------------------
  // 3. Полная пересборка UI
  // -------------------------------------------------
  BuildTree;      // дерево + FFilteredByTree
  ApplyFilter;    // FFilteredTypes + сортировка + грид

  // -------------------------------------------------
  // 4. Выделяем добавленную строку
  // -------------------------------------------------
  GridTypes.Row := GridTypes.RowCount - 1;
end;

function TFormTypeSelect.GetNextTypeID: Integer;
var
  I: Integer;
begin
  Result := 1;

  for I := 0 to High(FTypes) do
    if FTypes[I].ID >= Result then
      Result := FTypes[I].ID + 1;
end;


procedure TFormTypeSelect.ButtonTypeClearClick(Sender: TObject);
var
  I, J: Integer;
  IDToDelete: Integer;
begin
  // ничего не отображается
  if Length(FFilteredTypes) = 0 then
    Exit;

  if MessageDlg(
    'Удалить все отображаемые типы?',
    TMsgDlgType.mtWarning,
    [TMsgDlgBtn.mbYes, TMsgDlgBtn.mbNo],
    0
  ) <> mrYes then
    Exit;

  // -------------------------------------------------
  // Удаляем каждый отображаемый тип из FTypes
  // -------------------------------------------------
  for I := High(FFilteredTypes) downto 0 do
  begin
    IDToDelete := FFilteredTypes[I].ID;

    for J := High(FTypes) downto 0 do
      if FTypes[J].ID = IDToDelete then
      begin
        Delete(FTypes, J, 1);
        Break;
      end;
  end;

  // -------------------------------------------------
  // Полная пересборка UI
  // -------------------------------------------------
  BuildTree;          // пересобирает FFilteredByTree и сохраняет ветку
  ApplyFilter;        // формирует FFilteredTypes
  SortFilteredTypes; // твой утверждённый алгоритм сортировки
  UpdateGridTypes;

  GridTypes.Row := -1;
end;

procedure TFormTypeSelect.AddType(const AType: TFlowmeterType);
begin
  SetLength(FTypes, Length(FTypes) + 1);
  FTypes[High(FTypes)] := AType;
end;


procedure TFormTypeSelect.ButtonTypeDeleteClick(Sender: TObject);
var
  SelRow: Integer;
  SelID: Integer;
begin
  // нет данных или нет выбора
  if (Length(FFilteredTypes) = 0) or (GridTypes.Row < 0) then
    Exit;

  SelRow := GridTypes.Row;
  if SelRow >= Length(FFilteredTypes) then
    Exit;

  if MessageDlg(
    'Удалить выбранный тип?',
    TMsgDlgType.mtWarning,
    [TMsgDlgBtn.mbYes, TMsgDlgBtn.mbNo],
    0
  ) <> mrYes then
    Exit;

  // ID выбранного типа
  SelID := FFilteredTypes[SelRow].ID;

  // удаляем из основного массива
  DeleteTypeByID(SelID);

  // полная пересборка UI
  BuildTree;     // пересобирает дерево и FFilteredByTree
  ApplyFilter;   // формирует FFilteredTypes + сортировка + грид

  // сброс выделения (важно для FMX)
  GridTypes.Row := -1;
end;

procedure TFormTypeSelect.DeleteTypeByID(AID: Integer);
var
  I: Integer;
begin
  for I := High(FTypes) downto 0 do
    if FTypes[I].ID = AID then
    begin
      Delete(FTypes, I, 1);
      Exit;
    end;
end;


