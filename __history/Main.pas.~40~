procedure TFormTypeSelect.FilterTypesByTreeNode(ANode: TTreeViewItem);
var
  I, Cnt: Integer;
  Kind: TTreeNodeKind;
  Manufacturer, CategoryName, Modification: string;
begin
  SetLength(FFilteredByTree, 0);

  if ANode = nil then Exit;

  Kind := TTreeNodeKind(ANode.Tag);

  // --- ВСЕ ---
  if Kind = tnAll then
  begin
    SetLength(FFilteredByTree, Length(FTypes));
    for I := 0 to High(FTypes) do
      FFilteredByTree[I] := FTypes[I];
    Exit;
  end;

  Manufacturer := '';
  CategoryName := '';
  Modification := '';

  case Kind of
    tnManufacturer:
      Manufacturer := ANode.Text;

    tnCategory:
      begin
        Manufacturer := ANode.ParentItem.Text;
        CategoryName := ANode.Text;
      end;

    tnModification:
      begin
        Manufacturer := ANode.ParentItem.ParentItem.Text;
        CategoryName := ANode.ParentItem.Text;
        Modification := ANode.Text;
      end;
  end;

  Cnt := 0;
  for I := 0 to High(FTypes) do
    if ((Kind = tnManufacturer) and
        SameText(FTypes[I].Manufacturer, Manufacturer))
    or ((Kind = tnCategory) and
        SameText(FTypes[I].Manufacturer, Manufacturer) and
        SameText(dmFakeDB.CategoryToText(FTypes[I].Category), CategoryName))
    or ((Kind = tnModification) and
        SameText(FTypes[I].Manufacturer, Manufacturer) and
        SameText(dmFakeDB.CategoryToText(FTypes[I].Category), CategoryName) and
        SameText(FTypes[I].Modification, Modification)) then
    begin
      Inc(Cnt);
      SetLength(FFilteredByTree, Cnt);
      FFilteredByTree[Cnt - 1] := FTypes[I];
    end;
end;

function ContainsTextAny(const AText, AFind: string): Boolean;
begin
  Result := (AFind = '') or
            ContainsText(AText, AFind);
end;


procedure TFormTypeSelect.ApplyTextFilter;
var
  I, Cnt: Integer;
  S: string;
begin
  S := Trim(EditFindType.Text);

  // ===== ПУСТО → копируем всё после Tree =====
  if S = '' then
  begin
    SetLength(FFilteredByText, Length(FFilteredByTree));
    for I := 0 to High(FFilteredByTree) do
      FFilteredByText[I] := FFilteredByTree[I];
  end
  else
  begin
    SetLength(FFilteredByText, 0);
    Cnt := 0;

    for I := 0 to High(FFilteredByTree) do
      with FFilteredByTree[I] do
        if ContainsText(Name, S)
        or ContainsText(Manufacturer, S)
        or ContainsText(CategoryName, S)
        or ContainsText(Modification, S)
        or ContainsText(AccuracyClass, S)
        or ContainsText(ProcedureName, S)
        or ContainsText(ReestrNumber, S)
        or ContainsText(VerificationMethod, S) then
        begin
          Inc(Cnt);
          SetLength(FFilteredByText, Cnt);
          FFilteredByText[Cnt - 1] := FFilteredByTree[I];
        end;
  end;

  // ===== РЕЗУЛЬТАТ ПОКА = ПОСЛЕ ТЕКСТА =====
  SetLength(FFilteredTypes, Length(FFilteredByText));
  for I := 0 to High(FFilteredByText) do
    FFilteredTypes[I] := FFilteredByText[I];
end;

procedure TFormTypeSelect.ApplyDateFilter;
var
  I, Cnt: Integer;
  FilterDate: TDate;
begin
  // ===== ДАТА НЕ ЗАДАНА =====
  if DateEditFilter.IsEmpty then
  begin
    SetLength(FFilteredByDate, Length(FFilteredByText));
    for I := 0 to High(FFilteredByText) do
      FFilteredByDate[I] := FFilteredByText[I];
  end
  else
  begin
    FilterDate := DateEditFilter.Date;

    SetLength(FFilteredByDate, 0);
    Cnt := 0;

    for I := 0 to High(FFilteredByText) do
      if IsDateInRange(
           FilterDate,
           FFilteredByText[I].RegDate,
           FFilteredByText[I].ValidityDate
         ) then
      begin
        Inc(Cnt);
        SetLength(FFilteredByDate, Cnt);
        FFilteredByDate[Cnt - 1] := FFilteredByText[I];
      end;
  end;

  // ===== РЕЗУЛЬТАТ = ПОСЛЕ ДАТЫ =====
  SetLength(FFilteredTypes, Length(FFilteredByDate));
  for I := 0 to High(FFilteredByDate) do
    FFilteredTypes[I] := FFilteredByDate[I];
end;



procedure TFormTypeSelect.UpdateGridTypes;
begin
  GridTypes.BeginUpdate;
  GridTypes.RowCount := Length(FFilteredTypes);
  GridTypes.EndUpdate;

  sbFind.IsPressed:= HasActiveFilters;
end;

function TFormTypeSelect.HasActiveFilters: Boolean;
begin
  Result :=
    (Trim(EditFindType.Text) <> '') or
    (not DateEditFilter.IsEmpty);
end;

procedure TFormTypeSelect.OpenTypeEditor(ATypeID: Integer);
var
  Form: TFormTypeEditor;
begin
  Form := TFormTypeEditor.Create(nil);
  try
    Form.LoadType(ATypeID);
    Form.ShowModal;

    if Form.Modified then
      UpdateGridTypes;
  finally
    Form.Free;
  end;
end;


procedure TFormTypeSelect.SortFilteredTypes;
var
  I, J: Integer;
  T: TFlowmeterType;
  Cmp: Integer;
begin
  if (FSortColumn < 0) or (Length(FFilteredTypes) < 2) then
    Exit;

  for I := 0 to High(FFilteredTypes) - 1 do
    for J := I + 1 to High(FFilteredTypes) do
    begin
      Cmp := CompareTypes(
        FFilteredTypes[I],
        FFilteredTypes[J],
        FSortColumn
      );

      if not FSortAscending then
        Cmp := -Cmp;

      if Cmp > 0 then
      begin
        T := FFilteredTypes[I];
        FFilteredTypes[I] := FFilteredTypes[J];
        FFilteredTypes[J] := T;
      end;
    end;
end;

procedure TFormTypeSelect.SpeedButtonFindInternetClick(Sender: TObject);
var
  Resp: IHTTPResponse;
  Url: string;
  ResponseText: string;
  Json: TJSONObject;
  ResultObj: TJSONObject;
  Items: TJSONArray;
  Item: TJSONObject;
  I: Integer;
  T: TFlowmeterType;
  SearchText: string;
  DetectText: string;
  TotalCount: Integer;
begin
  // Показываем лог
  MemoLog.Visible := True;
  MemoLog.Lines.Clear;

  if EditFindType.Text.Trim = '' then
  begin
    MemoLog.Lines.Add('Пустая строка поиска');
    Exit;
  end;

  // Формируем *ПОИСК*
  SearchText := '*' + EditFindType.Text.Trim + '*';

  Url :=
    'https://fgis.gost.ru/fundmetrology/eapi/mit/' +
    '?search=' + TNetEncoding.URL.Encode(SearchText) +
    '&start=0&rows=100';

  try
    // HTTP-запрос
    Resp := NetHTTPClient1.Get(Url);
    ResponseText := Resp.ContentAsString;

    // Лог сырого ответа
    MemoLog.Lines.Add('URL: ' + Url);
    MemoLog.Lines.Add('Status: ' + Resp.StatusCode.ToString);
    MemoLog.Lines.Add('------------------------------');
    MemoLog.Lines.Add(ResponseText);
    MemoLog.Lines.Add('------------------------------');

    // Парсинг JSON
    Json := TJSONObject.ParseJSONValue(ResponseText) as TJSONObject;
    try
      if Json = nil then Exit;

      ResultObj := Json.GetValue('result') as TJSONObject;
      if ResultObj = nil then Exit;

      // ============================
      // ПРОВЕРКА КОЛИЧЕСТВА
      // ============================
      TotalCount := ResultObj.GetValue<Integer>('count');

      if TotalCount > 100 then
      begin
        MemoLog.Lines.Add(
          Format(
            'Найдено %d записей. Уточните запрос.',
            [TotalCount]
          )
        );

        ShowMessage(
          Format(
            'Найдено %d записей.' + sLineBreak +
            'Уточните запрос для уменьшения выборки.',
            [TotalCount]
          )
        );

        Exit;
      end;
      // ============================

      Items := ResultObj.GetValue('items') as TJSONArray;
      if Items = nil then Exit;

      // Очистка модели
      SetLength(FTypes, 0);

      // Заполнение модели
      for I := 0 to Items.Count - 1 do
      begin
        Item := Items.Items[I] as TJSONObject;

        // Обнуление record
        FillChar(T, SizeOf(T), 0);
        T.Category := -1;

        // mit_uuid
        if Item.GetValue('mit_uuid') <> nil then
          T.MitUUID := Item.GetValue('mit_uuid').Value;

        // ГРСИ
        if Item.GetValue('number') <> nil then
          T.ReestrNumber := Item.GetValue('number').Value;

        // Имя
        if Item.GetValue('notation') <> nil then
          T.Name := Item.GetValue('notation').Value;

        // title → CategoryName
        if Item.GetValue('title') <> nil then
          T.CategoryName := Item.GetValue('title').Value;

        // manufacturers → Manufacturer
        if Item.GetValue('manufacturers') <> nil then
          T.Manufacturer :=
            ExtractManufacturerName(
              Item.GetValue('manufacturers').Value
            );

        // ============================
        // АВТОАНАЛИЗ КАТЕГОРИИ
        // ============================
        DetectText :=
          NormalizeSearchText(
            T.CategoryName + ' ' + T.Name
          );

        T.Category :=
          FakeDB.DetectCategoryByKeywords(DetectText);
        // если не найдено → -1
        // ============================

        // Добавляем в массив
        SetLength(FTypes, Length(FTypes) + 1);
        FTypes[High(FTypes)] := T;
      end;

    finally
      Json.Free;
    end;

    // Обновляем дерево
    BuildTree;

  except
    on E: Exception do
      MemoLog.Lines.Add('ERROR: ' + E.Message);
  end;
end;

function TFormTypeSelect.CompareTypes(
  const A, B: TFlowmeterType;
  ACol: Integer
): Integer;
begin
  if ACol = StringColumnName.Index then
    Result := CompareText(A.Name, B.Name)

  else if ACol = StringColumnCategory.Index then
    Result := CompareText(A.CategoryName, B.CategoryName)

  else if ACol = StringColumnManufacturer.Index then
    Result := CompareText(A.Manufacturer, B.Manufacturer)

  else if ACol = StringColumnModification.Index then
    Result := CompareText(A.Modification, B.Modification)

  else if ACol = StringColumnAccuracyClass.Index then
    Result := CompareText(A.AccuracyClass, B.AccuracyClass)

  else if ACol = StringColumnReestrNumber.Index then
    Result := CompareText(A.ReestrNumber, B.ReestrNumber)

  else if ACol = StringColumnProcedure.Index then
    Result := CompareText(A.ProcedureName, B.ProcedureName)

  else if ACol = StringColumnVerificationMethod.Index then
    Result := CompareText(A.VerificationMethod, B.VerificationMethod)

  else if ACol = StringColumnIVI.Index then
    Result := A.IVI - B.IVI

  else if ACol = StringColumnRegDate.Index then
    Result := CompareDateTime(A.RegDate, B.RegDate)

  else if ACol = StringColumnValidityDate.Index then
    Result := CompareDateTime(A.ValidityDate, B.ValidityDate)

  else
    Result := 0;
end;

