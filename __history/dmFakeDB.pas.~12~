function TdmFakeDB.UpdateType(const AType: TFlowmeterType): Boolean;
var
  I: Integer;
begin
  Result := False;

  for I := 0 to High(Types) do
    if Types[I].ID = AType.ID then
    begin
      Types[I] := AType;
      Exit(True);
    end;
end;


function TdmFakeDB.SaveType(const AType: TFlowmeterType): Boolean;
var
  I: Integer;
begin
  // 1. Пытаемся найти и обновить
  for I := 0 to High(Types) do
    if Types[I].ID = AType.ID then
    begin
      Types[I] := AType;
      Exit(True);
    end;

  // 2. Если не нашли — добавляем как новый
  SetLength(Types, Length(Types) + 1);
  Types[High(Types)] := AType;

  Result := True;
end;

