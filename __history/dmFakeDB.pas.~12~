    Diameters[D] := Default(TDiameter);
    Diameters[D].ID := AID;
    Diameters[D].FlowmeterTypeID := ATypeID;
    Diameters[D].Name := 'DN' + ADN;
    Diameters[D].DN := ADN;
    Diameters[D].Qmax := AQmax;
    Diameters[D].Qmin := AQmin;
    Diameters[D].Kp := AKp;
    Diameters[D].QFmax := AQmax;
    Inc(D);
