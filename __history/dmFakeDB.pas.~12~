function TdmFakeDB.SaveDiameters(
  ATypeID: Integer;
  const ADiameters: TArray<TDiameter>
): Boolean;
var
  I: Integer;
begin
  Result := False;

  try
    // ==================================================
    // 1. Удаляем все диаметры данного типа
    // ==================================================
    for I := High(Diameters) downto Low(Diameters) do
      if Diameters[I].FlowmeterTypeID = ATypeID then
        Delete(Diameters, I, 1);

    // ==================================================
    // 2. Добавляем новые диаметры
    // ==================================================
    for I := 0 to High(ADiameters) do
    begin
      ADiameters[I].ID := GenerateDiameterID;
      ADiameters[I].FlowmeterTypeID := ATypeID;

      AddDiameter(ADiameters[I]);
    end;

    Result := True;
  except
    Result := False;
  end;
end;


function TdmFakeDB.SavePoints(
  ATypeID: Integer;
  const APoints: TArray<TFlowmeterTypePoint>
): Boolean;
var
  I: Integer;
begin
  Result := False;

  try
    // ==================================================
    // 1. Удаляем все точки данного типа
    // ==================================================
    for I := High(TypePoints) downto Low(TypePoints) do
      if TypePoints[I].FlowmeterTypeID = ATypeID then
        Delete(TypePoints, I, 1);

    // ==================================================
    // 2. Добавляем новые точки
    // ==================================================
    for I := 0 to High(APoints) do
    begin
      APoints[I].ID := GeneratePointID;
      APoints[I].FlowmeterTypeID := ATypeID;

      AddFlowmeterTypePoint(APoints[I]);
    end;

    Result := True;
  except
    Result := False;
  end;
end;

function TdmFakeDB.GenerateDiameterID: Integer;
var
  I, MaxID: Integer;
begin
  MaxID := 0;

  for I := 0 to High(Diameters) do
    if Diameters[I].ID > MaxID then
      MaxID := Diameters[I].ID;

  Result := MaxID + 1;
end;

procedure TdmFakeDB.AddDiameter(const ADiameter: TDiameter);
var
  L: Integer;
begin
  L := Length(Diameters);
  SetLength(Diameters, L + 1);
  Diameters[L] := ADiameter;
end;

procedure TdmFakeDB.AddFlowmeterTypePoint(
  const APoint: TFlowmeterTypePoint);
var
  L: Integer;
begin
  L := Length(TypePoints);
  SetLength(TypePoints, L + 1);
  TypePoints[L] := APoint;
end;

function TdmFakeDB.GeneratePointID: Integer;
var
  I, MaxID: Integer;
begin
  MaxID := 0;

  for I := 0 to High(TypePoints) do
    if TypePoints[I].ID > MaxID then
      MaxID := TypePoints[I].ID;

  Result := MaxID + 1;
end;

