unit UnitManagerData;

interface

uses
  uDATA,
  UnitClasses,
  UnitRepositories,
  System.IniFiles,
  System.Classes,
  System.SysUtils,    System.DateUtils,
  System.Generics.Collections,
  FireDAC.Comp.Client,
  FireDAC.Stan.Param,
  FireDAC.Stan.Option,
  FireDAC.Stan.Intf;

type

  TRepositoryKind = (rkType, rkResults);


  TManagerTDM = class
  private

    FIniFileName: string;

    FDms: TObjectDictionary<string, TDM>;
    FRepositories: TObjectDictionary<string, TObject>;

    procedure LoadSettings;
    procedure CreateRepository(const AName: string; AKind: TRepositoryKind; ADM: TDM);

  public

    ActiveRepo:  TTypeRepository;
    constructor Create(const AIniFileName: string);
    destructor Destroy; override;

    procedure AddRepository(
  const AName: string;
  AKind: TRepositoryKind;
  const ADbFile: string
);

    procedure RemoveRepository(const AName: string);

    function GetRepository(const AName: string): TObject;

    procedure CloseAll;


  end;

 var

  ManagerRepo: TManagerTDM;

implementation


{====TManagerTDM++++++++}
constructor TManagerTDM.Create(const AIniFileName: string);
begin
  inherited Create;

  FIniFileName := AIniFileName;

  FDms := TObjectDictionary<string, TDM>.Create([doOwnsValues]);
  FRepositories := TObjectDictionary<string, TObject>.Create([doOwnsValues]);

  LoadSettings;
end;


function RepositoryKindFromString(const S: string): TRepositoryKind;
begin
  if SameText(S, 'TypeRepository') then
    Result := rkType
  else if SameText(S, 'ResultsRepository') then
    Result := rkResults
  else
    raise Exception.Create('Unknown repository kind: ' + S);
end;

function RepositoryKindToString(AKind: TRepositoryKind): string;
begin
  case AKind of
    rkType:    Result := 'TypeRepository';
    rkResults: Result := 'ResultsRepository';
  else
    raise Exception.Create('Unknown repository kind');
  end;
end;

procedure TManagerTDM.LoadSettings;
var
  Ini: TIniFile;
  Names: TStringList;
  I: Integer;
  RepoName: string;
  DbFile: string;
  KindStr: string;
  Kind: TRepositoryKind;
  DM: TDM;
begin
  // 1. Если файла нет — создаём пустой
  if not FileExists(FIniFileName) then
    TIniFile.Create(FIniFileName).Free;

  Ini := TIniFile.Create(FIniFileName);
  Names := TStringList.Create;
  try
    // 2. Читаем список репозиториев
    Ini.ReadSection('Repositories', Names);

    // 3. Если репозиториев нет — ничего не создаём
    if Names.Count = 0 then
      Exit;

    // 4. Загружаем репозитории по настройкам
    for I := 0 to Names.Count - 1 do
    begin
      RepoName := Names[I];

      DbFile := Ini.ReadString('Repositories', RepoName, '');
      KindStr := Ini.ReadString('Repository.' + RepoName, 'Kind', '');

      if (DbFile = '') or (KindStr = '') then
        Continue;

      // 5. Преобразуем строку Kind → enum
      Kind := RepositoryKindFromString(KindStr);

      // 6. Создаём и открываем БД
      DM := TDM.Create(nil);
      OpenDatabase(DM, DbFile);

      FDms.Add(RepoName, DM);

      // 7. Создаём репозиторий нужного типа
      CreateRepository(RepoName, Kind, DM);
    end;
  finally
    Names.Free;
    Ini.Free;
  end;
end;

procedure TManagerTDM.CreateRepository(
  const AName: string;
  AKind: TRepositoryKind;
  ADM: TDM
);
var
  Repo: TObject;
begin
  Repo := nil;

  case AKind of
    rkType:
    begin
      Repo := TTypeRepository.Create(ADM);
      FRepositories.Add(AName, Repo);
    end;
    rkResults:
      //Repo := TResultRepository.Create(ADM);
  end;


end;

procedure TManagerTDM.AddRepository(
  const AName: string;
  AKind: TRepositoryKind;
  const ADbFile: string
);
var
  Ini: TIniFile;
  DM: TDM;
  KindStr: string;
begin
  // защита от дублей в памяти
  if FDms.ContainsKey(AName) or FRepositories.ContainsKey(AName) then
    raise Exception.Create('Repository already exists: ' + AName);

  KindStr := RepositoryKindToString(AKind);


  // 1. Сохраняем настройки
  Ini := TIniFile.Create(FIniFileName);
  try
    Ini.WriteString('Repositories', AName, ADbFile);
    Ini.WriteString('Repository.' + AName, 'Kind', KindStr);
    Ini.UpdateFile;
  finally
    Ini.Free;
  end;

  // 2. Создаём и открываем БД
  DM := TDM.Create(nil);
  OpenDatabase(DM, ADbFile);
  FDms.Add(AName, DM);

  // 3. Создаём репозиторий нужного типа
  CreateRepository(AName, AKind, DM);
end;

procedure TManagerTDM.RemoveRepository(const AName: string);
var
  Ini: TIniFile;
begin
  FRepositories.Remove(AName);
  FDms.Remove(AName);

  Ini := TIniFile.Create(FIniFileName);
  try
    Ini.DeleteKey('Repositories', AName);
    Ini.EraseSection('Repository.' + AName);
    Ini.UpdateFile;
  finally
    Ini.Free;
  end;
end;

function TManagerTDM.GetRepository(const AName: string): TObject;
begin
  Result := FRepositories[AName];
end;

procedure   TManagerTDM.CloseAll;
begin
  FDms.Clear;         // освобождает все TDM
  FRepositories.Clear;
end;

destructor  TManagerTDM.Destroy;
begin
  CloseAll;
  FDms.Free;
  FRepositories.Free;
  inherited;
end;

{====}



end.
