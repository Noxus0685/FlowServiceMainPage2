<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{904BA7B5-24D3-4C12-8AC3-303CA322F9EA}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="TestComponents\testComponents.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="fmxfp.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="testComponents">
        <MSBuild Projects="TestComponents\testComponents.dproj"/>
    </Target>
    <Target Name="testComponents:Clean">
        <MSBuild Projects="TestComponents\testComponents.dproj" Targets="Clean"/>
    </Target>
    <Target Name="testComponents:Make">
        <MSBuild Projects="TestComponents\testComponents.dproj" Targets="Make"/>
    </Target>
    <Target Name="fmxfp">
        <MSBuild Projects="fmxfp.dproj"/>
    </Target>
    <Target Name="fmxfp:Clean">
        <MSBuild Projects="fmxfp.dproj" Targets="Clean"/>
    </Target>
    <Target Name="fmxfp:Make">
        <MSBuild Projects="fmxfp.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="testComponents;fmxfp"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="testComponents:Clean;fmxfp:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="testComponents:Make;fmxfp:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
