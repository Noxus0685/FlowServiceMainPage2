{-----------UpdateNext- begin of procedure ---------}
procedure TFmxModuleManager.UpdateNext;
var
  StartTime, PortTime, SendTime, ReadTime, UpdateTime: Cardinal;
  ProcessingTime: Cardinal;

  PortInfo: TComPortInfo;
  PortIndex:integer;
  CurrentModuleObj: TFmxModule;
  stage, i, j, mlen, RequestLength, ResponseLength: integer;
  readed: Cardinal;
  written: Cardinal;
  output_buffer, in_buff: array [0..255] of ansichar;
  _TypeOfProtocol: TTypeOfProtocol;
  response: ShortString;
  request: ShortString;
  _output_buffer, _in_buff: TIdBytes;


  procedure ExecuteErrorTransaction();
  begin
    //таймаут
    if Assigned(CurrentModuleObj) then
    begin
      CurrentModuleObj.BadPackages := CurrentModuleObj.BadPackages + 1;
      if not CurrentModuleObj.Disguise then CurrentModuleObj.ConnectIsOK := fdqBad;
      if CurrentModuleObj.Protocol<>tpModbusTCP then
      begin
         if PortIndex>=0 then
           Inc(FComPorts[PortIndex].TimeOuts);
      end;
      CurrentModuleObj.TimeOuts := CurrentModuleObj.TimeOuts + 1;
      //вызывает отработку таймаута
      CurrentModuleObj.ReceiveResponse();
      //отрабатываем, что она была не удачной
      if Debug then DebugOutput('<UpdateNextX:[' + CurrentModuleObj.ModuleName + '] Responce TIMEOUT - STAGE:' + IntToStr(stage) + '>');
      //вызывает отработку таймаута
      CurrentModuleObj.ReceiveResponse('*', '');
    end;
    GetNextCurrentModule();
  end;

begin
  //Для отладки, когда не требуется заваливать лог командами опроса
  mlen := Length(Modules);
  if
     (
       (mlen = 0) or
       (not Update) or
       (not Active) or
       (not HasActiveModules) or
       (not Assigned(Application))
     )
   then begin
    Sleep(100);//Если
    Exit;
  end;

  StartTime := GetTickCount;
  try

    CurrentModuleObj := Modules[CurrentModule];

    // Очистка неиспользуемых портов при каждом полном цикле опроса
    if CurrentModule = FirstActiveModule then
    begin
      CleanupUnusedPorts(5); // Очищаем порты, неиспользуемые более 5 минут
    end;

    if not Assigned(CurrentModuleObj) then
    begin
      if Debug then DebugOutput('UpdateNext: CurrentModuleObj is nil, skipping');
      GetNextCurrentModule();
      Exit;
    end;

    if Debug then DebugOutput('UpdateNext: Processing module: ' + CurrentModuleObj.ModuleName +
               ', Disguise=' + BoolToStr(CurrentModuleObj.Disguise, True) +
               ', Enabled=' + BoolToStr(CurrentModuleObj.EnabledAutoUpdate, True));

    // ВАЖНОЕ ИЗМЕНЕНИЕ: ДЛЯ ОТКЛЮЧЕННЫХ МОДУЛЕЙ ВЫЗЫВАЕМ ReceiveResponse ОДИН РАЗ
    if CurrentModuleObj.Disguise or (not CurrentModuleObj.EnabledAutoUpdate) then
    begin
      if Debug then DebugOutput('UpdateNext: Module skipped - calling ReceiveResponse once');
      // ВЫЗЫВАЕМ ReceiveResponse ДЛЯ ОТКЛЮЧЕННЫХ МОДУЛЕЙ
      CurrentModuleObj.ReceiveResponse('*', '');
      GetNextCurrentModule();
      Exit;
    end;

    // ОСНОВНАЯ ЛОГИКА ОПРОСА (ОРИГИНАЛЬНАЯ)
    if (not CurrentModuleObj.Disguise) then
    begin
      if CurrentModuleObj.EnabledAutoUpdate then
      // и если контроллер активен (не отключен)
      begin
        CurrentModuleObj.TotalSended := CurrentModuleObj.TotalSended + 1;
        //обновляемся, если только сменятся значения
        CurrentModuleObj.MustUpdate:=False;
        // узнаем тип протокола - на данный момент все протоколы, кроме Modbus TCP работают через компорт, на это пока и ориентируемся
        _TypeOfProtocol := CurrentModuleObj.Protocol;

        //
        // ИСПРАВЛЕНИЕ: Используем справочник портов вместо постоянного открытия/закрытия
        //
        PortTime := GetTickCount;
        PortReady := False;
        if _TypeOfProtocol in [tpProprietary..tpModbusASCII] then
        begin
          // Получаем порт из справочника (откроется если нужно)
          if not GetComPort(CurrentModuleObj.PortNumber,
                           CurrentModuleObj.BaudRate,
                           ord(CurrentModuleObj.Parity),
                           CurrentModuleObj.Timeout,
                           PortInfo,PortIndex) then
          begin
            PortReady := False;
            PortState := 'Ошибка открытия порта COM' + IntToStr(CurrentModuleObj.PortNumber);
            AddToLog(CurrentModuleObj, @output_buffer[0], 0, true);
            CurrentModuleObj.ConnectIsOK := fdqBad;
            ErrorConnection := True;
            ExecuteErrorTransaction();
            Sleep(cErrorOpenComPortDelay);
            Exit;
          end;

          // Используем handle из справочника
          Port := PortInfo.PortHandle;
          PortReady := PortInfo.IsOpen;

          {$IFDEF MSWINDOWS}
          // Настраиваем таймауты для текущего модуля
          if Update then
          begin
            CTO.ReadTotalTimeoutConstant := CurrentModuleObj.Timeout + DopTimOut;
            SetCommTimeouts(Port, CTO);
          end;
          if PortIndex>=0 then begin
            GetCommState(PortInfo.PortHandle, DCB);
            if (DCB.BaudRate <> CurrentModuleObj.baudrate) or
               (DCB.Parity <> ord(CurrentModuleObj.parity)) then
            begin
              FComPorts[PortIndex].baudrate:=CurrentModuleObj.baudrate;
              FComPorts[PortIndex].parity:=ord(CurrentModuleObj.parity);
              DCB.BaudRate := FComPorts[PortIndex].baudrate;
              DCB.Parity := FComPorts[PortIndex].parity;
              SetCommState(PortInfo.PortHandle, DCB);
            end;
            FComPorts[PortIndex].TimeOut:=CTO.ReadTotalTimeoutConstant;
          end;
          {$ENDIF}
        end
        else
        begin
          //Modbus TCP - подключаемся
          try
            PortReady := TCP_Client_Connected;
          except
            on e: exception do
            begin
              PortReady := False;//для корректной отработки лога
              PortState := 'Ошибка подключения к Modbus TCP серверу:' + e.Message;
              AddToLog(CurrentModuleObj, @output_buffer[0], 0, true);
              ErrorConnection := True;
            end;
          end;
        end;
        PortTime := GetTickCount - PortTime;
        ErrorConnection := False;

        if PortReady then
        begin
          //-------------- Если порт готов к обмена
          try
            //пытаемся, при неудачной попытке SENDING_TRIES_COUNT раз повторить операцию
            // выбираем команду статуса текущего модуля.
            //Получили содержимое пакета лоя отправки
            request := CurrentModuleObj.StatusQuery; //важно забрать значение посылки одномоментно 13.06.2024
            //подсчитали длину пакета для отправки
            RequestLength := Length(request);
            //получили длину ожидаемого ответа
            ResponseLength := CurrentModuleObj.ResponseLength;

            for j := 1 to RequestLength do
              output_buffer[j - 1] := request[j];

            //для TCP клиента формирвем запрос
            if _TypeOfProtocol = tpModbusTCP then
              _output_buffer := RawToBytes(output_buffer, RequestLength);

            //если должны ожидать ответ
            if (RequestLength > 0) then
            begin
              for stage := 1 to SENDING_TRIES_COUNT do
              begin
                if not Active then Exit;
                if CurrentModuleObj.Disguise then break;

                //если это повтор - следующую операцию выполняем с задержкой 28.03.2024
                if stage > 1 then
                begin
                  Sleep(cDelayAfterErrorFirstRequest * stage * 2);
                end
                else begin
                  if Debug then
                    DebugOutput('<CMD:' + request + 'STAGE:' + IntToStr(stage) + '>');
                end;

                // Замер времени отправки
                SendTime := GetTickCount;
                //отправка запроса
                if Update then
                try
                  if _TypeOfProtocol in [tpProprietary..tpModbusASCII] then
                  begin
{$IFDEF MSWINDOWS}
                      //rs485
                      //Включим линию RTS, нужна для работы прэмов
                      if Update then
                        EscapeCommFunction(Port, SETRTS);
                      //сбрасываем предыдущие операции по порту
                      if Update then
                        PurgeComm(Port, PURGE_TXABORT or PURGE_RXABORT or PURGE_TXCLEAR or PURGE_RXCLEAR);
                      // отправляем команду запроса статуса
                      if Update then
                        WriteFile(Port, output_buffer, RequestLength, written, nil);
                      //
                      if PortIndex>=0 then
                         Inc(FComPorts[PortIndex].TotalAttempts);
{$ENDIF}
                  end
                  else begin
                    //Modbus TCP
                    readed := 0;
                    SetLength(_in_buff, 0);//сбрасываем входной буфер
                    if Update then
                       TCP_Client.Socket.Write(_output_buffer);
                    written := RequestLength;
                  end;
                except
                  on e: Exception do
                  begin
                    PortReady := False;//для корректной отработки лога
                    PortState := 'Ошибка отправки запроса:' + e.Message;
                  end;
                end;
                if Optimization then sleep(cSleepBeforeRead);
                // ... код отправки ...
                SendTime := GetTickCount - SendTime;
                // Замер времени чтения
                ReadTime := GetTickCount;
                //Пока контроллер думает над ответом - выводим лог
                AddToLog(CurrentModuleObj, @output_buffer[0], RequestLength, True);
                //если ответ ожидается
                if (ResponseLength > 0) then
                begin

                  // считываем ответ
                  try
                    if _TypeOfProtocol in [tpProprietary..tpModbusASCII] then
                    begin
{$IFDEF MSWINDOWS}
                      //rs485
                      if CurrentModuleObj.TerminatedChar=#$00 then
                      begin
                        if Update then
                        begin
                           GetCommTimeouts(Port, ActualTimeouts);
                           ReadFile(Port, in_buff, ResponseLength mod 256, readed, nil)
                        end;
                      end   
                      else begin
                        var ch:AnsiChar;
                        var total_readed:integer;
                        total_readed:=0;
                        for i := 1 to (ResponseLength mod 256) do
                        begin
                           if Update then
                           begin
                              GetCommTimeouts(Port, ActualTimeouts);
                              ReadFile(Port, ch, 1, readed, nil);
                           end;
                           if (readed=1) then
                           begin
                              in_buff[i-1]:=ch;
                              Inc(total_readed);
                              if (ch=CurrentModuleObj.TerminatedChar) or (readed=0) then break;
                           end;
                        end;
                        readed:=total_readed;
                        ResponseLength:=readed;

                      end;
{$ENDIF}
                    end
                    else begin
                      //Modbus TCP
                      try
                        if Update then
                           TCP_Client.Socket.ReadBytes(_in_buff, -1);
                        readed := Length(_in_buff);
                        for i := 0 to readed - 1 do
                          in_buff[i] := AnsiChar(_in_buff[i]);
                      except
                        on e: exception do
                        begin
                          PortReady := False;//для корректной отработки лога
                          PortState := 'Ошибка чтения из Modbus TCP сервера:' + e.Message;
                          readed := 0;
                        end;
                      end;
                    end;
                  except
                    on e: Exception do
                    begin
                      PortReady := False;//для корректной отработки лога
                      PortState := 'Ошибка получения ответа:' + e.Message;
                    end;
                  end;
                  // ... код чтения ...
                  ReadTime := GetTickCount - ReadTime;

                  if (ResponseLength <> readed) then
                  begin
                    AddToLog(CurrentModuleObj, @in_buff[0], readed, false, true)
                  end
                  else
                    AddToLog(CurrentModuleObj, @in_buff[0], readed, false);

                  //пишем в лог что (MustBytesRead) количество ожидаемых байт
                  //не соответствуют реально считанным (Real Readed)
                  if (ResponseLength <> readed) then
                    if Debug then
                      DebugOutput('[' + CurrentModuleObj.ModuleName + '] MBR:' + IntToStr(ResponseLength) + ' RR:' + IntToStr(readed));

                  //переносим результат в ответ
                  //если есть принятые данные
                  response := '';
                  if readed > 0 then
                  begin
                    for j := 1 to readed do
                    begin
                      response := response + in_buff[j - 1];
                    end;
                    //проверяем их корректность
                    if CurrentModuleObj.CheckResponse(request, response) then
                    begin
                      CurrentModuleObj.TotalReceived := CurrentModuleObj.TotalReceived + 1;
                      if Debug then
                        DebugOutput('<UpdateNext:[' + CurrentModuleObj.ModuleName + '] Response OK - STAGE:' + IntToStr(stage) + '>');
                      UpdateTime:=GetTickCount;
                      try
                        CurrentModuleObj.ReceiveResponse(request, response); // !!! 22.07.2008
                        //если после повторов есть какой-то ответ
                        //если есть корректный ответ
                        //берем следующий модуль
                        GetNextCurrentModule(true);
                      except
                        on e: exception do
                        begin
                          PortReady := False;//для корректной отработки лога
                          PortState := 'Ошибка разбора ответа:' + e.Message;
                          AddToLog(CurrentModuleObj, @output_buffer[0], 0, true);
                        end;
                      end;
                      UpdateTime:=GetTickCount-UpdateTime;

                      Break;
                    end
                    else begin
                      if Debug then
                        DebugOutput('<UpdateNext:[' + CurrentModuleObj.ModuleName + '] Response BAD - STAGE:' + IntToStr(stage) + '>');
                      if stage = SENDING_TRIES_COUNT then
                        ExecuteErrorTransaction();
                    end;
                  end
                  else begin
                    {$IFDEF  WINDOWS}
                    if Debug then
                    begin
                      DebugOutput('<UpdateNext:[' + CurrentModuleObj.ModuleName + '] TIMEOUT - STAGE:' + IntToStr(stage) + '>');
                      DebugOutput('<TimeOuts:['
                      + IntToStr(ActualTimeouts.ReadIntervalTimeout)+ ','
                      + IntToStr(ActualTimeouts.ReadTotalTimeoutMultiplier)+ ','
                      + IntToStr(ActualTimeouts.ReadTotalTimeoutConstant)+'] TIMEOUT - STAGE:' + IntToStr(stage) + '>');
                    end;
                    {$ENDIF}
                    if stage = SENDING_TRIES_COUNT then
                      ExecuteErrorTransaction();
                  end;
                end
                else begin
                  //Ответа не оожидается
                  CurrentModuleObj.TotalReceived := CurrentModuleObj.TotalReceived + 1;
                  GetNextCurrentModule(true);
                  Break;
                end;
              end;//цикл повторов при ошибке
            end;//if (RequestLength>0) then
            StartTime:=GetTickCount - StartTime;
            // Диагностика
            if Debug and (StartTime > 100) then // Если операция дольше 100мс
            begin
              TimeDebug := Format('Медленный опрос %s: Пор=%dмс, Отпр=%dмс, Чтение=%dмс, Update=%dмс, Всего=%dмс',
                [CurrentModuleObj.ModuleName, PortTime, SendTime, ReadTime,UpdateTime,StartTime]);
              DebugOutput(TimeDebug);
            end;
            CurrentModuleObj.UpdateTime:=UpdateTime;
            CurrentModuleObj.RequestTime:=StartTime;
            CurrentModuleObj.ReadTime:=ReadTime;
          finally
              // Минимальная пауза между модулями
              ProcessingTime := GetTickCount - StartTime;
              if ProcessingTime < 5 then // Всего 5мс между модулями
              begin
                Sleep(5 - ProcessingTime);
              end;
          end;
          //-------------- Если порт готов к обмену
        end//if PortReady then
        else begin
          ErrorConnection := True;
          if _TypeOfProtocol in [tpProprietary..tpModbusASCII] then
          begin
            // Закрываем проблемный порт в справочнике
            CloseComPort(CurrentModuleObj.PortNumber);
          end
          else begin
            PortReady := False;
            if not HOLD_CONNECTION_WITH_MODBUS_TCP_CLIENT then
              TCP_Client.Disconnect;
          end;
          ExecuteErrorTransaction();
        end;
      end//if Modules[CurrentModule].EnabledAutoUpdate and (not Modules[CurrentModule].Disguise) then - если с автообновлением и не отключен
      else
      begin
        // ВЫЗЫВАЕМ ReceiveResponse ДЛЯ ОТКЛЮЧЕННЫХ МОДУЛЕЙ (без автообновления)
        CurrentModuleObj.ReceiveResponse('*', '');
        GetNextCurrentModule();
      end;
    end
    else begin
      GetNextCurrentModule();
    end;

  except
    on e: exception do
    begin
      DebugOutput('UpdateNext Exception: ' + e.Message);
      GetNextCurrentModule();
    end;
  end;
end;
{-----------UpdateNext - end of procedure ---------}

procedure TFmxModuleManager.WriteToBuffer(str: ShortString;Module:TFmxModule);
var tmpColor:TAlphaColor;
begin
   if not FViewIOBuffActive then Exit;
   ViewIOBuff[ViewIOBuffCounter]:=str;
   tmpColor:=TAlphaColorRec.Black;
   if Assigned(Module) then
   case Module.ModuleType of
    mtCounter, mtCounterEx:tmpColor:=TColors.Brown;
    mtFCD, mtFCD2:tmpColor:=TColors.Navy;
    mtScales,mtScalesMT:tmpColor:=TColors.DarkBlue;
    mtValve: tmpColor:=TColors.Green;
    mtBIO: tmpColor:=TColors.DarkGreen;
    mtSuperBIO: tmpColor:=TColors.DarkGreen;
    mtT, mtTemp2, mtTemp6, mtUI,mtOldUI: tmpColor:=TColors.Blue;
    mtVLT6000,mtATV312,mtDAC_I702X,mtVLTModbus: tmpColor:=TColors.Darkcyan;
    mtIVTM:tmpColor:=TColors.Darkgray;
    mtDigitalUnit:tmpColor:=TColors.Darkgoldenrod;
    mtKM5:tmpColor:=TColors.Darkgoldenrod;
    mtRT2:tmpColor:=TColors.goldenrod;
   end;
   ViewIOBuffColor[ViewIOBuffCounter]:=tmpColor;
   ViewIOBuffCounter:=ViewIOBuffCounter+1;
end;

