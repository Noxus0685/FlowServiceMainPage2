procedure TFmxModuleManager.ClearViewIOBuff;
var i:integer;
begin
  for i:=0 to cViewIOBufMax-1 do begin
      _ViewIOBuff[i]:='';
      _ViewIOBuffColor[i]:=TAlphaColorRec.Black;
  end;
  ViewIOBuffCounter:=0;
  FViewIOBuffActive := True;
end;






procedure TFmxModuleManager.ClosePort;
begin
  PortReady := False;

  // Закрываем текущий порт через справочник
  if FComPortNumber > 0 then
  begin
    CloseComPort(FComPortNumber);
  end;

  // Дополнительно закрываем все порты если требуется полная очистка
  CloseAllComPorts;

  ComPortNumber := -1;
  Port := INVALID_HANDLE_VALUE;
  PortStatus := psClose;
  PortState := 'Порт закрыт';
end;

