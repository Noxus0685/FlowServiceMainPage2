function TFmxModuleManager.SendCommand(module: TFmxModule; const command: ShortString; response_length: integer; terminator: char = #0): Boolean;
var
  PortInfo: TComPortInfo;
  PortIndex: integer;
  CurrentModuleObj: TFmxModule;
  stage, i, j, mlen: integer;
  output_buffer, in_buff: array [0..255] of ansichar;
  readed: Cardinal;
  written: Cardinal;
  response: ShortString;
  _TypeOfProtocol: TTypeOfProtocol;
  RequestLength, ResponseLength: Cardinal;
  _output_buffer, _in_buff: TIdBytes;

  procedure ExecuteErrorTransaction();
  begin
    if Assigned(Modules[CurrentCommandModule]) then
    begin
      //таймаут
      Modules[CurrentCommandModule].BadPackages := Modules[CurrentCommandModule].BadPackages + 1;
      if not Modules[CurrentCommandModule].Disguise then Modules[CurrentCommandModule].ConnectIsOK := fdqBad;
      Modules[CurrentCommandModule].TimeOuts := Modules[CurrentCommandModule].TimeOuts + 1;
      //вызывает отработку таймаута
      Modules[CurrentCommandModule].ReceiveResponse();
      //отрабатываем, что она была не удачной
      if Debug then
        DebugOutput('<SendCommand:[' + Modules[CurrentCommandModule].ModuleName + '] Responce TIMEOUT - STAGE:' + IntToStr(stage) + '>');
      //вызывает отработку таймаута
      Modules[CurrentCommandModule].ReceiveResponse();
      if PortIndex>=0 then
         Inc(FComPorts[PortIndex].TimeOuts);
    end;
  end;

begin
  Result := false;
  if not Active then Exit;
  if not Assigned(module) then Exit;
  sleep(DelayBeforeSendCommand);//Не разрешаем выполнять команды залпом - даем контроллерам отдышаться
  mlen := Length(Modules);
  if mlen = 0 then Exit;
  CurrentCommandModule := -1;
  //ищем наш модуль в списке модулей
  for i := 0 to mlen - 1 do
  begin
    if (module = Modules[i]) then
    begin
      //найдем модуль, для которого требуется выполнить команду
      CurrentCommandModule := i;
      break
    end;
  end;
  //проверяем - найден ли модуль
  if CurrentCommandModule < 0 then
  begin
    if Debug then
      DebugOutput('<MODULE (' + module.ModuleName + ') FOR COMMAND NOT FOUND>');
    Exit;
  end;

  if Assigned(Modules[CurrentCommandModule]) then
  try
    CurrentModuleObj := Modules[CurrentCommandModule];

    //-----------------------------------------------
    //если флаг автообновления статуса активен
    if (not CurrentModuleObj.Disguise) then
    begin
      //
      // ИСПРАВЛЕНИЕ: Используем справочник портов вместо постоянного открытия/закрытия
      //
      //При отключении аналогичной нижестоящей строки в функции UpdateNext возникают ошибки обмена - здесь добавлено по аналогии - требует тестирования
      // узнаем тип протокола - на данный момент все протоколы, кроме Modbus TCP работают через компорт, на это пока и ориентируемся
      _TypeOfProtocol := CurrentModuleObj.Protocol;
      PortReady := False;
      CurrentModuleObj.TotalSended := CurrentModuleObj.TotalSended + 1;
      //Заставляем обновиться
      CurrentModuleObj.MustUpdate:=True;

      try
        if _TypeOfProtocol in [tpProprietary..tpModbusASCII] then
        begin
          // Получаем порт из справочника (откроется если нужно)
          if not GetComPort(CurrentModuleObj.PortNumber,
                           CurrentModuleObj.BaudRate,
                           Ord(CurrentModuleObj.Parity),
                           CurrentModuleObj.Timeout,
                           PortInfo,PortIndex) then
          begin
            PortReady := False;
            CurrentModuleObj.ConnectIsOK := fdqBad;
            PortState := 'Ошибка открытия порта COM' + IntToStr(CurrentModuleObj.PortNumber);
            AddToLog(CurrentModuleObj, @output_buffer[0], 0, true);
            ErrorConnection := True;
            Sleep(cErrorOpenComPortDelay);
            Exit;
          end;

          // Используем handle из справочника
          Port := PortInfo.PortHandle;
          PortReady := PortInfo.IsOpen;

          {$IFDEF MSWINDOWS}
          // Настраиваем таймауты для текущего модуля
          CTO.ReadTotalTimeoutConstant := CurrentModuleObj.Timeout + DopTimOut;
          PortReady := SetCommTimeouts(Port, CTO);
          if PortIndex>=0 then
          begin
            GetCommState(PortInfo.PortHandle, DCB);
            if (DCB.BaudRate <> CurrentModuleObj.baudrate) or
               (DCB.Parity <> ord(CurrentModuleObj.parity)) then
            begin
              FComPorts[PortIndex].baudrate:=CurrentModuleObj.baudrate;
              FComPorts[PortIndex].parity:=ord(CurrentModuleObj.parity);
              DCB.BaudRate := FComPorts[PortIndex].baudrate;
              DCB.Parity := FComPorts[PortIndex].parity;
              SetCommState(PortInfo.PortHandle, DCB);
            end;
            FComPorts[PortIndex].TimeOut:=CTO.ReadTotalTimeoutConstant;
          end;
          {$ENDIF}
        end
        else
        begin
          //Modbus TCP - подключаемся
          PortReady := TCP_Client_Connected;
        end;
      except
        on e: Exception do
        begin
          PortReady := False;//для корректной отработки лога
          PortState := 'Ошибка открытия порта :' + e.Message;
          AddToLog(CurrentModuleObj, @output_buffer[0], 0, true);
        end;
      end;

      ErrorConnection := False;

      try
        if PortReady then
        begin
          //пытаемся, при неудачной попытке SENDING_TRIES_COUNT раз повторить операцию
          // выбираем команду статуса текущего модуля.
          ResponseLength := response_length;
          RequestLength := Length(command);

          for j := 1 to RequestLength do
            output_buffer[j - 1] := command[j];

          //для TCP клиента формирвем запрос
          if _TypeOfProtocol = tpModbusTCP then
            _output_buffer := RawToBytes(output_buffer, RequestLength);

          if ResponseLength = 0 then
          begin
            AddToLog(CurrentModuleObj, @output_buffer[0], RequestLength, true);
            if _TypeOfProtocol in [tpProprietary..tpModbusASCII] then
            begin
              //rs485
  {$IFDEF MSWINDOWS}
              PurgeComm(Port, PURGE_TXABORT or PURGE_RXABORT or PURGE_TXCLEAR or PURGE_RXCLEAR);
              WriteFile(Port, output_buffer, RequestLength, written, nil);
              if PortIndex>=0 then
                 Inc(FComPorts[PortIndex].TotalAttempts);
  {$ENDIF}
            end
            else begin
              //Modbus TCP
              TCP_Client.Socket.Write(_output_buffer);
            end;
            response := ''; // чтобы вернуть пустую строку.
          end
          else begin
            for stage := 1 to SENDING_TRIES_COUNT do
            begin
              if not Active then Exit;
              if CurrentModuleObj.Disguise then break;
              AddToLog(CurrentModuleObj, @output_buffer[0], RequestLength, true);

              //если это повтор - следующую операцию выполняем с задержкой
              if stage > 1 then
                Sleep(cDelayAfterErrorFirstRequest * stage * 2)
              else begin
                if Debug then
                  DebugOutput('<[' + CurrentModuleObj.ModuleName + '] CMD:' + command + 'STAGE:' + IntToStr(stage) + '>');
              end;

              //Включим линию RTS, нужна для работы прэмов
              if _TypeOfProtocol in [tpProprietary..tpModbusASCII] then
              begin
                //rs485
  {$IFDEF MSWINDOWS}
                EscapeCommFunction(Port, SETRTS);
  {$ENDIF}
              end;

              //сбрасываем предыдущие операции по порту
              if _TypeOfProtocol in [tpProprietary..tpModbusASCII] then
              begin
                //rs485
  {$IFDEF MSWINDOWS}
                PurgeComm(Port, PURGE_TXABORT or PURGE_RXABORT or PURGE_TXCLEAR or PURGE_RXCLEAR);
  {$ENDIF}
              end;

              // отправляем команду запроса статуса
              try
                if _TypeOfProtocol in [tpProprietary..tpModbusASCII] then
                begin
                  //rs485
  {$IFDEF MSWINDOWS}
                  if PortIndex>=0 then begin
                    GetCommState(PortInfo.PortHandle, DCB);
                    if (DCB.BaudRate <> CurrentModuleObj.baudrate) or
                       (DCB.Parity <> ord(CurrentModuleObj.parity)) then
                    begin
                      FComPorts[PortIndex].baudrate:=CurrentModuleObj.baudrate;
                      FComPorts[PortIndex].parity:=ord(CurrentModuleObj.parity);
                      DCB.BaudRate := FComPorts[PortIndex].baudrate;
                      DCB.Parity := FComPorts[PortIndex].parity;
                      SetCommState(PortInfo.PortHandle, DCB);
                    end;
                    FComPorts[PortIndex].TimeOut:=CTO.ReadTotalTimeoutConstant;
                  end;
                  WriteFile(Port, output_buffer, RequestLength, written, nil);
  {$ENDIF}
                end
                else begin
                  //Modbus TCP
                  TCP_Client.Socket.Write(_output_buffer);
                end;
              except
                on e: Exception do
                begin
                  PortReady := False;//для корректной отработки лога
                  PortState := 'Ошибка отправки запроса :' + e.Message;
                end;
              end;
              if Optimization then
                 sleep(cSleepBeforeRead);
              // считываем ответ
              try
                if _TypeOfProtocol in [tpProprietary..tpModbusASCII] then
                begin
                  //rs485
  {$IFDEF MSWINDOWS}
                  GetCommTimeouts(Port, ActualTimeouts);
                  ReadFile(Port, in_buff, ResponseLength, readed, nil);
  {$ENDIF}
                end
                else begin
                  //Modbus TCP
                  TCP_Client.Socket.ReadBytes(_in_buff, -1);
                  readed := Length(_in_buff);
                  for i := 0 to readed - 1 do
                    in_buff[i] := AnsiChar(_in_buff[i]);
                end;
              except
                on e: Exception do
                begin
                  PortReady := False;//для корректной отработки лога
                  PortState := 'Ошибка чтения ответа :' + e.Message;
                end;
              end;

              if (ResponseLength <> readed) then
              begin
                AddToLog(CurrentModuleObj, @in_buff[0], readed, false, true)
              end
              else
                AddToLog(CurrentModuleObj, @in_buff[0], readed, false);

              //пишем в лог что (MustBytesRead) количество ожидаемых байт
              //не соответствуют реально считанным (Real Readed)
              if (ResponseLength <> readed) and Debug then
                DebugOutput('[' + CurrentModuleObj.ModuleName + '] MBR:' + IntToStr(ResponseLength) + ' RR:' + IntToStr(readed));

              //переносим результат в ответ
              //если есть принятые данные
              response := '';
              if readed > 0 then
              begin
                for j := 1 to readed do
                  response := response + ansichar(in_buff[j - 1]);
                //проверяем их корректность
                if CurrentModuleObj.CheckResponse(command, response) then
                begin
                  CurrentModuleObj.TotalReceived := CurrentModuleObj.TotalReceived + 1;
                  if Debug then
                    DebugOutput('<SendCommand:[' + CurrentModuleObj.ModuleName + '] Response OK - STAGE:' + IntToStr(stage) + '>');
                  Break;
                end;
                if Debug then
                  DebugOutput('<SendCommand:[' + CurrentModuleObj.ModuleName + '] Response BAD - STAGE:' + IntToStr(stage) + '>');
              end
              else begin
                ExecuteErrorTransaction();
              end;
            end;//цикл повторов при ошибке
          end;

          //поверка на терминацию задачи
          if not Active then Exit;

          //если после повторов есть какой-то ответ
          //если есть корректный ответ
          if response <> '' then
          try
            CurrentModuleObj.ReceiveResponse(command, response); // !!! 22.07.2008
          except
            on e: exception do
            begin
              PortReady := False;//для корректной отработки лога
              PortState := 'Ошибка разбора ответа :' + e.Message;
              AddToLog(CurrentModuleObj, @output_buffer[0], 0, true);
            end;
          end;
        end
        else begin
          PortReady := False;
          if _TypeOfProtocol in [tpProprietary..tpModbusASCII] then
          begin
            // Закрываем проблемный порт в справочнике
            CloseComPort(CurrentModuleObj.PortNumber);
          end
          else begin
            //Modbus TCP
            if not HOLD_CONNECTION_WITH_MODBUS_TCP_CLIENT then
              TCP_Client.Disconnect();
          end;
        end;
      finally
        // ...
      end;
    end
    else begin
      Result := true;
    end;

    LoopStartTickCount := GetTickCount;

  except
    on e: exception do
      DebugOutput(e.Message);
  end;

  Result := true;
end;

