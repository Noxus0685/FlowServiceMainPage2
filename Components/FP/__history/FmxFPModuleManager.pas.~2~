procedure TTransferThread.Execute;
begin
 try
  while not Terminated do
  begin
    if Assigned(Application) then
    begin
       if Assigned(TransferProc) then
          TransferProc;
    end
    else
      Break;
    sleep(1);
  end;
 finally

 end;
end;

