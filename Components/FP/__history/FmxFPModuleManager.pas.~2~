destructor TFmxModuleManager.Destroy;
var
  Timeout: Cardinal;
begin
  if Assigned(TransferThread) then
  begin
    // Даем потоку время на завершение
    TransferThread.Terminate;
    Active := False;

    Timeout := 3000; // 3 секунды на завершение потока
    {$IFDEF WINDOWS}
    if WaitForSingleObject(TransferThread.Handle, Timeout) = WAIT_TIMEOUT then
    begin
      if Debug then
        DebugOutput('Таймаут ожидания завершения потока, принудительное закрытие');
      TerminateThread(TransferThread.Handle, 0);
    end;
    {$ENDIF}

    TransferThread.Free;
  end;

  // Закрываем все порты
  CloseAllComPorts;

  if LogFileIsOpened then
  begin
    try
      Close(LogFile);
    except
      // Игнорируем ошибки закрытия файла
    end;
  end;

  if Assigned(TCP_Client) then
  begin
    try
      TCP_Client.Free;
    except
      on E: Exception do
        if Debug then DebugOutput('Ошибка при освобождении TCP клиента: ' + E.Message);
    end;
  end;

  if Assigned(FComPortsLock) then
    FComPortsLock.Free;

  inherited Destroy;
end;

