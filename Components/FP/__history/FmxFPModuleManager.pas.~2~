procedure TFmxModuleManager.COMLoopProc;
var
  idx:integer;
begin
  if Assigned(Application) then
  try
    Sleep(1);
    if Assigned(Application) then
       Application.ProcessMessages
    else
      Exit;
    if COMRunQueriesCount = 0 then
    begin
      try
        UpdateNext
      except
        on e:exception do
          ODS(PChar('COMLoopProc UpdateNext Ошибка:'+e.Message));
      end;
    end
    else begin
      COMRunQueriesCount := COMRunQueriesCount - 1;
      try
        COMRunQueriesBuffer[COMRunQueriesCount + 1];
      except
        on e:exception do
          ODS(PChar('COMLoopProc Ошибка:'+e.Message));
      end;
    end;
  except

  end;
end;

procedure TFmxModuleManager.OpenComPort(PortNumber, BaudRate,Parity,Timeout: integer; var PortInfo: TComPortInfo; var PortIndex:integer);
{$IFDEF MSWINDOWS}
var
  DCB: TDCB;
  CTO: COMMTIMEOUTS;
{$ENDIF}
begin
  if PortNumber <= 0 then Exit;

  FComPortsLock.Enter;
  Inc(TimeOut,FDopTimOut);
  try
    // Проверяем, не открыт ли уже порт
    if GetComPortInfo(PortNumber, PortInfo,PortIndex) then
    begin
      // Если параметры изменились, переоткрываем
      if (PortInfo.BaudRate <> BaudRate) or (PortInfo.Parity <> Parity) then
      begin
        CloseComPort(PortNumber);
        // После закрытия сбрасываем PortInfo
        PortInfo.PortNumber := PortNumber;
        PortInfo.BaudRate := BaudRate;
        PortInfo.Parity := Parity;
        PortInfo.Timeout := Timeout;
        PortInfo.IsOpen := False;
      end
      else
      begin
        Exit; // Порт уже открыт с нужными параметрами
      end;
    end
    else
    begin
      // Порт не найден, инициализируем новую запись
      PortInfo.PortNumber := PortNumber;
      PortInfo.BaudRate := BaudRate;
      PortInfo.Parity := Parity;
      PortInfo.Timeout := Timeout;
      PortInfo.IsOpen := False;
    end;

    // Открываем порт
    {$IFDEF MSWINDOWS}
    PortInfo.PortHandle := CreateFile(
      PChar('\\.\' + 'COM' + IntToStr(PortNumber)),
      GENERIC_READ or GENERIC_WRITE,
      0, nil, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0
    );

    if PortInfo.PortHandle = INVALID_HANDLE_VALUE then
    begin
      PortInfo.IsOpen := False;
      PortState := 'Ошибка открытия порта COM' + IntToStr(PortNumber);
      // Сохраняем информацию о неудачной попытке
      if FindComPortIndex(PortNumber) >= 0 then
        UpdateComPortInfo(PortInfo)
      else
        AddComPortInfo(PortInfo);
      Exit;
    end;

    // Настройка параметров порта
    GetCommState(PortInfo.PortHandle, DCB);
    DCB.BaudRate := BaudRate;
    DCB.Parity := Parity;
    DCB.ByteSize := 8;
    DCB.StopBits := ONESTOPBIT;
    SetCommState(PortInfo.PortHandle, DCB);

    // Настройка таймаутов
    GetCommTimeouts(PortInfo.PortHandle, CTO);
    CTO.ReadIntervalTimeout := MAXWORD;
    CTO.ReadTotalTimeoutMultiplier := 0;
    CTO.ReadTotalTimeoutConstant := Timeout;
    CTO.WriteTotalTimeoutMultiplier := 150;
    CTO.WriteTotalTimeoutConstant := 100;
    SetCommTimeouts(PortInfo.PortHandle, CTO);

    EscapeCommFunction(PortInfo.PortHandle, SETRTS);
    {$ENDIF}

    PortInfo.IsOpen := True;
    PortInfo.LastUsed := Now;

    // Сохраняем информацию о порте
    if FindComPortIndex(PortNumber) >= 0 then
      UpdateComPortInfo(PortInfo)
    else
      AddComPortInfo(PortInfo);

    PortState := 'Порт COM' + IntToStr(PortNumber) + ' открыт';

  finally
    FComPortsLock.Leave;
  end;
end;
