procedure TFmxModuleManager.AddToLog(Module:TFmxModule;buffer: PByte; length: integer; sended: Boolean;err:Boolean=false);
var
  hour, min, sec, msec: Word;
  str,substr: String;
  i: integer;
  msgColor:TAlphaColor;
begin
  try

      AssignFile(LogFile, FLogFileName);
      {$I-}
      Append(LogFile);
      {$I+}
      LogFileIsOpened := IOResult = 0;

      if LogFileIsOpened then
      begin
        str := '';

        DecodeTime(Time, hour, min, sec, msec);
        if hour < 10 then str := str + '0';
        str := str + IntToStr(hour) + ':';
        if min < 10 then str := str + '0';
        str := str + IntToStr(min) + ':';
        if sec < 10 then str := str + '0';
        str := str + IntToStr(sec) + ':';
        if msec < 10 then str := str + '0';
        if msec < 100 then str := str + '0';
        str := str + IntToStr(msec);

        substr:='';
        if ShowPortInLog then substr:=' COM'+IntToStr(Module.PortNumber);
        if ShowModuleInLog then
          if Module.ModuleType<>mtDigitalUnit then
             substr:=substr+' '+Module.ModuleName+Format('(0x%0.2X',[Module.FAddress])
          else
             substr:=substr+' '+Module.ModuleName;
        if sended then
          str := str +substr+') <-- '
        else
          str := str +substr+') --> ';

        if (not PortReady) then
        begin
           str:=str+' E:'+PortState;
           msgColor:=TAlphaColorRec.Blue;
        end
        else begin
          PortState:='';
          if Module.ASCII then
          begin
            if err then
              msgColor:=TAlphaColorRec.Darkred
            else
              msgColor:=TAlphaColorRec.DarkGreen;
            if length>0 then
            begin
              for i:=1 to length do
                if buffer[i-1] = 13 then
                  str := str + '<CR>'
                else if buffer[i-1] = 10 then
                  str := str + '<LF>'
                else if buffer[i-1] = $A6 then
                  str := str + '<A6>'
                else
                  str := str + Chr(buffer[i-1]);
            end
            else
               str:=str+cTimeout;

          end
          else  begin
            if err then
              msgColor:=TAlphaColorRec.Darkred
            else
              msgColor:=TAlphaColorRec.Darkolivegreen;
            if length>0 then
               str:=str+'[hex] '+B2HS(@buffer[0],length)
            else
               str:=str+cTimeout;

          end;
        end;

        if Debug then
        if Assigned(FOnLogViewerAddMessage) then
        begin
           OnLogViewerAddMessage(str,msgColor);
        end;
        WriteLn(logFile, str);
        CloseFile(logFile);
      end;
  finally

  end;
end;

