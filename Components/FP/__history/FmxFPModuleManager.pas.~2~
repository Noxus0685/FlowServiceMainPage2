procedure TFmxModuleManager.GetNextCurrentModule(UseTime: boolean = False);
var
  zlen, i: Integer;
begin
  zlen := Length(Modules);
  if zlen = 0 then Exit;

  // ПРОСТАЯ ЛОГИКА С ЗАЩИТОЙ ОТ ЗАЦИКЛИВАНИЯ
  for i := 1 to zlen do  // Максимум zlen попыток
  begin
    CurrentModule := (CurrentModule + 1) mod zlen;

    if Assigned(Modules[CurrentModule]) and
       (not Modules[CurrentModule].Disguise) and
       (Modules[CurrentModule].PriorityCounter=0) and
       Modules[CurrentModule].EnabledAutoUpdate then
    begin
      // Нашли активный модуль
      Break;
    end
    else
      if Modules[CurrentModule].PriorityCounter>0 then
         Modules[CurrentModule].PriorityCounter:=Modules[CurrentModule].PriorityCounter-1;


    // Если прошли все модули и не нашли активный - выходим
    if i = zlen then
    begin
      // Не нашли активных модулей, оставляем текущий как есть
      Exit;
    end;
  end;
  Modules[CurrentModule].PriorityCounter:=Modules[CurrentModule].Priority;

  // Расчет времени цикла
  if CurrentModule = FirstActiveModule then
  begin
    FLastCycleTime := (GetTickCount - FCycleStartTime) / 1000.0;
    UpdateCycleStatistics(FLastCycleTime);
    FCycleStartTime := GetTickCount;
    FCurrentCycleModules := CountActiveModules();
    LastLoopTime := FLastCycleTime;
  end;
end;

function TFmxModuleManager.HasActiveModules: Boolean;
var
  i: integer;
begin
  Result := False;
  for i := 0 to ModulesCount - 1 do
  begin
    if Assigned(Modules[i]) and
       (not Modules[i].Disguise) and
       Modules[i].EnabledAutoUpdate then
    begin
      Result := True;
      Exit;
    end;
  end;
end;

function TFmxModuleManager.IsOverallCommunicationAlive(): Boolean;
var
  i: Integer;
  AnyModuleResponded: Boolean;
  tmpModule: TFmxModule;
begin
  // Быстрая проверка порта/TCP
  if (ComPortType = ctMain) and (not PortReady) then
    Exit(False);
  if (ComPortType = ctFlowmeter) and (not TCP_Client_Active) then
    Exit(False);

  // Если нет зарегистрированных модулей – считаем, что связи нет (или неопределено)
  if ModulesCount = 0 then
    Exit(False);

  // Проверяем, отвечал ли хоть один модуль за последние N циклов
  AnyModuleResponded := False;
  for i := 0 to ModulesCount - 1 do
  begin
    tmpModule := Module[i];
    if not Assigned(tmpModule) then Continue;

    // Если модуль не отключён вручную и у него ConnectIsOK = Good
    if (not tmpModule.Disguise) and tmpModule.EnabledAutoUpdate and (tmpModule.ConnectIsOK = fdqGood) then
    begin
      AnyModuleResponded := True;
      Break;
    end;
  end;

  Result := AnyModuleResponded;
end;



