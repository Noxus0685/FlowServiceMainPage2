  FComPortsLock.Enter;
  try

     len:=Length(FComPorts);
     if (Idx>=0) and (Idx<len)  then
        result:=FComPorts[Idx]
     else begin
        nullInfo.PortHandle:=INVALID_HANDLE_VALUE;
        nullInfo.PortNumber:=-1;
        nullInfo.BaudRate:=0;
        nullInfo.Parity:=0;
        nullInfo.Timeout:=0;
        nullInfo.IsOpen:=False;
        nullInfo.LastUsed:=0;
        nullInfo.TimeOuts:=0;
        result:=nullInfo;
     end;
  finally
    FComPortsLock.Leave;
  end;
