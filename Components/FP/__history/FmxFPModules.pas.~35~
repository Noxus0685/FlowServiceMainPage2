procedure TFmxModuleHsc_Ctrl.ReceiveResponse(command, response: ShortString);
var
  i: integer;
  s:ShortString;
  len: Integer;
  tmpB:Byte;
label end_of_procedure;
begin
 if (command='') then
 begin
   ConnectIsOK := fdqBad;
   Exit;
 end;
 if response='' then goto  end_of_procedure;
 if not Disguise then
 begin
// Запрос регистров состояния - 24 регистра базовый адрес (4354-1)=4353 = 0x1101 - ответ 53 байта
// << 5B 03 11 01 00 18 1D C6
// >> 5B 03 30 00 00 00 64 00 64 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 64 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 48 81
    len:=Length(response);
    if (command = PreparePack(Address,cHSC_Ctrl_Version)) then
    begin
      //Первый раз запрашиваем информацию о плате - версию и ревизию
      if len=cHSC_Ctrl_Version_Len  then
      begin
         DeviceID:=Swap(PWord(@response[4])^);//Идентификатор - 4
         ProtocolID:=Swap(PWord(@response[6])^);//Версия протокола - 6
         FMustUpdate:=True;
      end;
      //затем запрашиваем состояние управления для внутренней синхронизации
      StatusQuery := PreparePack(Address,cHsc_Ctrl_ControlStatusBody+Ansichar(MaxChannels));  //Чтение состояния каналов вывода
      ResponseLength:=StatusBodyLen;
    end
    else if (command = PreparePack(Address,cHsc_Ctrl_ControlStatusBody)+Ansichar(MaxChannels)) then
    begin
      //далее опрашиваем только состояние входов
      StatusQuery:=PreparePack(Address,cHsc_Ctrl_StatusBody+Ansichar(MaxChannels));
      ResponseLength:=StatusBodyLen;
      if len=StatusBodyLen  then
        for I := 0 to MaxChannels-1 do
        begin
          tmpB:=Ord(response[5+i*2]);
          if (tmpB<>OutputValues[i]) or NeedUpdate then
          begin
            OutputValues[i]:=tmpB;
            FMustUpdate:=True;
          end
        end;
    end
    else if (command = StatusQuery) then
    begin
      if len=StatusBodyLen  then
        for I := 0 to MaxChannels-1 do
        begin
          tmpB:=Ord(response[5+i*2]);
          if (tmpB<>InputValues[i]) or NeedUpdate then
          begin
            InputValues[i]:=tmpB;
            FMustUpdate:=True;
          end;
        end;
    end;
    ConnectIsOK := fdqGood;
 end
 else
  ConnectIsOK := fdqDisguise;
end_of_procedure:
  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
end;


