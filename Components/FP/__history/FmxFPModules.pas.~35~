function TFmxModuleHSC_IMP.StopMeasurement: Boolean;
begin
  Result :=
    WriteUInt16Register(
      REG_CMD_STARTSTOP,
      HSC_IMP_CMD_STOP_MES
    );

  if Result then
    State := hmsStopWait;
end;

