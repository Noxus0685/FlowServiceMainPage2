function TFmxModuleCounter.CheckResponse(command, response: ShortString): Boolean;
begin
  Result := false;

  // Функция определяет, ответ на какую именно команду проверяется, а затем проверяет его.

  // Команда запроса частот счетчиков.
  if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'J' then
    Result :=  (Length(response) = ResponseLength) and (CheckForChkCr(response));

  // Команда запроса количества импульсов.
  if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'K' then
    Result := (Length(response) = 198) and (CheckForChkCr(response));

  // Команда запуска счета.
  if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'S' then
    Result := response = AddChkCr('!' + IntToHex(Address, 2));

  // Команда остановки счета.
  if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'T' then
    Result := response = AddChkCr('!' + IntToHex(Address, 2));

  // Команда запроса режимов счетчиков.
  if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'X' then
    Result := (Length(response) = 12) and (CheckForChkCr(response));

  // Команда включения/выключения режима зависимых/медленных импульсов.
  if ( LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'D' ) or
     ( LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'N' ) or
     ( LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'L' ) or
     ( LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'F' )
  then
    Result := response = AddChkCr('!' + IntToHex(Address, 2));

  // Заглушка, связанная с косяком модуля при ответе на команду включения/выключения режима зависимых
  // импульсов. Если будет исправлена прошивка модуля, можно будет (и даже желательно) убрать этот блок.
  // Подробности о косяке в доке по модулю счетчиков (в экспериментальных данных).
  if ( LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'D' ) or
     ( LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'N' )
  then
    Result := Result or (response = AddChkCr('?' + IntToHex(Address, 2)));

  // Команда установки номера эталонной пары расходомеров.
  if ( LeftStr(command, 3) = '#' + IntToHex(Address, 2) ) and
     ( command[4] >= '0' ) and ( command[4] <= '3' )
  then
    Result := response = AddChkCr('!' + IntToHex(Address, 2));

(*
  // 02.07.2008, Возженников
  // команда запроса периодов для получения точных частот

  if command = '#03J' then
    Result :=  (Length(response) = 53) and (CheckForChkCr(response));
    // насчет 53 - надо проверять! потому что при проверке CRC к ответу добавляется байт возврата каретки #13
*)
  if Disguise then Result:=true;
end;

//============================================================================================================

procedure TFmxModuleCounter.ReceiveResponse(command, response: ShortString);
var
  tmpI,i: integer;
  active_counters: Word;
  s:ShortString;
  F:Single;

label end_of_procedure;
begin
 FConnectIsOK := fdqBad;

 if (command='') then
 begin
   //таймаут
   Exit;
 end;
 if response='' then goto  end_of_procedure;
  // Процедура определяет, ответ на какую именно команду пришел, а затем обрабатывает его.
 if not Disguise then
 begin
    // Команда запроса частот счетчиков.
    if response='' then goto  end_of_procedure;
    if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'J' then
    begin
      try
        SampleFlowmeterFrequencies[0] := StrToIntDef( '0x' + Copy(response, 4, 4),0 );
        SampleFlowmeterFrequencies[1] := StrToIntDef( '0x' + Copy(response, 8, 4),0 );
        //проверим частоту на втором канале и если она сильно не похожа на
        //10кГц, то взводим соответствующий флаг
        F:=SampleFlowmeterFrequencies[1]/10000.0;
        if F<0.9
          then begin
            if WrongGeneratorFreqCounter<254 then
               Inc(WrongGeneratorFreqCounter);
          end
          else WrongGeneratorFreqCounter:=0;
        if WrongGeneratorFreqCounter>20 then
          GeneratorError:=true
        else
          GeneratorError:=false;
  // заполняем массив частот из ответа модуля на команду "01J"
        for i:=0 to 7 do
        begin
          tmpI:=StrToIntDef( '0x' + Copy(response, 12 + i*4, 4),0 );
          if (tmpI<>CertifiableFlowmeterFrequencies[i]) or NeedUpdate then
          begin
            CertifiableFlowmeterFrequencies[i] := tmpI;
            FMustUpdate:=True;
          end;
        end;
        ConnectIsOK := fdqGood;
        //inherited ReceiveResponse(command, response);
      finally

      end;
      goto end_of_procedure;
    end;

    // Команда запроса количества импульсов.
    if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'K' then
    begin
      for i:=0 to 7 do
      begin
        try
        s:='0x' + Copy(response, 4  + i*24, 8);
        tmpI:=StrToInt64Def(s,0 );
        if (CertifiableFlowmeterImpulses[i] <> tmpI)  or NeedUpdate then
        begin
          CertifiableFlowmeterImpulses[i] := tmpI;
          FMustUpdate:=True;
        end;
        except
          on e:exception do
             OutputDebugString(PChar('Counter CFI['+IntToStr(i)+'] E:'+e.Message+' '+s));
        end;
        try
          s:='0x' + Copy(response, 12 + i*24, 8);
          tmpI:=StrToInt64Def( s,0);
          if (SampleFlowmeterImpulses[i][0] <> tmpI)  or NeedUpdate then
          begin
            FMustUpdate:=True;
            SampleFlowmeterImpulses[i][0] := tmpI;
          end;
        except
          on e:exception do
             OutputDebugString(PChar('Counter SFI1['+IntToStr(i)+'] E:'+e.Message+' '+s));
        end;
        try
          s:='0x' + Copy(response, 20 + i*24, 8);
          tmpI:=StrToInt64Def(s,0 );
          if (SampleFlowmeterImpulses[i][1]<>tmpI) or NeedUpdate then
          begin
            FMustUpdate:=True;
            SampleFlowmeterImpulses[i][1]:=tmpI;
          end;
        except
          on e:exception do
             OutputDebugString(PChar('Counter SFI2['+IntToStr(i)+'] E:'+e.Message+' '+s));
        end;
      end;
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда запуска счета.
    if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'S' then begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда остановки счета.
    if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'T' then begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда запроса режимов счетчиков.
    if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'X' then
    begin
        active_counters := StrToIntDef( '0x' + Copy(response, 4, 2),0 );
        for i:=0 to 7 do CounterIsActive[i] := ( (active_counters shr i) and 1 ) = 1;
        SamplePairNumber := Ord(response[6]) - 48;
        CountIsStarted := response[7] = '1';
        SlowImpulseModeIsActive := response[8] = '1';
        DependentImpulseModeIsActive := response[9] = '1';
        ConnectIsOK := fdqGood;
        goto end_of_procedure;
    end;

    // Команда включения/выключения режима зависимых/медленных импульсов.
    if ( LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'D' ) or
       ( LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'N' ) or
       ( LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'L' ) or
       ( LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'F' ) then
    begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда установки номера эталонной пары расходомеров.
    if ( LeftStr(command, 3) = '#' + IntToHex(Address, 2) ) and
       ( command[4] >= '0' ) and ( command[4] <= '3' ) then begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;
  end
  else begin
     ConnectIsOK := fdqDisguise;
  end;
end_of_procedure:
  //попробую перенести вызов этого в обработку команды статуса, потому что
  //вызов этого тут будет вызывать рекурсивное зацикливание при попытках
  //подсчитать объем и время для рассчета расходов в тестовом режиме
  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
end;

