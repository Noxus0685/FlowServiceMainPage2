function TFmxModuleHsc_Ctrl.MoveValve(Idx: Byte; position: Word): Boolean;
var s:ShortString;
begin
  if Idx+1 in [1.. MaxChannels] then
  begin
   OutputValues[Idx]:=Position and $00ff;
   PriorityCounter:=0;
   MustUpdate:=True;
   s:=#$10#$12+AnsiChar(Idx+1)+#$00#$01#$02#$00+AnsiChar(OutputValues[Idx]);
   result:=TFmxModuleManager(ModuleManager).SendCommand(Self,PreparePack(Address,s),cHsc_Ctrl_CmdBodyLen);
