function TFmxModuleModbusD.CheckResponse(command,
  response: ShortString): Boolean;
begin
  case Protocol of
    tpProprietary: ;
    tpModbusRTU: begin
      inbuff:=StrToIdBytes(response);
      obuff:=StrToIdBytes(command);
      Result :=Modbus_CheckAnswer(obuff,inbuff,mmRTU,FErrorCode);
    end;
    tpModbusASCII: begin
      inbuff:=StrToIdBytes(response);
      obuff:=StrToIdBytes(command);
      Result :=Modbus_CheckAnswer(obuff,inbuff,mmASCII,FErrorCode);
    end;
    tpModbusTCP: begin
      len:=Length(response);
      SetLength(inbuff,len);
      inbuff:=RawToBytes(response[1],len);
      result:=modbus_tcp_CheckAnswer(RequestedModBusFunction,inbuff,len,ReceiveBuffer);
    end;
  end;
end;


constructor TFmxModuleModbusD.Create(port: word; addr: integer; baud:longint; _typeOfProtocol:TTypeOfProtocol;InputReg: word; OutputReg: word; module_manager: TFmxModuleManager);
begin
   ModuleManager := module_manager;
   inherited Create(mtModbusD,_typeOfProtocol,False);
   BaseRegister:=1;
   Protocol:=_typeOfProtocol;
   InputRegister:=InputReg;
   OutputRegister:=OutputReg;
   PortNumber:=Port;
   Address := addr;
   Baudrate:=baud;
   UnitID:=addr;
   ModuleType:=mtModbusD;
   RequestedModBusFunction:=mbfReadCoils;
   MaxInputRegs:=1;
   EnabledAutoUpdate := true;
   SetLength(DataRegisters,2);
    // Значения на входах модуля-устройства.
   SetLength(InputValues,16);
   SetLength(InputValuesQ,16);
    // Значения на выходах модуля-устройства.
   SetLength(OutputValues,16);
   SetLength(OutputValuesQ,16);
  Timeout := 70;
end;


procedure TFmxModuleModbusD.ReceiveResponse(command, response: ShortString);
var i:integer;
    tmpB:boolean;
begin
  if (Command<>'') and (response<>'') then
  begin
   case Protocol of
     tpProprietary: ;
     tpModbusRTU: begin
        case RequestedModBusFunction of
        mbfReadCoils: begin
//          // Разбор ответа на чтение катушек
//          if not ParseReadBitsResponse(inbuff, mmRTU, OutputValues, i, FErrorCode) then
//            ConnectIsOK := fdqBad
//          else
//            ConnectIsOK := fdqGood;
          ParseReadBitsResponse(inbuff,mmRTU,InputValues,i,FErrorCode);
          ConnectIsOK := fdqGood;
        end;
       mbfWriteCoils:begin
            // Для записи множества катушек ответ должен быть коротким, просто проверяем успех
            ConnectIsOK := fdqGood;
        end;
        mbfReadInputBits: begin
          ParseReadRegistersResponse(inbuff,mmRTU,DataRegisters,FErrorCode);
          ConnectIsOK := fdqGood;
        end;
       end;
     end;
     tpModbusASCII: begin
       case RequestedModBusFunction of
        mbfReadInputBits: begin
          ParseReadRegistersResponse(inbuff,mmASCII,DataRegisters,FErrorCode);
          ConnectIsOK := fdqGood;
        end;
        mbfReadCoils: begin
          ParseReadBitsResponse(inbuff,mmASCII,InputValues,i,FErrorCode);
          ConnectIsOK := fdqGood;
        end;
       end;
     end;
     tpModbusTCP: begin
        modbus_tcp_ExtractAnswer(RequestedModBusFunction,inbuff,len,ReceiveBuffer,DataRegisters);
        case RequestedModBusFunction of
          mbfReadInputBits,
          mbfReadCoils: begin
            // если (TransactionID and 1) = 1 - запрашиваем входы, иначе запрашиваем выходы
             if (TransactionID and 1)=1  then
             begin
               //Входы
               for i:=0 to 15 do
               begin
                 tmpB:=(DataRegisters[0] and (1 shl i))<>0;
                 if (tmpB<>InputValues[i]) or (InputValuesQ[i]<3) then
                 begin
                    InputValues[i]:=tmpB;
                    InputValuesQ[i]:=0;
                    FMustUpdate:=True;
                 end
                 else begin
                    if InputValuesQ[i]<254 then
                       Inc(OutputValuesQ[i]);
                 end;
               end;
             end
             else begin
               //выходы
               for i:=0 to 15 do
               begin
                 tmpB:=(DataRegisters[0] and (1 shl i))<>0;
                 if (tmpB<>OutputValues[i]) or (OutputValuesQ[i]<3) or NeedUpdate then
                 begin
                    OutputValues[i]:=tmpB;
                    OutputValuesQ[i]:=0;
                    FMustUpdate:=True;
                 end
                 else begin
                    if OutputValuesQ[i]<254 then
                       Inc(OutputValuesQ[i]);
                 end;
               end;
             end;
             ConnectIsOK := fdqGood;
            end;//mbfReadCoils
        end;
     end;
   end
   //inbuff,len,ReceiveBuffer заполнены в функции CheckResponse
  end
   else
    ConnectIsOK := fdqBad;
  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
end;



function TFmxModuleModbusD.GetStatusQuery: ShortString;
  var
    Data: array[0..0] of Word;
    buff:TIdBytes;
    len:Word;
    i:Integer;
    TID:Word;
    requeststr:ShortString;
begin
   //Data в данном запросе не требуется
   SetLength(buff,0);
   //с перспективой поддержать и два других протокола
   case Protocol of
     tpProprietary: ;
     tpModbusASCII: begin
       case RequestedModBusFunction of
         mbfReadCoils: begin
          BuildReadDiscreteInputsRequest(Address and $ff,InputRegister,MaxInputRegs,
            mmASCII,buff,FResponseLength);
         end;
         mbfReadHoldingRegs: begin
          BuildReadHoldingRegistersRequest(Address and $ff,InputRegister,MaxInputRegs,
            mmASCII,buff,FResponseLength);
         end;
         mbfReadInputRegs: begin
          BuildReadInputRegistersRequest(Address and $ff,InputRegister,MaxInputRegs,
            mmASCII,buff,FResponseLength);
         end;
       end;
     end;
     tpModbusRTU: begin
        case RequestedModBusFunction of
          mbfReadCoils: begin
            BuildReadCoilsRequest(Address and $ff, InputRegister, MaxInputRegs,
              mmRTU, buff, FResponseLength);
          end;
          mbfReadHoldingRegs: begin
            BuildReadHoldingRegistersRequest(Address and $ff, InputRegister, MaxInputRegs,
              mmRTU, buff, FResponseLength);
          end;
          mbfReadInputRegs: begin
            BuildReadInputRegistersRequest(Address and $ff, InputRegister, MaxInputRegs,
              mmRTU, buff, FResponseLength);
          end;
        end;
      end;
     tpModbusTCP: begin
        //для того, чтобы отследить состояние и входов и выходо делаем так:
        // если (TransactionID and 1) = 1 - запрашиваем входы, иначе запрашиваем выходы
        TID:=GetNewTransactionID();
        RequestedModBusFunction:=mbfReadCoils;
        //InputRegister+1 - т.к. внутри вычитается на 1
        if (TransactionID and 1)=1  then
           buff:=modbus_tcp_PrepareSendBuff(RequestedModBusFunction,Address,BaseRegister,InputRegister+1,TID,16,Data)
        else
           buff:=modbus_tcp_PrepareSendBuff(RequestedModBusFunction,Address,BaseRegister,OutputRegister+1,TID,16,Data);
        //при разборе ответа учитывать TID                     `
        ResponseLength:=11;
        // 75 03 00 00 00 05 01 01 02 00 00
        // 75 03 - Transaction ID
        // 00 00 - Protocol ID
        // 00 05 - длина
        // 01 - адрес
        // 01 - функция
        // 02 - количество данных - 2 байта - 1 регистр
        // 00
        // 00 - данные
     end;
   end;

   len:=0;
   result:='';
   for I := Low(buff) to High(buff) do
       result:=result+AnsiChar(buff[i]);
end;

