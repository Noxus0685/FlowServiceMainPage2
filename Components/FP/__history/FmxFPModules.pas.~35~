    or  ((len = 6) and ((response[4]='I') or (response[4]='A')))
    );
  if not result then
  begin
     if Self.Debug then
        OutputDebugString(PChar('E:len='+IntToStr(len)+' FC='+response[1]));
  end;
  if not Result then
  begin
     if Self.Debug then
        OutputDebugString('RADWAG:???');
    if Disguise then
        Result:=true;
  end;

end;

constructor TFmxModuleScalesRADWAG.Create(port: byte; addr: integer; BR: Cardinal;
  module_manager: TFmxModuleManager);
begin
  ModuleManager := module_manager;
  inherited Create(mtScalesRADWAG);
  PortNumber:=Port;
  Address := addr;
  BaudRate := BR;
  EnabledAutoUpdate := true;
  ResponseLength := 21;
  //  S I CR LF – команда ПК
  //S I _ ? _ _ _ _ _ _ _ 1 8 . 5 _ k g _ CR LF - команда выполнена, значение массы в основных единицах измерения немедленно возвращено
  StatusQuery := 'SI'+cCR+cLF;//Передать результат в основных единицах измерения сейчас
  Timeout := 200;
  Ascii:=True;
  FFoundMinus:=False;
end;

procedure TFmxModuleScalesRADWAG.ReceiveResponse(command, response: ShortString);
var
  i,len: integer;
  s:ShortString;
  Val:Single;
label end_of_procedure;
begin
  // Процедура определяет, ответ на какую именно команду пришел, а затем обрабатывает его.
  if not Disguise then
  begin
     if (command='') then
     begin
       //таймаут
       ConnectIsOK := fdqBad;
       goto end_of_procedure;
     end;
    // Команда запроса статуса
    if response='' then goto  end_of_procedure;
    if command = StatusQuery then
    begin
      //[<< USER] 53 49 0D 0A
      //[PORT >>] 53 20 53 20 20 20 20 20 20 38 2E 39 31 31 20 6B 67 0D 0A
      //[PORT >>] S  S                        8  .  9  1  1     k  g
      //16:00:19:327 COM46 Весы (RADWAG)(0x01) <-- SI<CR><LF>
      //16:00:19:335 COM46 Весы (RADWAG)(0x01) --> SI        882.6 g  <CR><LF>

      s:='';
      if response<>'' then
      begin
        if response[1]='S' then
        begin
          len:=Length(response);
          if len=ResponseLength then
          begin
            FoundMinus:=False;
            InKG:=pos('kg',response)>0;
            for I := 6 to len-5  do
               if response[i] in ['0'..'9',',','.'] then
                  s:=s+response[i]
               else if response[i]='-' then
               begin
                 FoundMinus:=True;
               end;


            if s<>'' then
            begin
              //копируем цифру
              if not FoundMinus then
                Val:=StrToFloatDef(CP(s),0)
              else
                Val:=StrToFloatDef(CP(s),0)*-1.0;

              if not InKG then
                Val:=Val/1000.0;

              if (ScalesValue<>Val) or NeedUpdate then
              begin
                ScalesValue:=Val;
                FMustUpdate:=True;
              end;
              ConnectIsOK := fdqGood;
            end;
          end
          else begin
            if Self.Debug then
               OutputDebugString(PChar('RADWAG:'+IntToStr(len)+' FC:'+response[1]))
          end;
        end
        else if response[1]='T' then
        begin
              if Self.Debug then
                 OutputDebugString('Tara Saved!');
              FoundMinus:=False;
              ConnectIsOK := fdqGood;
        end;

      end;
      goto end_of_procedure;
    end;
  end
  else
      ConnectIsOK := fdqDisguise;
end_of_procedure:

  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
end;

function TFmxModuleScalesRADWAG.ResetTara: Boolean;
begin
(*
20.4.1. Тарирование
Написание: Z CR LF
Возможные ответы:
Z_A CR LF
Z_D CR LF
- команда получена и выполняется
- команда завершена
Z_A CR LF
Z_^ CR LF
- команда получена и выполняется
- команда принята, но возникла ошибка переполнения значений
обнуления
Z_A CR LF
Z_E CR LF
- команда получена и выполняется
- временной промежуток для получения стабильного результата в
действии
Z_I CR LF - команда принята, но не может быть выполнена*)
  Result := TFmxModuleManager(ModuleManager).SendCommand(Self,'Z'+cCR+cLF, 5);
end;

