function TFMXHSCModule.WriteRegisters(AStartAddress: Word;
  const ARegisters: array of Word): Boolean;
var
  CommandData: ShortString;
  Command: ShortString;
  RegisterCount: Integer;
  Index: Integer;
begin
  Result := False;

  RegisterCount := Length(ARegisters);

  if RegisterCount = 0 then
    Exit;

  if RegisterCount > 123 then
    raise EArgumentOutOfRangeException.CreateFmt(
      'Too many Modbus registers: %d. Maximum is 123',
      [RegisterCount]
    );

  if not Assigned(ModuleManager) then
    Exit;

  CommandData :=
    AnsiChar($10) +
    AnsiChar(Hi(AStartAddress)) +
    AnsiChar(Lo(AStartAddress)) +
    AnsiChar(Hi(RegisterCount)) +
    AnsiChar(Lo(RegisterCount)) +
    AnsiChar(RegisterCount * 2);

  for Index := 0 to RegisterCount - 1 do
  begin
    CommandData :=
      CommandData +
      AnsiChar(Hi(ARegisters[Index])) +
      AnsiChar(Lo(ARegisters[Index]));
  end;

  Command := PreparePack(Address, CommandData);

  Result :=
    TFmxModuleManager(ModuleManager).SendCommand(
      Self,
      Command,
      cHSC_IMP_Setup_Len
    );
end;

