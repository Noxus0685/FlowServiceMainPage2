function TFmxModuleIVTM.CheckResponse(command,
  response: ShortString): Boolean;
  var len:integer;
begin
  Result := false;
  // Функция определяет, ответ на какую именно команду проверяется, а затем проверяет его.
  len:=Length(response);
  // Команда запроса значений параметров внешней среды
  if command = StatusQuery then
  begin
    if FromBalance then
       Result :=  (len = ResponseLength) and (CheckForChkCr(response+cCR))
    else
       Result :=  (len = ResponseLength) and (CheckForChkCr(response))
  end;

  if Disguise then Result:=true;
end;

