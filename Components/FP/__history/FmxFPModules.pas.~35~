  FFoundMinus:=False;
  TerminatedChar:=#$0a;
end;

procedure TFmxModuleScalesMT.ReceiveResponse(command, response: ShortString);
var
  i,len: integer;
  s:ShortString;
  tmpF:Single;
label end_of_procedure;
begin
  // Процедура определяет, ответ на какую именно команду пришел, а затем обрабатывает его.
  if not Disguise then
  begin
     if (command='') then
     begin
       //таймаут
       ConnectIsOK := fdqBad;
       goto end_of_procedure;
     end;
    // Команда запроса статуса
    if response='' then goto  end_of_procedure;
    if command = StatusQuery then
    begin
      //[<< USER] 53 49 0D 0A
      //[PORT >>] 53 20 53 20 20 20 20 20 20 38 2E 39 31 31 20 6B 67 0D 0A
      //[PORT >>] S  S                        8  .  9  1  1     k  g
      //      14:08:37:784 COM13 ScalesMT(0x80) <-- SI<CR><LF>
      //14:08:37:821 COM13 ScalesMT(0x80) --> S S       -0.4 kg<CR><LF>
      s:='';
      if response<>'' then
      begin
        if response[1]='S' then
        begin
          FoundMinus:=False;
          len:=Length(response);
          if len=ResponseLength then
          begin
            for I := 2 to len-2  do
               if response[i] in ['0'..'9',',','.'] then
                  s:=s+response[i]
               else if response[i]='-' then
               begin
                 FoundMinus:=True;
               end;

            if s<>'' then
            begin
              //копируем цифру

              if not FoundMinus then
                tmpF:=StrToFloatDef(CP(s),0)
              else
                tmpF:=StrToFloatDef(CP(s),0)*-1.0;
              if (tmpF<>ScalesValue) or NeedUpdate then
              begin
                ScalesValue:=tmpF;
                MustUpdate:=True;
              end;

//              else begin
//                 OutputDebugString('Send Reset Tara CMD');
//                 FoundMinus:=False;
//                 ResetTara;
//              end;
              ConnectIsOK := fdqGood;
            end;
          end
          else begin
            if Self.Debug then
               OutputDebugString(PChar('MT:'+IntToStr(len)+' FC:'+response[1]))
          end;
        end
        else if response[1]='T' then
        begin
              if Self.Debug then
                 OutputDebugString('Tara Saved!');
              FoundMinus:=False;
              ConnectIsOK := fdqGood;
        end;

      end;
      goto end_of_procedure;
    end;
  end
  else
      ConnectIsOK := fdqDisguise;
end_of_procedure:
  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
end;

