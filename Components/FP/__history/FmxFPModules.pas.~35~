function TFmxModuleHSC_IMP.EncodeStartSetup: Word;
begin
  case StartMode of
    stmDisabled:
      Result := $0000;
    stmByCommand:
      Result := $0001;
    stmBySignal:
      begin
        if StartSource <> sisInternal then
          raise Exception.Create('Данный источник не поддерживает запуск непосредственно по сигналу');
        Result := $0003;
      end;
    stmCommandThenSignal:
      begin
        case StartSource of
          sisExternalChannel0:
            Result := $0005;
          sisImpulseChannel:
            Result := $0100 or Word(StartChannel + 1);
        else
          raise Exception.Create('Недопустимый источник сигнала начала измерения');
        end;
      end;
  else
    raise Exception.Create('Недопустимый режим начала измерения');
  end;
end;

function TFmxModuleHSC_IMP.EncodeStopSetup: Word;
begin
  case StopMode of
    spmByCommand:
      Result := $0000;
    spmByLimit:
      Result := $0001;
    spmBySignal:
      begin
        case StopSource of
          sisInternal:
            Result := $0003;
          sisExternalChannel0:
            Result := $0005;
          sisImpulseChannel:
            Result := $0100 or Word(StopChannel + 1);
        else
          raise Exception.Create('Не задан источник сигнала завершения измерения');
        end;
      end;
    spmLimitThenSignal:
      begin
        if StopSource <> sisImpulseChannel then
          raise Exception.Create('Режим лимит-затем-сигнал поддерживается только для импульсного канала');
        Result := $0300 or Word(StopChannel + 1);
      end;
  else
    raise Exception.Create('Недопустимый режим завершения измерения');
  end;
end;

function TFmxModuleHSC_IMP.EncodeInternalSyncOutput: Word;
begin
  if InternalSyncOutputEnabled then
    Result := 1
  else
    Result := 0;
end;

function TFmxModuleHSC_IMP.EncodeLegacyCombinedSyncOutput(
  const AConfig: THSCSyncOutputConfig): Word;
begin
  if not AConfig.Enabled then
    Exit(0);

  Result := Word(Ord(AConfig.OutputType)) shl 8;
  if AConfig.ChannelNumber >= 0 then
    Result := Result or Word(AConfig.ChannelNumber + 1);
end;

function TFmxModuleHSC_IMP.EncodeSyncOutput(
  const AConfig: THSCSyncOutputConfig): Word;
begin
  if not AConfig.Enabled then
    Exit(0);

  Result :=
    (Word(Ord(AConfig.OutputType)) shl 8) or
    Word(Ord(AConfig.OutputMode));
end;

function TFmxModuleHSC_IMP.SetupSyncOutputs: Boolean;
var
  Value: Word;
begin
  if ProtocolVersion < HSC_PROTOCOL_30 then
  begin
    Value := EncodeLegacyCombinedSyncOutput(LegacyCombinedSyncOutput);
    Result := WriteRegisters(REG_COMBINED_SYNC_OUTPUT, [Value]);
  end
  else
  begin
    Result := WriteRegisters(
      REG_SYNC_OUTPUT_1,
      [EncodeSyncOutput(SyncOutput1), EncodeSyncOutput(SyncOutput2)]
    );
  end;
end;

function TFmxModuleHSC_IMP.ValidateStartStopConfig(out AErrorText: string): Boolean;

  function IsImpulseChannel(AChannel: Integer): Boolean;
  begin
    Result := (AChannel >= 0) and (AChannel <= cHSC_IMP_StartStop_Max_ChannelNumber);
  end;

  function SourceRequiresPhysicalInput(ASource: THSCSyncInputSource): Boolean;
  begin
    Result := ASource in [sisInternal, sisExternalChannel0, sisImpulseChannel];
  end;

  function ValidOutputType(AOutputType: THSCSyncOutputType): Boolean;
  begin
    Result := AOutputType in [sotDisabled..sotPulseLow];
  end;

  function ValidOutputMode(AOutputMode: THSCSyncOutputMode): Boolean;
  begin
    Result := AOutputMode in [somUpOnly..somDownWithUpOff];
  end;

  function ValidateOutputConfig(const AConfig: THSCSyncOutputConfig;
    AUseChannel: Boolean): Boolean;
  begin
    Result := True;
    if not AConfig.Enabled then
      Exit;

    if not ValidOutputType(AConfig.OutputType) then
      Exit(False);

    if not AUseChannel then
      Exit(ValidOutputMode(AConfig.OutputMode));

    Result := (AConfig.ChannelNumber >= -1) and (AConfig.ChannelNumber <= cHSC_IMP_StartStop_Max_ChannelNumber);
  end;

begin
  AErrorText := '';
  Result := False;

  case StartMode of
    stmDisabled, stmByCommand:
      if StartSource <> sisNone then
        AErrorText := 'Для выбранного режима START источник должен быть sisNone';
    stmBySignal:
      if StartSource <> sisInternal then
        AErrorText := 'Запуск непосредственно по сигналу поддерживает только внутренний источник';
    stmCommandThenSignal:
      if not (StartSource in [sisExternalChannel0, sisImpulseChannel]) then
        AErrorText := 'Для START команда-затем-сигнал выбран недопустимый источник';
  end;
  if AErrorText <> '' then
    Exit;

  if (StartSource = sisImpulseChannel) and not IsImpulseChannel(StartChannel) then
  begin
    AErrorText := 'Номер импульсного канала START должен быть в диапазоне 0..15';
    Exit;
  end;

  case StopMode of
    spmByCommand, spmByLimit:
      if StopSource <> sisNone then
        AErrorText := 'Для выбранного режима STOP источник должен быть sisNone';
    spmBySignal:
      if not (StopSource in [sisInternal, sisExternalChannel0, sisImpulseChannel]) then
        AErrorText := 'Для STOP по сигналу выбран недопустимый источник';
    spmLimitThenSignal:
      if StopSource <> sisImpulseChannel then
        AErrorText := 'Режим STOP лимит-затем-сигнал поддерживает только импульсный канал';
  end;
  if AErrorText <> '' then
    Exit;

  if (StopSource = sisImpulseChannel) and not IsImpulseChannel(StopChannel) then
  begin
    AErrorText := 'Номер импульсного канала STOP должен быть в диапазоне 0..15';
    Exit;
  end;

  if (StopMode in [spmByLimit, spmLimitThenSignal]) and
     (TimeLimitSec = 0) and (ImpulseLimit = 0) then
  begin
    AErrorText := 'Для завершения по лимиту должен быть задан лимит времени или импульсов';
    Exit;
  end;

  if InternalSyncOutputEnabled and
     ((StartSource = sisInternal) or (StopSource = sisInternal)) then
  begin
    AErrorText := 'Нельзя одновременно формировать внутреннюю синхронизацию и использовать её как вход';
    Exit;
  end;

  if SourceRequiresPhysicalInput(StartSource) and SourceRequiresPhysicalInput(StopSource) and
     (StartSource <> StopSource) then
  begin
    AErrorText := 'START и STOP требуют несовместимые физические источники синхронизации';
    Exit;
  end;

  if ProtocolVersion < HSC_PROTOCOL_30 then
  begin
    if not ValidateOutputConfig(LegacyCombinedSyncOutput, True) then
    begin
      AErrorText := 'Недопустимая настройка выхода синхронизации старого протокола';
      Exit;
    end;
  end
  else
  begin
    if not ValidateOutputConfig(SyncOutput1, False) or
       not ValidateOutputConfig(SyncOutput2, False) then
    begin
      AErrorText := 'Недопустимая настройка выходов синхронизации нового протокола';
      Exit;
    end;
  end;

  Result := True;
end;

function TFmxModuleHSC_IMP.SetupStartStopMode: Boolean;
begin
  Result := SetupMeasurementStartStop;
end;

function TFmxModuleHSC_IMP.SetupMeasurementStartStop: Boolean;
var
  ErrorText: string;
  Registers: TArray<Word>;
begin
  Result := False;

  if not IsReadyToConfig then
    Exit;

  if not ValidateStartStopConfig(ErrorText) then
    raise Exception.Create(ErrorText);

  if ProtocolVersion < HSC_PROTOCOL_30 then
  begin
    SetLength(Registers, REG_COMBINED_SYNC_OUTPUT - REG_START_SETUP + 1);
    Registers[REG_COMBINED_SYNC_OUTPUT - REG_START_SETUP] :=
      EncodeLegacyCombinedSyncOutput(LegacyCombinedSyncOutput);
  end
  else
  begin
    SetLength(Registers, REG_SYNC_OUTPUT_2 - REG_START_SETUP + 1);
    Registers[REG_COMBINED_SYNC_OUTPUT - REG_START_SETUP] := 0;
    Registers[REG_SYNC_OUTPUT_1 - REG_START_SETUP] := EncodeSyncOutput(SyncOutput1);
    Registers[REG_SYNC_OUTPUT_2 - REG_START_SETUP] := EncodeSyncOutput(SyncOutput2);
  end;

  Registers[REG_START_SETUP - REG_START_SETUP] := EncodeStartSetup;
  Registers[REG_STOP_SETUP - REG_START_SETUP] := EncodeStopSetup;
  Registers[REG_TIME_LIMIT - REG_START_SETUP] := TimeLimitSec;
  Registers[REG_IMPULSE_LIMIT_LOW - REG_START_SETUP] := Word(ImpulseLimit and $FFFF);
  Registers[REG_IMPULSE_LIMIT_HIGH - REG_START_SETUP] := Word((ImpulseLimit shr 16) and $FFFF);
  Registers[REG_INTERNAL_SYNC_OUTPUT - REG_START_SETUP] := EncodeInternalSyncOutput;

  Result := WriteRegisters(REG_START_SETUP, Registers);
  if Result then
    MarkControllerSettingsWritten
  else
    IsReadyToConfig := True;
end;

function TFmxModuleHSC_IMP.SetupStartStop(aInterval:Integer=0): boolean;
var i:Integer;
begin
   ClearResults;
   //Ограничение проливки по времени
   LimitStartStopTime:=aInterval;

   //для ведущего устройства Устанавливаем время
   if MasterMode and (aInterval>0) then
      Start_Type:=1 //Мастер с ненулевым временем
   else
      Start_Type:=3; //Ведомый или Мастер с нулевым временем - (проливка по ВУ)

   Stop_Type:=Start_Type;//Окончание такое же, как начало

   //источник запуска счета - ячейки 0x0004 и 0x0005
   result:=TFmxModuleManager(ModuleManager).SendCommand(Self,PreparePack(address,cHSC_IMP_SetupStartMode+AnsiChar(Hi(Start_Type))+AnsiChar(Lo(Start_Type))+AnsiChar(Hi(Stop_Type))+AnsiChar(Lo(Stop_Type))),cHSC_IMP_Setup_Len);
   //sleep(10);
   //прописываем время время срабатывания - (ячейка 0x0006)
   result:=TFmxModuleManager(ModuleManager).SendCommand(Self,PreparePack(address,cHSC_IMP_SetupLimitStartStopTime+AnsiChar(Hi(LimitStartStopTime))+AnsiChar(Lo(LimitStartStopTime))),cHSC_IMP_Setup_Len);
   //sleep(10);
   //отключаем ограничение проливки по импульсам   (ячейки 0x0007+0x0008)
   result:=TFmxModuleManager(ModuleManager).SendCommand(Self,PreparePack(address,cHSC_IMP_SetupLimitStartStopImpulse+#$00#$00#$00#$00),cHSC_IMP_Setup_Len);
   StartStopState:=sssReady;
   //sleep(10);
   //Настройка выхода внутренней синхронизации  (ячейка 0x0009)
   if MasterMode then
      result:=TFmxModuleManager(ModuleManager).SendCommand(Self,PreparePack(address,cHSC_IMP_SetupInternalSyncOn),cHSC_IMP_Setup_Len)
   else
      result:=TFmxModuleManager(ModuleManager).SendCommand(Self,PreparePack(address,cHSC_IMP_SetupInternalSyncOff),cHSC_IMP_Setup_Len);
   //sleep(10);

   //отключаем ограничение проливки по импульсам   (ячейки 0x0007+0x0008)
   result:=TFmxModuleManager(ModuleManager).SendCommand(Self,PreparePack(address,cHSC_IMP_SetupLimitStartStopImpulse+#$00#$00#$00#$00),cHSC_IMP_Setup_Len);
   //sleep(10);

   //настраиваем внешнюю сихронизацию   (ячейка 0x000A)
   //result:=TFmxModuleManager(ModuleManager).SendCommand(Self,PreparePack(address,cHSC_IMP_SetupExternalSync+AnsiChar(Hi(ExternalSyncro))+AnsiChar(Lo(ExternalSyncro))),cHSC_IMP_Setup_Len);
   result:=SetupExternalCount();
   //sleep(10);
   //Послали очистку
   result:=TFmxModuleManager(ModuleManager).SendCommand(Self,PreparePack(address,cHSC_IMP_Clear),cHSC_IMP_Setup_Len);

   StartStopState:=sssRunning;
end;

