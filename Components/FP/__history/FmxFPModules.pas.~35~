constructor TFmxModuleWarm.Create(port:byte;addr: integer;BR:Cardinal; module_manager: TFmxModuleManager);
begin
  ModuleManager := module_manager;
  inherited Create(mtWarm);
  PortNumber:=Port;
  Address := addr;
  BaudRate := BR;
  EnabledAutoUpdate := true;
  ResponseLength := 7;
  StatusQuery := AddChkCr('#' + IntToHex(address, 2) + 'S');
  Timeout := 200;

end;

//============================================================================================================

function TFmxModuleWarm.CheckResponse(command, response: ShortString): Boolean;
begin
  Result := false;

  // Функция определяет, ответ на какую именно команду проверяется, а затем проверяет его.

  // Команда запроса статуса
  if command = StatusQuery then
    Result := (Length(response) = ResponseLength) and (CheckForChkCr(response));

  // Команда установки значения на выходе.
  if ( LeftStr(command, 3) = '#' + IntToHex(Address, 2) ) and
     ( StrToIntDef('0x' + command[4], -1) >= 10 ) and ( StrToIntDef('0x' + command[4], -1) <= 13 )
  then
    Result := response = AddChkCr('!' + IntToHex(Address, 2));
  if Disguise then Result:=true;
end;

//============================================================================================================

procedure TFmxModuleWarm.ReceiveResponse(command, response: ShortString);
var
  i: integer;
  outputs: Byte;
label end_of_procedure;
begin

  // Процедура определяет, ответ на какую именно команду пришел, а затем обрабатывает его.
 if not Disguise then
 begin
     if (command='') then
     begin
       //таймаут
       ConnectIsOK := fdqBad;
       goto end_of_procedure;
     end;
    if response='' then goto  end_of_procedure;
    // Команда запроса статуса
    if command = StatusQuery then begin
      outputs := StrToIntDef('0x' + response[4],0);
      for i:=0 to 3 do OutputValues[3-i] := ( (outputs shr i) and 1 ) = 1;
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда установки значения на выходе.
    if ( LeftStr(command, 3) = '#' + IntToHex(Address, 2) ) and
       ( StrToIntDef('0x' + command[4], -1) >= 10 ) and ( StrToIntDef('0x' + command[4], -1) <= 13 ) then
    begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;
  end
  else begin
    ConnectIsOK := fdqDisguise;
  end;

end_of_procedure:
  inherited ReceiveResponse(command, response);
end;

