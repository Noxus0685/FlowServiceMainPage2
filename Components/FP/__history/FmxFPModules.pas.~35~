procedure TFmxModuleIVTM.ReceiveResponse(command, response: ShortString);
var s,s1:ShortString;
    i:integer;
    tmpL:longword;
    tmpF:single absolute tmpL;
    AtmOld:single;
    AtmNew:single;
label end_of_procedure;
begin
  if not Disguise then begin
     if (command='') then
     begin
       //таймаут
       ConnectIsOK := fdqBad;
       goto end_of_procedure;
     end;
    if response='' then goto  end_of_procedure;
    if command = StatusQuery then begin
      ConnectIsOK := fdqGood;
      if (response[1]='!') then
      begin
        if not FromBalance then
        begin
            //Из ИВТМ
          //
          if Use_T then
          begin
            s:=copy(response,8,8);//вытаскиваем температуру
            s1:='$'+s[7]+s[8]+s[5]+s[6]+s[3]+s[4]+s[1]+s[2];
            tmpL:=StrToIntDef(s1,20);
            try
             T:=tmpF;
            finally

            end;
          end;
          //
          if Use_H then
          begin
            s:=copy(response,16,8);//вытаскиваем влажность
            s1:='$'+s[7]+s[8]+s[5]+s[6]+s[3]+s[4]+s[1]+s[2];
            tmpL:=StrToIntDef(s1,60);
            try
             H:=tmpF;
            finally

            end;
          end;


          if Use_P then
          begin
            //проверяем старый или новый
            s:=copy(response,32,4);
            s1:='$'+s[3]+s[4]+s[1]+s[2];
            i:=StrToIntDef(s1,0);
            AtmOld:=i;
            if (AtmOld>700) and  (AtmOld<800) then
            begin
              P:=AtmOld*133.322;//750 * 133.322
            end else begin
              //новый - вместо напряжения питания -третий флоат - идет атмосферное давление
              s:=copy(response,36,4);//анализируем старый или новый
              i:=StrToIntDef('$'+s,0);
                AtmOld:=tmpL;//мм рт столба

              //новый вариант
              s:=copy(response,24,8);//вытаскиваем давление или напряжение
              s1:='$'+s[7]+s[8]+s[5]+s[6]+s[3]+s[4]+s[1]+s[2];
              tmpL:=StrToIntDef(s1,20);
              try
                AtmNew:=tmpF;//мм ртутного столба
              finally

              end;
              if (AtmNew<10) and (i=0) or ((AtmOld>600) and (AtmOld<1000)) then
              begin
                //выполнилось условие старого протокола
                  P:=AtmOld*133.322;//перевели в паскали   750 * 133.322
              end
              else if (AtmNew>600) and (AtmNew<1000) then
              begin
                  //выполнилось условие нового протокола - в мм ртутного столба
                  P:=AtmNew*133.322;//перевели в паскали   750 * 133.322
              end;
            end;
          end;

        end
        else begin
          //Из Весов командой D
          (*
          13:56:05.725 << #81DD0
          13:56:06.202 >> !81000006D7000009810000267200000C2BF5
          17.51 Температура воды 		- 	000006D7 = 1751/100
          24.33 Температура воздуха ИВТМ 	-	00000981 = 2433/100
          98.42 кПа атмосферное давление	- 	00002672 = 9842/100
          31.15 влажность,%		-	00000C2B = 3115/100
          *)
          //вытаскиваем температуру воды
          s:=copy(response,4,8);
          s1:='$'+s[1]+s[2]+s[3]+s[4]+s[5]+s[6]+s[7]+s[8];
          tmpL:=StrToIntDef(s1,2000);
          Twater:=tmpL/100.0;
          //вытаскиваем температуру окружающей среды
          s:=copy(response,12,8);
          s1:='$'+s[1]+s[2]+s[3]+s[4]+s[5]+s[6]+s[7]+s[8];
          tmpL:=StrToIntDef(s1,2000);
          T:=tmpL/100.0;
          //вытаскиваем атмосферное давление
          s:=copy(response,20,8);
          s1:='$'+s[1]+s[2]+s[3]+s[4]+s[5]+s[6]+s[7]+s[8];
          tmpL:=StrToIntDef(s1,2000);
          P:=tmpL*10;//Па
          //вытаскиваем влажность
          s:=copy(response,28,8);
          s1:='$'+s[1]+s[2]+s[3]+s[4]+s[5]+s[6]+s[7]+s[8];
          tmpL:=StrToIntDef(s1,2000);
          H:=tmpL/100.0;//%
        end;
      end;
    end;
  end else
  begin
    T:=21;
    P:=101000;
    H:=32;
    ConnectIsOK := fdqDisguise;
  end;
end_of_procedure:
  inherited ReceiveResponse(command, response);
end;

