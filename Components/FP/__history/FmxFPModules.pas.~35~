  // Команда установки значения на выходе.
  if ( LeftStr(command, 3) = '#' + IntToHex(Address, 2) ) and
     ( StrToIntDef('0x' + command[4], -1) >= 0 ) and ( StrToIntDef('0x' + command[4], -1) <= 12 )
  then
    Result := response = AddChkCr('!' + IntToHex(Address, 2));
  if Disguise then Result:=true;
end;

//============================================================================================================

procedure TFmxModuleSuperBIO.ReceiveResponse(command, response: ShortString);
var
  i: integer;
  inputs: Word;
  outputs: Word;
  tmpB:Boolean;
label end_of_procedure;
begin

  // Процедура определяет, ответ на какую именно команду пришел, а затем обрабатывает его.
  if not Disguise then begin


     if (command='') then
     begin
       //таймаут
       ConnectIsOK := fdqBad;
       goto end_of_procedure;
     end;
    if response='' then goto  end_of_procedure;

    // Команда запроса статуса
    if command = StatusQuery then
    begin
        inputs := StrToIntDef('0x' + Copy(response, 4, 4),0);  //00430008
        outputs := StrToIntDef('0x' + Copy(response, 8, 4),0);
        for i:=0 to 12 do begin
          tmpB:=( (inputs shr i) and 1 ) = 1;
          if (InputValues[i] <> tmpB) or NeedUpdate then
          begin
            InputValues[i] := tmpB;
            FMustUpdate:=True;
          end;
           tmpB:=( (outputs shr i) and 1 ) = 1;
          if (OutputValues[i] <> tmpB) or NeedUpdate then
          begin
            OutputValues[i] := tmpB;
            FMustUpdate:=True;
          end;
        end;
        ConnectIsOK := fdqGood;

        goto end_of_procedure;
    end;

    // Команда установки значения на выходе.
    if ( LeftStr(command, 3) = '#' + IntToHex(Address, 2) ) and
       ( StrToIntDef('0x' + command[4], -1) >= 0 ) and ( StrToIntDef('0x' + command[4], -1) <= 12 ) then begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;
  end
  else
    ConnectIsOK := fdqDisguise;

end_of_procedure:
  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
end;

