{ ===== AddChkCrPrem =====
Вспомогательная функция.
Добавляет контрольную сумму и символ возврата коретки к строке, для связи с
расходомерами, подключаемыми по интерфейсу
}
function AddChkCrPrem(const str: ShortString): ShortString;
var
  CS:byte;
  data:byte;
  i:byte;
begin
  CS:=0;
  i:=2;
  while i<length(str) do begin
    data:=HexToInt(str[i]+str[i+1]);
    i:=i+2;
    CS:=CS+data;
  end;

  CS:=0-CS;
  Result:=str+IntToHex(CS,2)+ Chr(13)+Chr(10){+CHR(0)};
end;

