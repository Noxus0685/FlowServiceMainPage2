function TFmxModuleDeltaModbus.Init: Boolean;
begin
  // Установка источника частоты через Modbus  - Уточнить
  Result := inherited;
  //Result := WritePack(#$06#$00#$20#$00#$01, 8);
end;

procedure TFmxModuleDeltaModbus.ReceiveResponse(command, response: ShortString);
var
  regValue: Word;
  freqValue: Word;
  tmpF:Single;
  tmpB:boolean;

begin
  if not Disguise then
  begin
    if (command = '') then
    begin
      ConnectIsOK := fdqBad;
      Exit;
    end;
    if response = '' then Exit;
    // Обработка ответа на чтение регистров (функция 03)
    if (Length(response) >= 4) and (Ord(response[2]) = $03) then
    begin
      // Чтение статуса привода (регистр 1000h)
      //COM: 10:09:07.812 (COM13 4800 8-N-1)  O> 0C 03 21 00 00 04 4F 28
      //COM: 10:09:07.867 (COM13 4800 8-N-1)  I< 0C 03 08 00 00 35 03 0B B8 0B B8 6A 9D
      //00 00 -ошибки и варнинги  (4)
      //35 03 - статус работы     (6)
      //0B B8 - заданная частота  (8)
      //0B B8 - выходная частота  (10)
      //6A 9D
      if (command = StatusQuery) then
      begin
        freqValue := (Ord(response[10]) shl 8) + Ord(response[11]);
        tmpF:=freqValue / 100.0; // Преобразование из 0.01 Гц в Гц
        if FCurrentFrequency <> tmpF then
        begin
          FCurrentFrequency :=tmpF;
          FMustUpdate:=True;
        end;
        tmpB:=Ord(response[7]) = $03;
        if (Started<>tmpB) or (CountOfUpdate<5) then
        begin
          Started:=tmpB;//запущен
          FMustUpdate:=True;
        end;
      end
      else
        CountOfUpdate:=0;
      ConnectIsOK := fdqGood;
    end;
  end
  else
      ConnectIsOK := fdqBad;

  if MustUpdate or NeedUpdate then
    inherited ReceiveResponse(command, response);
end;

function TFmxModuleDeltaModbus.SetPower(const Value: Single): Boolean;
var
  freqValue: Word;
begin
  // Запуск частотника на 12 Гц
  // COM: 10:08:09.056 (COM13 4800 8-N-1)  O> 0C 06 20 01 04 B0 D1 A3
  // COM: 10:08:09.110 (COM13 4800 8-N-1)  I< 0C 06 20 01 04 B0 D1 A3
  // Преобразование процентов в частоту (0-100% -> 0-50Гц -> 0-5000)
  freqValue := Round(Value * 50.0); // 1% = 0.5 Гц  24% = 12Гц (0x04B0)
  Result := WritePack(#$06#$20#$01 + WordToBytes(freqValue), 8);
end;


function TFmxModuleDeltaModbus.StartPump: Boolean;
