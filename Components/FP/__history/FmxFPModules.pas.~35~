function TFmxModuleModbusD.WriteMultipleCoils(startAddress: Word; const Bytes: TBytes): Boolean;
var
  buff: TIdBytes;
  requestStr: ShortString;
  respLen: Byte;
  Data: array of Word;
  i, totalBits: Integer;
begin
  Result := False;
  totalBits := Length(Bytes) * 8;
  if totalBits = 0 then Exit;
  SetLength(Data, (totalBits + 15) div 16);
  for i := 0 to totalBits - 1 do
    if (Bytes[i div 8] shr (i mod 8)) and 1 <> 0 then
      Data[i div 16] := Data[i div 16] or (1 shl (i mod 16));

  case Protocol of
    tpModbusRTU:
      if not BuildWriteMultipleCoilsRequest(Address, startAddress, totalBits, Data, mmRTU, buff, respLen) then Exit;
    tpModbusASCII:
      if not BuildWriteMultipleCoilsRequest(Address, startAddress, totalBits, Data, mmASCII, buff, respLen) then Exit;
    tpModbusTCP:
      buff := modbus_tcp_PrepareSendBuff(mbfWriteCoils, UnitID, BaseRegister, startAddress + 1,
                GetNewTransactionID(), totalBits, Data);
  else
    Exit;
  end;

  requestStr := IdBytesToStr(buff);
  Result := TFmxModuleManager(ModuleManager).SendCommand(Self, requestStr, respLen);
  // При успешной отправке, если нужно обновить внутреннее состояние OutputValues,
  // можно сделать это здесь, но лучше положиться на последующий опрос.
end;

