{ ===== PremToDoubleDataConver  =====
Вспомогательная функция.
Преобразует данные из формата в котором их высылает ПРЭМ, в нужный вид
}
function PremToDoubleDataConvert(str:ShortString):Double;
var
  i:byte;
  X1,X2:AnsiChar;

  res:single;
  Pres:Pcardinal;

begin

  //развернем данные задом на перед по 2 байта
  i:=1;
  while i<(length(str)div 2) do begin
    X1:=str[i];
    X2:=str[i+1];

    str[i]:= str[length(str)-i];
    str[i+1]:= str[length(str)-i+1];

    str[length(str)-i+1]:=X2;
    str[length(str)-i]:=X1;

    i:=i+2;
  end;

  Pres:=@res;
  Pres^:=HexToInt(str);

  result:=res;
end;
