function TFmxModuleModbusA.GetStatusQuery: ShortString;
var
    Data: array[0..0] of Word;
    buff:TIdBytes;
    len:Word;
    i:Integer;
    TID:Word;
    requeststr:ShortString;
begin
   FErrorCode:=mbeNone;
   //Data в данном запросе не требуется
   SetLength(buff,0);
   //с перспективой поддержать и два других протокола
   RequestedModBusFunction:=mbfReadHoldingRegs;
   case Protocol of
     tpProprietary: ;
     tpModbusASCII: begin
       case RequestedModBusFunction of
         mbfReadHoldingRegs: begin
          BuildReadHoldingRegistersRequest(Address and $ff,BaseRegister+InputRegister-1,MaxInputRegs,
            mmASCII,buff,FResponseLength);
         end;
         mbfReadInputRegs: begin
          BuildReadInputRegistersRequest(Address and $ff,BaseRegister+InputRegister-1,MaxInputRegs,
            mmASCII,buff,FResponseLength);
         end;
       end;
     end;
     tpModbusRTU: begin
       //MaxInputRegs _максимальное количество входных регистров
       case RequestedModBusFunction of
         mbfReadHoldingRegs: begin
          BuildReadHoldingRegistersRequest(Address and $ff,InputRegister,MaxInputRegs,
            mmRTU,buff,FResponseLength);
         end;
         mbfReadInputRegs: begin
          BuildReadInputRegistersRequest(Address and $ff,InputRegister,MaxInputRegs,
            mmRTU,buff,FResponseLength);
         end;
       end;
     end;
     tpModbusTCP: begin
        //для того, чтобы отследить состояние и входов и выходо делаем так:
        // если (TransactionID and 1) = 1 - запрашиваем входы, иначе запрашиваем выходы
        TID:=GetNewTransactionID();
        RequestedModBusFunction:=mbfReadHoldingRegs;
        //InputRegister+1 - т.к. внутри вычитается на 1
        if (TransactionID and 1)=1  then
           buff:=modbus_tcp_PrepareSendBuff(mbfReadHoldingRegs,Address,BaseRegister,InputRegister+1,TID,32,Data)
        else
           buff:=modbus_tcp_PrepareSendBuff(mbfReadHoldingRegs,Address,BaseRegister,OutputRegister+1,TID,32,Data);
        //при разборе ответа учитывать TID                     `
        ResponseLength:=74; //считываю сразу же 32 регистра - 16 флоатов
        // 75 03 00 00 00 05 01 01 02 00(10)
        //00 00 00 00 - 1               (+4)
        //00 00 00 00 - 2               (+4)
        //00 00 00 00 - 3               (+4)
        //00 00 00 00 - 4               (+4)
        //00 00 00 00 - 5               (+4)
        //00 00 00 00 - 6               (+4)
        //00 00 00 00 - 7               (+4)
        //00 00 00 00 - 8               (+4)
        //00 00 00 00 - 9               (+4)
        //00 00 00 00 - 10              (+4)
        //00 00 00 00 - 11              (+4)
        //00 00 00 00 - 12              (+4)
        //00 00 00 00 - 13              (+4)
        //00 00 00 00 - 14              (+4)
        //00 00 00 00 - 15              (+4)
        //00 00 00 00 - 16              (+4)=74
        // 75 03 - Transaction ID
        // 00 00 - Protocol ID
        // 00 05 - длина
        // 01 - адрес
        // 01 - функция
        // 02 - количество данных - 2 байта - 1 регистр
        // 00
        // 00 - данные
     end;
   end;

   len:=0;
   result:='';
   for I := Low(buff) to High(buff) do
       result:=result+AnsiChar(buff[i]);
end;


procedure TFmxModuleModbusA.ReceiveResponse(command, response: ShortString);
var i:integer;
    uValue:Single;
    responcedata:TIdBytes;
    error:TModbusExceptionCode;
    dValue:array[0..1] of Word absolute uValue;
    bvalues:array[0..3] of byte absolute uValue;
begin
  //inbuff,len,ReceiveBuffer заполнены в функции CheckResponse
  if (Command<>'') and (response<>'') then
  begin
   case Protocol of
     tpProprietary: ;
     tpModbusRTU: begin
         responcedata:=ShortStringToIdBytes(response);
         ParseReadRegistersResponse(responcedata,mmRTU,DataRegisters,error);
         for i:=0 to MaxChannels-1 do
         begin
         { TODO : Проверить корректность разбора }
           case ModbusFormat of
             mdf_0_1_2_3:begin ;
               dValue[0]:=Swap(DataRegisters[i*2]);
               dValue[1]:=Swap(DataRegisters[i*2+1]);
             end;
             mdf_1_0_3_2: begin ;//ТРМ10
               dValue[0]:=DataRegisters[i*2];
               dValue[1]:=DataRegisters[i*2+1];
             end;
             mdf_2_3_0_1:begin ;//
               dValue[1]:=Swap(DataRegisters[i*2]);
               dValue[0]:=Swap(DataRegisters[i*2+1]);
             end;
             mdf_3_2_1_0:begin ;//
               dValue[1]:=DataRegisters[i*2];
               dValue[0]:=DataRegisters[i*2+1];
             end;
             mdf_0_1:begin ;//занимает один регистр
               uValue:=DataRegisters[i];
             end;
           end;

           if (uValue<>InputValues[i])  or NeedUpdate  then
           begin
              InputValues[i]:=uValue;
              FMustUpdate:=True;
           end;
         end;
         ConnectIsOK := fdqGood;
     end;
     tpModbusASCII: begin
        responcedata:=ShortStringToIdBytes(response);
        ParseReadRegistersResponse(responcedata,mmASCII,DataRegisters,error);
         for i:=0 to MaxChannels-1 do
         begin
         { TODO : Проверить корректность разбора }
           case ModbusFormat of
             mdf_0_1_2_3:begin ;
               dValue[0]:=Swap(DataRegisters[i*2]);
               dValue[1]:=Swap(DataRegisters[i*2+1]);
             end;
             mdf_1_0_3_2: begin ;//ТРМ10
               dValue[0]:=DataRegisters[i*2];
               dValue[1]:=DataRegisters[i*2+1];
             end;
             mdf_2_3_0_1:begin ;//
               dValue[1]:=Swap(DataRegisters[i*2]);
               dValue[0]:=Swap(DataRegisters[i*2+1]);
             end;
             mdf_3_2_1_0:begin ;//
               dValue[1]:=DataRegisters[i*2];
               dValue[0]:=DataRegisters[i*2+1];
             end;
           end;
           if (uValue<>InputValues[i]) or NeedUpdate  then
           begin
              InputValues[i]:=uValue;
              FMustUpdate:=True;
           end
         end;
         ConnectIsOK := fdqGood;
     end;
     tpModbusTCP: begin
        modbus_tcp_ExtractAnswer(RequestedModBusFunction,inbuff,len,ReceiveBuffer,DataRegisters);
        case RequestedModBusFunction of
          mbfReadHoldingRegs:
          begin
                //2024-08-15 13:26:13 если (TransactionID and 1) = 1 - запрашиваем входы, иначе запрашиваем выходы
                 if (TransactionID and 1)=1  then
                 begin
                   //Входы
                   for i:=0 to MaxChannels-1 do
                   begin
                   { TODO : Проверить корректность разбора }
                       case ModbusFormat of
                         mdf_0_1_2_3:begin ;
                           dValue[0]:=Swap(DataRegisters[i*2]);
                           dValue[1]:=Swap(DataRegisters[i*2+1]);
                         end;
                         mdf_1_0_3_2: begin ;//ТРМ10
                           dValue[0]:=DataRegisters[i*2];
                           dValue[1]:=DataRegisters[i*2+1];
                         end;
                         mdf_2_3_0_1:begin ;//
                           dValue[1]:=Swap(DataRegisters[i*2]);
                           dValue[0]:=Swap(DataRegisters[i*2+1]);
                         end;
                         mdf_3_2_1_0:begin ;//
                           dValue[1]:=DataRegisters[i*2];
                           dValue[0]:=DataRegisters[i*2+1];
                         end;
                       end;
                     //InputValues[i]:=uValue;
                     if (uValue<>InputValues[i]) or NeedUpdate  then
                     begin
                        InputValues[i]:=uValue;
                        FMustUpdate:=True;
                     end
                   end;
                   ConnectIsOK := fdqGood;
                 end
                 else begin
                   //выходы
                   for i:=0 to MaxChannels-1 do
                   begin
                   { TODO : Проверить корректность разбора }
                     case ModbusFormat of
                       mdf_0_1_2_3:begin ;
                         dValue[0]:=Swap(DataRegisters[i*2]);
                         dValue[1]:=Swap(DataRegisters[i*2+1]);
                       end;
                       mdf_1_0_3_2: begin ;//ТРМ10
                         dValue[0]:=DataRegisters[i*2];
                         dValue[1]:=DataRegisters[i*2+1];
                       end;
                       mdf_2_3_0_1:begin ;//
                         dValue[1]:=Swap(DataRegisters[i*2]);
                         dValue[0]:=Swap(DataRegisters[i*2+1]);
                       end;
                       mdf_3_2_1_0:begin ;//
                         dValue[1]:=DataRegisters[i*2];
                         dValue[0]:=DataRegisters[i*2+1];
                       end;
                     end;
//                     OutputValues[i]:=uValue;
                     if (uValue<>OutputValues[i]) or NeedUpdate  then
                     begin
                        OutputValues[i]:=uValue;
                        FMustUpdate:=True;
                     end
                   end;
                   ConnectIsOK := fdqGood;
                 end;
          end;//mbfReadCoils
        end;
     end;
   end;
  end
  else
   ConnectIsOK := fdqBad;
  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
end;



