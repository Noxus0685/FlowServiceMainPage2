procedure TFmxModuleADC_I70XX.ReceiveResponse(command, response: ShortString);
var
  i,tmpI: integer;
  tmpL:longword;
  tmpF:Single absolute tmpL;
  tmpW,tmpWI:word;
  s: ShortString;
label end_of_procedure;
begin
 // Процедура определяет, ответ на какую именно команду пришел, а затем обрабатывает его.
 if not Disguise then
 begin
     if (command='') then
     begin
       //таймаут
       ConnectIsOK := fdqBad;
       goto end_of_procedure;
     end;
    if response='' then goto  end_of_procedure;

    // 3 канала  - ответ 14 байт
    //[<< USER] #2A - считать значения со всех каналов - в данном случае 3
    //[PORT >>] >1B6E80008000
    //1E75 ~ 23.8
    // Команда запроса статуса
    if HexAnswer then
    begin
      //Вариант 4 цифры на значение
      // 8 каналов - ответ 34 байта
      //[<< USER] #29
      //[PORT >>] >FFFEFFFF195BFFFFFFFFFFFFFFFEFFFF

      //Вариант 8 цифр на значение
      //4 канала 8 цифр на значение
      //[<< USER] #2A
      //[PORT >>] >3186103C000000000000000000000000


      for i:=0 to MaxChannels-1 do
      begin
        s:='$'+Copy(response,2 + i*FDigitsForChannel, FDigitsForChannel);
        if FDigitsForChannel=8 then
        begin
           //если 8 символов - данные представлены в флоат формате
           tmpL:= StrToIntDef(s,0);
        end
        else begin
           //если 4 символа или другое число - данные представлены в целочисленном формате
           tmpW:= StrToIntDef(s,0);
           tmpF:=TwosComplementToDecimal(tmpW);
        end;

        if (InputValues[i]<>tmpF) then
        begin
          InputValues[i]:=tmpF;
          FMustUpdate:=True;
        end;
      end;
    end
    else begin
      //Вариант 7 цифр на значение
      // 8 каналов - ответ 58 байт
      //15:30:50.764[<< USER] #29
      //15:30:50.886[PORT >>] >+05.000-9999.9-9999.9-9999.9-9999.9-9999.9-9999.9-9999.9
      //еще один вариант >-0000+015.81+015.87'#$D - первый канал имеет другой формат 2025-09-29
      for i:=0 to MaxChannels-1 do
      begin
        s:=ExtractSignParameter(response,i+1);
        tmpF:=StrToFloatDef(s,0.0);
        if (InputValues[i]<>tmpF) then
        begin
          InputValues[i]:=tmpF;
          FMustUpdate:=True;
        end;
      end;
    end;
    ConnectIsOK := fdqGood;
 end
 else
    ConnectIsOK := fdqDisguise;

end_of_procedure:
  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
end;

