function TFmxModuleHSC_IMP.SetupInputs: boolean;
var i:Integer;
    cmd:ShortString;
begin
   result := False;
   if not IsReadyToConfig then Exit;
   result := True;
   //Пробегаемся по всем активным входам и настраиваем их тип
   for I := 0 to cHSC_IMP_Max_ChannelNumber do
   if CounterIsActive[i] then
   begin
     //тип входа
     cmd:= PreparePack(address,#$10#$40+AnsiChar(((i+1) shl 4)+4{0x4004})+#$00#$01#$02+AnsiChar(Hi(TypeOfInputs[i]))+AnsiChar(Lo(TypeOfInputs[i])));
     result:=TFmxModuleManager(ModuleManager).SendCommand(Self,cmd,cHSC_IMP_Setup_Len);
     //Включаем фильтр
     if AntiShatterFilters[i] then
     begin
       cmd:=PreparePack(address,#$10#$40+AnsiChar(((i+1) shl 4)+6{0x4006})+#$00#$01#$02#$00#$01);
       result:=TFmxModuleManager(ModuleManager).SendCommand(Self,cmd,cHSC_IMP_Setup_Len);
       cmd:= PreparePack(address,#$10#$40+AnsiChar(((i+1) shl 4)+7{0x4007})+#$00#$01#$02+AnsiChar(Hi(FAntiShatterFilterTimes[i]))+AnsiChar(Lo(FAntiShatterFilterTimes[i])));
       result:=TFmxModuleManager(ModuleManager).SendCommand(Self,cmd,cHSC_IMP_Setup_Len);
     end;
   end;
end;

function TFmxModuleHSC_IMP.nSetupInputs: Boolean;
var
  I: Integer;
  ChannelRegister: Word;
  FilterEnabled: Word;
  FilterTime: Word;
begin
  Result := False;

  if not IsReadyToConfig then
    Exit;

  for I := 0 to cHSC_IMP_Max_ChannelNumber do
  begin
    if not CounterIsActive[I] then
      Continue;

    // Канал 0: $4014..$4017
    // Канал 1: $4024..$4027
    // ...
    ChannelRegister :=
      rHSC_IMP_ChannelStateMin + Word((I + 1) shl 4);

    FilterEnabled := Word(Ord(AntiShatterFilters[I]));

    if AntiShatterFilters[I] then
      FilterTime := AntiShatterFilterTimes[I]
    else
      FilterTime := 0;

    // Один пакет 0x10 на канал:
    // +0 — тип входа;
    // +1 — тип ожидаемой частоты;
    // +2 — включение фильтра;
    // +3 — время фильтра.
    if not WriteRegisters(
      ChannelRegister,
      [
        TypeOfInputs[I],
        TypeOfFrequences[I],
        FilterEnabled,
        FilterTime
      ]
    ) then
      Exit;
  end;

  Result := True;
end;

