{ ===== CheckForChkCr =====
Вспомогательная функция.
Проверяет правлильность контрольной суммы и наличие символа возврата коретки в конце строки.
}
function _CheckForChkCr(const str: ShortString): Boolean;
var s:ShortString;
begin
  s:=AddChkCr(LeftStr(str, Length(str)-3));
  if  s = str then Result := true
  else result := false;
end;
function CheckForChkCr(const str: ShortString): Boolean;
var s:ShortString;
    crcstr:ShortString;
    crc:byte;
begin
  crcstr:='$'+Copy(str,Length(str)-2,2);
  crc:=GetCRC(Copy(str,1,Length(str)-3));
  if  crc = StrToIntDef(crcstr,0) then
    Result := true
  else
    result := false;

end;

{ ===== AddCRCMdbRTU =====
Вспомогательная функция.
Преобразует строку в вид нужный для ModBus RTU и
добавляет контрольную сумму crc16 и символ возврата коретки к строке.
}
function AddCRCMdbRTU(str:ShortString):ShortString;
var
  i,j:byte;
  b: array of Word;
  crc:word;
  res:ShortString;
begin
  if str='' then exit;
  res:='';
  i:=1; j:=0;
  setlength(b, round(length(str)/2));
  repeat
    b[j]:=HexToInt(str[i]+str[i+1]);
    i:=i+2; j:=j+1;
  until i>length(str);
  crc:=GetCRC16(b,length(str));
  Setlength(b, length(b)+1);
  b[length(b)-1]:=crc;

  for i:=0 to length(b)-1 do
    res:=res+IntToHex(b[i],2);

  i:=1;
  Result:='';
  repeat
    Result:=Result+AnsiChar(HexToInt(res[i]+res[i+1]));
    i:=i+2;
  until i>length(res);
end;

function AddHexCRCMdbRTU(str:ShortString):ShortString;
var
  i,j:byte;
  b: array of Word;
  crc:word;
  res:ShortString;
begin
  if str='' then exit;
  res:='';
  i:=1; j:=0;
  i:=1; j:=0;
  setlength(b, round(length(str)));
  for i := 1 to length(str) do
    b[i]:=Ord(str[i]);
  crc:=GetCRC16(b,length(str));
  Setlength(b, length(b)+1);
  b[length(b)-1]:=crc;

  for i:=0 to length(b)-1 do
    res:=res+IntToHex(b[i],2);

  i:=1;
  Result:='';
  repeat
    Result:=Result+AnsiChar(HexToInt(res[i]+res[i+1]));
    i:=i+2;
  until i>length(res);
end;



{ ===== ConvertDataFromMdbRTU =====
преобразует из ртушного вида в нормальный строковый
и проверяет контрольную сумму, если контрольная сумма не сходится, то
возвращает значение 'CRCFail'
}
function  ConvertDataFromMdbRTU(response:ShortString):ShortString;
var
  i:integer;
  res:ShortString;
begin
  if Length(response)<>0 then
  begin
      Result:='';
      for i:=1 to length(response) do
         Result:=Result+IntToHex(Ord(response[i]),2);

      //отделим контрольную сумму от твета
      res:=copy(result,1,length(result)-4);
      //добавим контрольную сумму
      res:=AddCRCMdbRTU(res);
      //и сравним ответ, с тем, что получилось
      if res<>response then result:='CRCFail';
  end
  else result:='CRCFail';
end;

