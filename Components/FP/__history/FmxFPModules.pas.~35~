{ TFmxModuleBIO }

function TFmxModuleBIO.CheckResponse(command, response: ShortString): Boolean;
begin
  Result := false;

  // Функция определяет, ответ на какую именно команду проверяется, а затем проверяет его.

  // Команда запроса статуса
  //#A4SEB #$0D
  //!A4AD7 #$0D
  if command = StatusQuery then
    Result := (Length(response) = ResponseLength) and (CheckForChkCr(response))
  //#A3A008  #$0D
  //!A395    #$0D
  // Команда установки значения на выходе.
  else if ( LeftStr(command, 3) = '#' + IntToHex(Address, 2) ) and
     ( command[4] in ['A','B']) and (command[5] in ['0','1'])
  then
    Result := True;

  if Disguise then Result:=true;
end;

constructor TFmxModuleBIO.Create(port: byte; addr: integer; BR: Cardinal;
  module_manager: TFmxModuleManager);
begin
  ModuleManager := module_manager;
  inherited Create(mtBIO);
  PortNumber:=Port;
  Address := addr;
  BaudRate := BR;
  EnabledAutoUpdate := true;
  ResponseLength := 7;
  StatusQuery := AddChkCr('#' + IntToHex(address, 2) + 'S');
  Timeout := 200;
end;

procedure TFmxModuleBIO.ReceiveResponse(command, response: ShortString);
var
  i: integer;
  inputs,outputs: Word; tmpB:Byte;
  tb:boolean;
label end_of_procedure;
begin
  // Процедура определяет, ответ на какую именно команду пришел, а затем обрабатывает его.
  if not Disguise then
  begin
    if (command='') then
    begin
       //таймаут
       ConnectIsOK := fdqBad;
       goto end_of_procedure;
    end;
    if response='' then goto  end_of_procedure;

    // Команда запроса статуса
      if command = StatusQuery then
      begin
          tmpB:=StrToIntDef('0x'+Copy(response, 4, 1),0); // копируем полубайт байт состояния
          //0000 - младшие два бита - состояние линий управления         (младший - канал B, старший канал A),
          //       старшие два бита - состояния линий ввода - конечников (младший - канал B, старший канал A)
          tb:=(tmpB and $8)>0;//A
          if InputValues[0]<>tb then
          begin
            InputValues[0]:=tb;
            FMustUpdate:=True;
          end;
          tb:=(tmpB and $4)>0;//B
          if InputValues[1]<>tb then
          begin
            InputValues[1]:=tb;
            FMustUpdate:=True;
          end;
          tb:=(tmpB and $2)>0;//A
          if OutputValues[0]<>tb then
          begin
            OutputValues[0]:=tb;
            FMustUpdate:=True;
          end;
          tb:=(tmpB and $1)>0;//B
          if OutputValues[1]<>tb then
          begin
            OutputValues[1]:=tb;
            FMustUpdate:=True;
          end;
      end;
      ConnectIsOK := fdqGood;
  end
  else
    ConnectIsOK := fdqDisguise;
end_of_procedure:
  inherited ReceiveResponse(command, response);
end;

function TFmxModuleBIO.SetOutput(output_number: Byte; value: Boolean): Boolean;
var
  command: ShortString;
begin
  if output_number < 2 then
  begin
    if TFmxModuleManager(ModuleManager).Debug then
    begin
       if value then
          OutputDebugString(PChar('TFmxModuleBIO.SetOutput('+IntToStr(output_number)+', TRUE)'))
       else
          OutputDebugString(PChar('TFmxModuleBIO.SetOutput('+IntToStr(output_number)+', FALSE)'));
    end;
    if value then command := '1'
    else command := '0';
    OutputValues[output_number]:= value;
    if output_number=0 then
       command := AddChkCr('#' + IntToHex(Address, 2) + 'A' + command)
    else
       command := AddChkCr('#' + IntToHex(Address, 2) + 'B' + command);
    Result := TFmxModuleManager(ModuleManager).SendCommand(Self, command, 6);
  end
  else Result := false;
end;

function TFmxModuleBIO.UpdateStatus: Boolean;
begin
  Result := TFmxModuleManager(ModuleManager).SendCommand(Self, StatusQuery, 14);
end;

