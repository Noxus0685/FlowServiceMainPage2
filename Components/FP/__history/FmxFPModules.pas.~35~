      tmpE:=RoundTo(StrToIntDef('0x'+Copy(response,27,8),0)/10,-1);
      if (InTankTime<>tmpE) or NeedUpdate then
      begin
        InTankTime:=tmpE;
        FMustUpdate:=True;
      end;
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда переключения УПП.
    if ( LeftStr(command, 3) = '#' + IntToHex(Address, 2) ) and
       ( command[4] >= 'A' ) and ( command[4] <= 'C' ) then begin
