constructor TFmxModuleFCD.Create(port:byte;addr: integer;BR:Cardinal; module_manager: TFmxModuleManager);
begin
  ModuleManager := module_manager;
  inherited Create(mtFCD);
  ActiveChannel := 0;
  PortNumber:=Port;
  Address := addr;
  BaudRate := BR;
  EnabledAutoUpdate := true;
  ResponseLength := 11;
  StatusQuery := AddChkCr('#' + IntToHex(address, 2) + 'S');
  Timeout := 200;

end;

//============================================================================================================

function TFmxModuleFCD.CheckResponse(command, response: ShortString): Boolean;
begin
  Result := false;

  // Функция определяет, ответ на какую именно команду проверяется, а затем проверяет его.

  // Команда запроса статуса
  if command = StatusQuery then
    Result := (Length(response) = ResponseLength) and (CheckForChkCr(response));

  // Команда переключения УПП.
  if ( LeftStr(command, 3) = '#' + IntToHex(Address, 2) ) and
     ( command[4] >= 'A' ) and ( command[4] <= 'C' )
  then
    Result := response = AddChkCr('!' + IntToHex(Address, 2));

  // Команда переключения УПП на время.
  if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'V' then
    Result := response = AddChkCr('!' + IntToHex(Address, 2));
  if Disguise then Result:=true;
end;

//============================================================================================================

procedure TFmxModuleFCD.ReceiveResponse(command, response: ShortString);
label end_of_procedure;
   var
    PrevPositions: array [0..2] of Boolean;
    i:integer;
begin

  // Процедура определяет, ответ на какую именно команду пришел, а затем обрабатывает его.
  if not Disguise then begin
     if (command='') then
     begin
       //таймаут
       ConnectIsOK:=fdqBad;
       goto end_of_procedure;
     end;

    // Команда запроса статуса
    if response='' then goto  end_of_procedure;
    if command = StatusQuery then begin
      //сохраняем предыдущее состояние
      for i := 0 to 2 do
        PrevPositions[i]:=InTankPositions[i];
      var tmpB:boolean;
      for i:=0 to 2 do
      begin
        tmpB:=response[4+i] = '1';
        if (InTankPositions[i] <> tmpB) or NeedUpdate then
        begin
          InTankPositions[i] := tmpB;
          FMustUpdate:=True;
        end;
      end;

      for i := 0 to 2 do if PrevPositions[i]<>InTankPositions[i] then
      begin
        //произошла смена состояния
        if Self.Debug then
          if InTankPositions[i] then OutputDebugString(cStartLogMessage)
          else OutputDebugString(cStopLogMessage);
      end;
      InTankTime := Round( StrToIntDef('0x' + Copy(response, 7, 2),0)/3);
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда переключения УПП.
    if ( LeftStr(command, 3) = '#' + IntToHex(Address, 2) ) and
       ( command[4] >= 'A' ) and ( command[4] <= 'C' ) then begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда переключения УПП на время.
    if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'V' then begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;
  end
  else
    ConnectIsOK := fdqDisguise;

end_of_procedure:
  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
end;

