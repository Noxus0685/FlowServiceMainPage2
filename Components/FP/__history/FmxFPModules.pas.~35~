function TFmxModuleATV312.ConvertPowerToString(value: Single): ShortString;
var
  aux_int: Longword;
  i: integer;
  cur_byte: Byte;
begin
  if (value < 0) or (value > 100) then value := 0;
  value := value * 163.84;

  Result := '';
  aux_int := (PLongint(@value))^;
  for i := 0 to 3 do begin
    cur_byte := aux_int and 255;
    Result := IntToHex(cur_byte, 2) + Result;
    aux_int := aux_int shr 8;
  end;
end;

//============================================================================================================

function TFmxModuleATV312.ConvertStringToPower(str: ShortString): Single;
var
  aux_int: Longword;
  i: integer;
  cur_byte: Byte;
begin
  Result := 0;
  aux_int := StrToIntDef('0x' + str, 0);
  if (aux_int = 0) or (Length(str) <> 8) then Exit;

  aux_int := 0;
  for i:=0 to 3 do begin
    aux_int := aux_int shl 8;
    cur_byte := StrToIntDef( '0x' + Copy(str, 1 + i*2, 2),0 );
    aux_int := aux_int + cur_byte;
  end;

  Result := (PSingle(@aux_int))^;
  Result := Result / 163.84;
end;




