   crc:=GetKM5CRC(response,InBuffCount-2);
   if (InBuffCount=16) or (InBuffCount=32) or (InBuffCount=72) then
   begin
      crcpack:=PWord(@response[InBuffCount-1])^;
      result:=(crc=crcpack);
      if not result then
         BadCRC:=BadCRC+1
      else begin
         result:=(command[5]=response[5]);
         if not result then
         begin
            //возможно прибор занят
            if LastReceived<10 then LastReceived:=LastReceived+1;
            TotalReceived:=TotalReceived+1;
         end;
      end;
   end
   else
      result:=False;
  if Disguise then Result:=true;
end;

