function TFmxModuleHSC_FCD.SetOutput(output_number: Byte; value: Boolean): Boolean;
var
  command: ShortString;
begin
  if output_number < 4 then
  begin
   SlivChannel:=output_number;
   OutputValues[output_number]:=value;
   case output_number of
   0: begin
        if not InitValues[0] then
        begin
           WritePack(cHSC_FCDSetOutput_Init_1,8);
           sleep(cBeforePause);
           InitValues[0]:=True;
        end;
        if value then
             WritePack(cHSC_FCDSetOutput_ON_1,8)
        else
             WritePack(cHSC_FCDSetOutput_OFF_1,8);
      end;
   1: begin
        if not InitValues[1] then
        begin
           WritePack(cHSC_FCDSetOutput_Init_2,8);
           sleep(cBeforePause);
           InitValues[1]:=True;
        end;
        if value then
             WritePack(cHSC_FCDSetOutput_ON_2,8)
        else
             WritePack(cHSC_FCDSetOutput_OFF_2,8);
      end;
   2: begin
        if not InitValues[2] then
        begin
           WritePack(cHSC_FCDSetOutput_Init_3,8);
           sleep(cBeforePause);
           InitValues[2]:=True;
        end;
        if value then
             WritePack(cHSC_FCDSetOutput_ON_3,8)
        else
             WritePack(cHSC_FCDSetOutput_OFF_3,8);
      end;
   3: begin
        if not InitValues[3] then
        begin
           WritePack(cHSC_FCDSetOutput_Init_4,8);
           sleep(cBeforePause);
           InitValues[3]:=True;
        end;
        if value then
             WritePack(cHSC_FCDSetOutput_ON_4,8)
        else
             WritePack(cHSC_FCDSetOutput_OFF_4,8);
      end;
   end;
   result:=True;
  end
  else Result := false;
end;


