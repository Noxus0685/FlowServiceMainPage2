{ ===== AddChkCr =====
Вспомогательная функция.
Добавляет контрольную сумму и символ возврата коретки к строке.
}
function GetCRC(const str: ShortString): Byte;
var
  CHK: Word;
  i,len:integer;
begin
  CHK := 0;
  len:=Length(str);
  for i:=1 to len do CHK := CHK + Ord(str[i]);
  CHK := CHK mod 256;
  Result := CHK;
end;

{ ===== AddChkCr =====
Вспомогательная функция.
Добавляет контрольную сумму и символ возврата коретки к строке.
}
function AddChkCr(const str: ShortString): ShortString;
var
  CHK: Word;
  i,len:integer;
begin
  CHK := 0;
  len:=Length(str);
  for i:=1 to len do CHK := CHK + Ord(str[i]);
  CHK := CHK mod 256;
  Result := str + ShortString(IntToHex(CHK, 2)) + Chr(13);
end;

