function TFmxModuleScalesAD103.CheckResponse(command,
  response: ShortString): Boolean;
var  len:integer;
begin
  Result := false;
  // Команда запроса статуса
  len:=Length(response);
  if len=0 then
  begin
    Result := True;
    if Self.Debug then
       OutputDebugString('AD103C:Timeout..');
    Exit;
  end;
  if (command = cScaleAD103C_StatusQuery) or
     (command = cScaleAD103C_Initialize) then
    Result :=  ((len = ResponseLength) and (response[9]=cCR))  or //Корректный ответ
    ((len = 3) and (response[1]='0') or (response[1]='?'));        //Корректный ответ на инициализацию или запрос инициализации
  if not Result then
  begin
     if Self.Debug then
        OutputDebugString('AD103C:???');
    if Disguise then
        Result:=true;
  end;
end;

constructor TFmxModuleScalesAD103.Create(port: byte; addr: integer; BR: Cardinal;
  module_manager: TFmxModuleManager);
begin
  ModuleManager := module_manager;
  inherited Create(mtScalesAD103);
  PortNumber:=Port;
  Address := addr;
  BaudRate := BR;
  EnabledAutoUpdate := true;
  ResponseLength := 3;
  StatusQuery := cScaleAD103C_Initialize;
  Timeout := 300;
  Ascii:=False;
  FFoundMinus:=False;
  Parity := TComParity.cpEven;
  TerminatedChar:=cCR;
end;

procedure TFmxModuleScalesAD103.ReceiveResponse(command, response: ShortString);
var
  i,len: integer;
  s:ShortString;
  tmpF:Single;
label end_of_procedure;
begin
  // Процедура определяет, ответ на какую именно команду пришел, а затем обрабатывает его.
  if not Disguise then
  begin
     if (command='') then
     begin
       //таймаут
       ConnectIsOK := fdqBad;
       goto end_of_procedure;
     end;
    // Команда запроса статуса
    if response='' then goto  end_of_procedure;
    len:=Length(response);//Длина ответа

    if command = cScaleAD103C_StatusQuery then
    begin
      s:='';
//    [<< USER] 4D 53 56 3F 31 3B 20
//    [PORT >>] 20 30 31 33 39 37 32 30 0D 0A
//    [PORT >>] 2D 30 30 31 36 34 37 34 0D 0A
      if len in [3,10] then
      begin
        if response[1]='?' then
        begin
          StatusQuery:=cScaleAD103C_Initialize;
          ResponseLength := 3;
          ConnectIsOK := fdqGood;
          goto end_of_procedure;
        end;

        if len=ResponseLength then
        begin
            FoundMinus:=False;
            for I := 1 to len-2  do
             if response[i] in ['0'..'9',',','.'] then
                s:=s+response[i]
             else if response[i]='-' then
             begin
               FoundMinus:=True;
             end;

            if s<>'' then
            begin
              //копируем цифру
              if not FoundMinus then
                  tmpF:=StrToIntDef(CP(s),0)/1000.0
              else
                  tmpF:=-1.0*StrToIntDef(CP(s),0)/1000.0;
              if (tmpF<>ScalesValue) or NeedUpdate then
              begin
                ScalesValue:=tmpF;
                MustUpdate:=True;
              end;
              ConnectIsOK := fdqGood;
            end;
        end
      end;
      goto end_of_procedure;
    end
    else if command = cScaleAD103C_Initialize then begin
      if len = 3 then
      begin
        if response[1]='?' then
        begin
          //Пришел непонятный ответ - требуется инициализация
          StatusQuery:=cScaleAD103C_Initialize;
          ResponseLength := 3;
          ConnectIsOK := fdqGood;
          goto end_of_procedure;
        end;
        if response[1]='0' then
        begin
          //переключаемся на опрос данных
          StatusQuery:=cScaleAD103C_StatusQuery;
          ResponseLength := 10;
          ConnectIsOK := fdqGood;
          goto end_of_procedure;
        end;
      end;
    end;
  end
  else
    ConnectIsOK := fdqDisguise;
end_of_procedure:
  if MustUpdate or NeedUpdate then
      inherited ReceiveResponse(command, response);
end;


