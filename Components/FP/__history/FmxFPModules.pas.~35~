function TFmxModuleADC_I70XX.CheckResponse(command,
  response: ShortString): Boolean;
  var found:boolean;
      len:integer;
begin
  Result := false;
  // Функция определяет, ответ на какую именно команду проверяется, а затем проверяет его.
  len := Length(response);
  // Команда запроса статуса - если длина сопадает, стартовый символ = '>' и ответ завершается перводом картеки
  Result := (response[1]='>') and (response[len]=cCR);

  if not result then
  begin
    //Если не совпадает - проверяем - вдруго сменен тип протокола
    found:=(pos('.',response)>0);
    if HexAnswer then
    begin
       //найдена точка - не должно - меняем тип протокола
       if found then HexAnswer:=False;
    end
    else begin
       //не найдена точка - а должно - меняем тип протокола
       if not found then HexAnswer:=True;
    end;
  end
  else begin
    //По умолчанию протокол ASCII
    if HexAnswer then
       if (pos('.',response)>0) then
          HexAnswer:=False;
  end;


  if Disguise then Result:=true;
end;

