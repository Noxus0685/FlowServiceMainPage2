function TFmxModuleModbusA.SetOutput(output_number: Byte; value: Single): Boolean;
 var
    Data: array[0..1] of Word;
    FValue:Single;
    FDataValue:array[0..1] of Word absolute FValue;
    buff:TIdBytes;
    len:Word;
    i:Integer;
    requeststr:ShortString;
    responcelen:byte;
begin
   //запись в COIL по адресу
   //начально
   SetLength(buff,0);
   RequestedModBusFunction:=mbfWriteRegs;
   FValue:=value;
   { TODO : Проверить правильность формирования последовательности данных в посылке }
   case ModbusFormat of
     mdf_0_1_2_3:begin ;
       Data[0]:=Swap(FDataValue[0]);
       Data[1]:=Swap(FDataValue[1]);
     end;
     mdf_1_0_3_2: begin ;//ТРМ10
       Data[0]:=FDataValue[0];
       Data[1]:=FDataValue[1];
     end;
     mdf_2_3_0_1:begin ;//
       Data[1]:=Swap(FDataValue[0]);
       Data[0]:=Swap(FDataValue[1]);
     end;
     mdf_3_2_1_0:begin ;//
       Data[1]:=FDataValue[0];
       Data[0]:=FDataValue[1];
     end;
   end;
//   Data[0]:=FDataValue[1];
//   Data[1]:=FDataValue[0];
// с перспективой поддержать и два других протокола позднее
   case Protocol of
     tpProprietary: ;
     tpModbusRTU: begin
        BuildWriteMultipleRegistersRequest(Address and $ff,OutputRegister+output_number*2,Data,mmRTU,buff,responcelen);
     end;
     tpModbusASCII: begin
        BuildWriteMultipleRegistersRequest(Address and $ff,OutputRegister+output_number*2,Data,mmASCII,buff,responcelen);
     end;
     tpModbusTCP: begin
         buff:=modbus_tcp_PrepareSendBuff(RequestedModBusFunction,UnitID,BaseRegister,OutputRegister+output_number*2+2,GetNewTransactionID(),2,Data);
         responcelen:=6;
     end;
   end;
   len:=0;
   requeststr:='';
   for I := Low(buff) to High(buff) do
       requeststr:=requeststr+AnsiChar(buff[i]);
   result:=TFmxModuleManager(ModuleManager).SendCommand(Self,requeststr,responcelen);

   //ответ приходит сначала в CheckResponce
   //затем - если последний вернул положительный ответ - в ReceiveResponce
end;

