  RawValue: Cardinal;
begin
  AValue := 0;

  Result := ReadUInt32(
    ARegisterAddress,
    RawValue,
    AWordOrder
  );

  if Result then
    Move(RawValue, AValue, SizeOf(AValue));
end;

function TFMXHSCModule.ReadUInt16(ARegisterAddress: Word;
  out AValue: Word): Boolean;
var
  Registers: TModbusRegisters;
begin
  Result := ReadRegisters(
    ARegisterAddress,
    1,
    Registers
  );

  if Result then
    AValue := Registers[0];
end;

function TFMXHSCModule.ReadUInt32(ARegisterAddress: Word; out AValue: Cardinal;
  AWordOrder: TModbusWordOrder): Boolean;
var
  Registers: TModbusRegisters;
begin
  AValue := 0;

  Result := ReadRegisters(
    ARegisterAddress,
    2,
    Registers
  );

  if not Result then
    Exit;

  case AWordOrder of
    mwoHighWordFirst:
      AValue :=
        (Cardinal(Registers[0]) shl 16) or
        Cardinal(Registers[1]);

    mwoLowWordFirst:
      AValue :=
        (Cardinal(Registers[1]) shl 16) or
        Cardinal(Registers[0]);
  end;
end;


