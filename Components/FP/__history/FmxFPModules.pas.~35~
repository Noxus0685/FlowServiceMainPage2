end;



// Реализация

function TFmxModuleModbusD.ReadCoils(startAddress: Word; count: Word; out Bytes: TBytes): Boolean;
var
  buff: TIdBytes;
  requestStr: ShortString;
  respLen: Byte;
  i: Integer;
  Data: array of Word;
begin
  Result := False;
  SetLength(Bytes, 0);
  if count = 0 then Exit;

  // Создаём запрос в зависимости от протокола
  case Protocol of
    tpModbusRTU:
      if not BuildReadCoilsRequest(Address, startAddress, count, mmRTU, buff, respLen) then Exit;
    tpModbusASCII:
      if not BuildReadCoilsRequest(Address, startAddress, count, mmASCII, buff, respLen) then Exit;
    tpModbusTCP:
      begin
        SetLength(Data, 1);
        buff := modbus_tcp_PrepareSendBuff(mbfReadCoils, UnitID, BaseRegister, startAddress + 1,
                  GetNewTransactionID(), count, Data);
        respLen := 0;
      end;
  else
    Exit;
  end;

  requestStr := IdBytesToStr(buff);
  if not TFmxModuleManager(ModuleManager).SendCommand(Self, requestStr, respLen) then
    Exit;

  // После отправки команды, ответ уже обработан в ReceiveResponse,
  // и состояние катушек находится в OutputValues (или InputValues – смотри ReceiveResponse)
  // Для RTU/ASCII мы добавили обработку, которая заполняет OutputValues.
  // Для TCP она уже была.
  SetLength(Bytes, (count + 7) div 8);
  FillChar(Bytes[0], Length(Bytes), 0);
  for i := 0 to count - 1 do
    if i < Length(OutputValues) then
    begin
      if OutputValues[i] then
        Bytes[i div 8] := Bytes[i div 8] or (1 shl (i mod 8));
    end;
  Result := True;
end;

