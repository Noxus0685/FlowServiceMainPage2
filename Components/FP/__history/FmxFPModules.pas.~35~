function TFmxModuleKM5.PreparePack(KM5Addr:longword;CmdBody: ShortString): ShortString;
var CRC:Word;
    s:ShortString;
    AB:array[1..4] of byte absolute KM5Addr;
    answer_len:byte;
begin
  s:=ansichar(AB[1])+ansichar(AB[2])+ansichar(AB[3])+ansichar(AB[4])+CmdBody;
  answer_len:=Length(s);
  CRC:=GetKM5CRC(s,answer_len);
  result:=s+ansichar(CRC and $FF)+ansichar((CRC SHR 8) AND $FF);
end;


function TFmxModuleKM5.WritePack(CmdBody: ShortString): boolean;
var answer_len:byte;
begin
  if ord(CmdBody[1])<64 then
     answer_len:=32
  else
     answer_len:=72;
  result:=TFmxModuleManager(ModuleManager).SendCommand(Self,PreparePack(Address,CmdBody),answer_len);
end;

