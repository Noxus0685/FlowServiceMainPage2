procedure TFmxModuleValve.ReceiveResponse(command, response: ShortString);
var
  i: integer;
  tmpB:Boolean;
  tmpW:word;
  inputs: Word;
  outputs: Word;
label end_of_procedure;
begin
  // Процедура определяет, ответ на какую именно команду пришел, а затем обрабатывает его.
 if not Disguise then
 begin
     if (command='') then
     begin
       //таймаут
       ConnectIsOK := fdqBad;
       goto end_of_procedure;
     end;
    if response='' then goto  end_of_procedure;
    // Команда запроса статуса
    if command = StatusQuery then
    begin
      inputs := StrToIntDef('0x' + Copy(response, 4, 4),0);
      outputs := StrToIntDef('0x' + Copy(response, 8, 4),0);
      for i:=0 to 8 do begin
        tmpB:= ( (inputs shr i)  and 1 ) = 1;
        if (InputValues[i]<>tmpB) or NeedUpdate then
        begin
          InputValues[i]:=tmpB;
          FMustUpdate:=True;
        end;
        tmpB:=( (outputs shr i) and 1 ) = 1;
        if (OutputValues[i] <> tmpB) or NeedUpdate then
        begin
          OutputValues[i] := tmpB;
          FMustUpdate:=True;
        end;
      end;
      tmpB:=( (inputs shr 9) and 1) = 1;
      if (InputValues[9] <> tmpB) or NeedUpdate then
      begin
        InputValues[9] := tmpB;
        FMustUpdate:=True;
      end;

      for i:=0 to 2 do begin
        tmpW:=StrToIntDef( Copy(response, 12 + i*4, 4),0 );
        if (ValvePositions[i] <> tmpW) or NeedUpdate then
        begin
          ValvePositions[i] := tmpW;
          FMustUpdate:=True;
        end;
      end;
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда остановки задижек.
    if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'B' then begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда изменения положения задвижки.
    if ( LeftStr(command, 3) = '#' + IntToHex(Address, 2) ) and
       ( command[4] >= '0' ) and ( command[4] <= '2' ) then begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда установки значения на выходе модуля-устройства.
    if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'O' then begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда калибровки задижек.
    if LeftStr(command, 4) = '$' + IntToHex(Address, 2) + '0' then begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;
  end
  else begin
    ConnectIsOK := fdqDisguise;
  end;
end_of_procedure:
  //переношу отсюда вызов этого метода в обработку запроса статуса
  //т.к. если его вызвывать при ответе на каждую команду, то в случае
  //если в обработчике ответов от модуля в зависимости от статуса модуля
  //включается/выключается какой то вывод, то возникает бесконечная рекурсия
  //аналогично можно будет сделать с модулем superbio
  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
end;

