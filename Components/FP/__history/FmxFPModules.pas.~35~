  // Команда запроса статуса
  if command = StatusQuery then
    Result := (Length(response) = ResponseLength) and (CheckForChkCr(response));

  // Команда остановки задижек.
  if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'B' then
    Result := response = AddChkCr('!' + IntToHex(Address, 2));

  // Команда изменения положения задвижки.
  if ( LeftStr(command, 3) = '#' + IntToHex(Address, 2) ) and
     ( command[4] >= '0' ) and ( command[4] <= '2' )
  then
    Result := response = AddChkCr('!' + IntToHex(Address, 2));

  // Команда установки значения на выходе модуля-устройства.
  if LeftStr(command, 4) = '#' + IntToHex(Address, 2) + 'O' then
    Result := response = AddChkCr('!' + IntToHex(Address, 2));

  // Команда калибровки задижек.
  if LeftStr(command, 4) = '$' + IntToHex(Address, 2) + '0' then
    Result := response = AddChkCr('!' + IntToHex(Address, 2));
