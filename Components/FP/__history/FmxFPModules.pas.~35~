    begin
       if value then
          OutputDebugString(PChar('TFmxModuleWarm.SetOutput('+IntToStr(output_number)+', TRUE)'))
       else
          OutputDebugString(PChar('TFmxModuleWarm.SetOutput('+IntToStr(output_number)+', FALSE)'));
    end;
    if value then command := '1'
    else command := '0';
    command := AddChkCr('#' + IntToHex(Address, 2) + IntToHex(10+output_number, 1) + command);
    Result := TFmxModuleManager(ModuleManager).SendCommand(Self, command, 6);
  end
  else Result := false;
