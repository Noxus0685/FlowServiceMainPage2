procedure TFmxModuleABBModbus.ReceiveResponse(command, response: ShortString);
var
  i: integer;
  s:ShortString;
  dataT:Word;
  tmpF:Single;
  tmpB:Boolean;
  dataTBody:array[1..2] of byte absolute dataT;
label end_of_procedure;
begin

 if (command='') then
 begin
   ConnectIsOK := fdqBad;
   Exit;
 end;
 if response='' then goto  end_of_procedure;
 if not Disguise then
 begin
    if response='' then goto  end_of_procedure;
    if command = StatusQuery then
    begin
      //(COM15 19200 8-N-1)  O> 0B 03 00 00 00 06 C5 62
      //(COM15 19200 8-N-1)  I< 0B 03 0C 00 6F 12 C0 00 00 13 37 00 70 00 8F 90 20
      //0C - длина
      //00 6F - слово управления 4,5
      //12 C0 - задание 1        6,7
      //00 00 - задание 2        8,9
      //13 37 - слово состояния  10,11
      //00 70 - фактическое значение частоты задания 1 (умноженное на 10) 12,13
      //00 8F - фактическое значение частоты задания 2                    14,15
      //90 20 - CRC16
      // - слово состояния
      dataTBody[1]:=Ord(response[11]);
      dataTBody[2]:=Ord(response[10]);
      HasError:=(dataT and $08) > 0;     //TRIPPED - отказ
      // - слово управления
      dataTBody[1]:=Ord(response[5]);
      dataTBody[2]:=Ord(response[4]);
      tmpB:=(dataT<>0) and (not HasError);
      if Started<>tmpB then
      begin
        Started:=tmpB;
        FMustUpdate:=True;
      end;
      //фактическая частота
      dataTBody[1]:=Ord(response[13]);
      dataTBody[2]:=Ord(response[12]);
      tmpF:=(dataT/10)*2;//приходит в герцах * 10 - преобразуем в мощность в %
      if FPower<>tmpF then
      begin
        FPower:=tmpF;
        FMustUpdate:=True;
      end;
    end;
    ConnectIsOK := fdqGood;
 end
 else
    ConnectIsOK := fdqDisguise;

end_of_procedure:
  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
end;
