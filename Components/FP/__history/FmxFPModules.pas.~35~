procedure TFmxModuleHSC_FCD.ReceiveResponse(command, response: ShortString);
var
  i,len: integer;
  s:ShortString;
  tW,tmpW:word;
  tmpB:Boolean;
  tmpL:longword;
  tmpF:Single absolute tmpL;
  arrW:Array[1..2] of Word absolute tmpL;
label end_of_procedure;
begin
 if (command='') then
 begin
   ConnectIsOK := fdqBad;
   Exit;
 end;
 if response='' then goto  end_of_procedure;
 if not Disguise then
 begin
    len:=Length(response);
    if response='' then goto  end_of_procedure;
    if command = PreparePack(Address,cHSC_FCD_GetTimeInTank) then
    begin
      if len=cHSC_FCD_GetTimeInTank_Len then
        ConnectIsOK :=fdqGood
      else
        ConnectIsOK :=fdqBad;

      if ConnectIsOK in [fdqGood,fdqDisguise] then
      begin
        tmpW:=PWord(@response[4])^;
        arrW[1]:=Swap(tmpW);
        tmpW:=PWord(@response[6])^;
        arrW[2]:=Swap(tmpW);
        if (InTankTime<>tmpF) or NeedUpdate  then
        begin
          InTankTime:=tmpF;
          FMustUpdate:=True;
          //и следующим статусом начальный заголовок вместе с ошибками
          ResponseLength := cHSC_FCD_Version_Len;
          StatusQuery := PreparePack(address,cHSC_FCD_Version);
        end;
      end;
    end
    else if command = PreparePack(Address,cHSC_FCD_Version) then
    begin
      if len=cHSC_FCD_Version_Len then
         ConnectIsOK := fdqGood
      else
         ConnectIsOK := fdqBad;

      if ConnectIsOK in [fdqGood,fdqDisguise] then
      begin
//22:06:38.673[<< USER] 65 03 00 00 00 12 CD E3
//22:06:38.768[PORT >>] 65 03 24 F1 05 AF 07 00 65 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 03 00 00 00 09 00 00 00 00 00 00 66 F8
// F1 05  AF 07  00 65  00 00  00 00  00 01  00 00 00 00 00 00 00 00 00 00 00 00 00 03 00 00 00 09 00 00 00 00 00 00 66 F8
//660300000012CDD0
//660324 F105 AF01 0066 0000 0000 0001 0000 0000 0000 0000 0000 0000 0002 0000 0009 0000 0000 0000 A1B0
//660324 - адрес команда длина
//F105 - Идентификатор - 4
//AF01 - Версия протокола - 6
//0066 - адрес устройства - 8
//0000 - Режим симуляции - 10
//0000 - Настройка старта проливки -12
//0001 - Настройка окончания проливки - 14
//0000 - Ограничение проливки по времени -16
//00000000 - регистры 7 и 8 -18
//0000 - Регистр 9 Настройка входа внутренней синхронизации - 22
//00000000 - Регистры А и B    -24
//0002 - Установка активного ПП - 28
//0000 - регистр D -30
//0009 - регистр E ошибки - 32
//0000 - регистр F - 34
//0000 - регистр 10 Номер последней проливки 0 - 36
//0000 - 38
//A1B0 - контролька
