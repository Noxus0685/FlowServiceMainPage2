procedure TFmxModuleAgat.ReceiveResponse(command, response: ShortString);
var
   i,j:integer;
   tmpL:longword;
   tmpF:single absolute tmpL;
   tmpS,tmpS2:ShortString;
   tmpState:byte;
label end_of_procedure;
begin
  // Процедура определяет, ответ на какую именно команду пришел, а затем обрабатывает его.
  if not Disguise then begin
     if (command='') then
     begin
       //таймаут
       ConnectIsOK := fdqBad;
       goto end_of_procedure;
     end;
    if response='' then goto  end_of_procedure;
    // Команда запроса статуса
    //ответ валидный - разбираем
    if command = StatusQuery then
    begin
        for i:=0 to 3 do
        begin
          tmpS:='';tmpS2:='';
          for j:=7 downto 0  do
          begin
             if tmpS2<>'' then begin
                tmpS2:=response[4+j+i*8]+tmpS2;
                tmpS:=tmpS+tmpS2;
                tmpS2:='';
             end
             else
                tmpS2:=response[4+j+i*8]+tmpS2;
          end;
          //16 значений в формате флоат 32 бит  (по 8 символов) 4 канала
          tmpL:=StrToIntDef('$'+tmpS,0);   //1402 - 4120 - '!D0000000000000204100000000000000009C'#$D
          try
            if (Values[i]<>tmpF) or NeedUpdate then
            begin
              Values[i]:=tmpF;
              FMustUpdate:=True;
            end;
          finally

          end;
        end;
        tmpS2:='$'+response[cLenAgat_Q-3];
        tmpState:=StrToInt(tmpS2);
        state[0]:=(tmpState and 1)=1;
        state[1]:=(tmpState and 2)=2;
        state[2]:=(tmpState and 4)=4;
        state[3]:=(tmpState and 8)=8;
        ConnectIsOK := fdqGood;
    end
    else
      // Команда запроса расхода по расходомерам
      if ( LeftStr(command, 3) = '#' + IntToHex(Address, 2) ) and ( command[4] = 's' ) then
      begin
          //кокманда запроса статуса
          State[0] := response[4] = '1';
          State[1] := response[5] = '1';
          State[2] := response[6] = '1';
          State[3] := response[7] = '1';
          State[4] := response[8] = '1';
          ConnectIsOK := fdqGood;
      end;
   goto end_of_procedure;
  end
  else
    ConnectIsOK := fdqDisguise;

end_of_procedure:
  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
end;

