function TFmxModuleModbusA.CheckResponse(command, response: ShortString): Boolean;
begin
  case Protocol of
    tpProprietary: ;
    tpModbusRTU: begin
      inbuff:=StrToIdBytes(response);
      obuff:=StrToIdBytes(command);
      Result :=Modbus_CheckAnswer(obuff,inbuff,mmRTU,FErrorCode);
    end;
    tpModbusASCII: begin
      inbuff:=StrToIdBytes(response);
      obuff:=StrToIdBytes(command);
      Result :=Modbus_CheckAnswer(obuff,inbuff,mmASCII,FErrorCode);
    end;
    tpModbusTCP: begin
      //TODO - через StrToIdBytes - проверить аналогичность и заменить
      len:=Length(response);SetLength(inbuff,len);inbuff:=RawToBytes(response[1],len);
      result:=modbus_tcp_CheckAnswer(RequestedModBusFunction,inbuff,len,ReceiveBuffer);
    end;
  end;

end;


