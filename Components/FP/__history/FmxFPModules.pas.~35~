  if ConvertDataFromMdbRTU(response)<>'CRCFail' then
    Result:=true;

  // Функция определяет, ответ на какую именно команду проверяется, а затем проверяет его.

  {
  // Команда инициализации работы с модулем-устройством (она же использыется для обновления статуса).
