  // Базовый класс для частотных преобразователей
  //----------------------------------------------
  TFmxPumpModule = class(TFmxModule)
  private
    // Мощность выставляемая  в процентах. 0..100
    FPower: Single;

    // Флаг активности насоса.
    FStarted: Boolean;

    // Флаг ошибки
    FHasError: Boolean;

    // Текущая частота (только чтение)
    FCurrentFrequency: Single;

    // Ток двигателя (только чтение)
    FMotorCurrent: Single;

    function WritePack(CmdBody: ShortString; answer_len: byte): boolean;virtual;
    function PreparePack(_Addr: byte; CmdBody: ShortString): ShortString;virtual;
    procedure SetupPower(const Value: single);
    procedure SetMotorCurrent(const Value: Single);
    function GetCurrentFrequency: Single;virtual;

  public

    { ===== Init =====
    Инициализирует работу с модулем-устройством. Необходимо выполнять один раз перед отправкой команд.
    Возвращает false в случае:
    - функция вызвана не из потока работы с COM-портом;
    - произошла ошибка при работе с COM-портом.
    }
    function Init: Boolean;virtual;

    { ===== SetPower =====
    Устанавливает мощность насоса.
    Принимаемые параметры:
    power - устанавливаемая мощность в процентах (от 0 до 100).
    Возвращает false в случае:
    - функция вызвана не из потока работы с COM-портом;
    - произошла ошибка при работе с COM-портом;
    - некорректное значение устанавливаемой мощности.
    }
    function SetPower(const Value: Single): Boolean;virtual;

    function GetPower(): Single;virtual;

    { ===== StartPump =====
    Запускает насос.
    Возвращает false в случае:
    - функция вызвана не из потока работы с COM-портом;
    - произошла ошибка при работе с COM-портом.
    }
    function StartPump: Boolean;virtual;

    { ===== StopPump =====
    Останавливает насос.
    Возвращает false в случае:
    - функция вызвана не из потока работы с COM-портом;
    - произошла ошибка при работе с COM-портом.
    }
    function StopPump: Boolean;virtual;

    { ===== UpdateStatus =====
    Обновляет статус привода и текущие значения.
    }
    function UpdateStatus: Boolean;virtual;

    //Устанавливаема мощность
    property Power: single read GetPower write SetupPower;

    // Текущая частота (только чтение)
    property CurrentFrequency: Single read  GetCurrentFrequency;

    // Флаг активности насоса.
    property Started: Boolean read FStarted write FStarted;

    // Флаг ошибки
    property HasError: Boolean read FHasError write FHasError;

    // Ток двигателя (только чтение)
    property MotorCurrent: Single read FMotorCurrent write SetMotorCurrent;

  end;

