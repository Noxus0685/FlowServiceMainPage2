function TFmxModuleLogoDAC.PreparePack(_Addr: byte;
  CmdBody: ShortString): ShortString;
var CRC:Word;
    s:ShortString;
    answer_len:byte;
    tmpB:boolean;
    tmpF:single;
begin
  s:=ansichar(_Addr)+CmdBody;
