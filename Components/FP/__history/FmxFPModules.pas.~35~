procedure TFmxModuleHSC_IMP.ApplyMeasurementStatus(AStatus: Word);
var
  PrevState: EHSCIMPModuleState;
begin
  PrevState := State;

  if ProtocolVersion >= HSC_PROTOCOL_30 then
  begin
    case AStatus of
      HSC_STATUS_NONE,
      HSC_STATUS_IDLE:
        begin
          StartStopState := sssReady;
          State := hmsReady;
        end;
      HSC_STATUS_RUNNING:
        begin
          StartStopState := sssRunning;
          State := hmsExecute;
        end;
      HSC_STATUS_MONITOR:
        begin
          StartStopState := sssRunning;
          State := hmsMonitor;
        end;
      HSC_STATUS_WAIT_START:
        begin
          StartStopState := sssReady;

          if PrevState in [hmsMonitorWait, hmsMonitor] then
            State := hmsMonitorWait
          else
            State := hmsStartWait;
        end;
      HSC_STATUS_WAIT_STOP:
        begin
          StartStopState := sssRunning;
          State := hmsStopWait;
        end;
      HSC_STATUS_RESULT_READY:
        begin
          StartStopState := sssFinished;
          State := hmsResultReady;
        end;
    else
      begin
        StartStopState := sssReady;
        State := hmsError;
      end;
    end;

    Exit;
  end;

  // Legacy protocol: ProtocolVersion < HSC_PROTOCOL_30.
  // Old firmware does not distinguish normal measurement from monitor mode.
  // Status 1 only means SPILLAGE.spillage = 1.
  // Therefore monitor/execute is determined by previous module state.
  case AStatus of
    HSC_STATUS_NONE:
      begin
        StartStopState := sssReady;
        State := hmsReady;
      end;
    HSC_STATUS_RUNNING:
      begin
        StartStopState := sssRunning;

        if PrevState in [hmsMonitorWait, hmsMonitor] then
          State := hmsMonitor
        else
          State := hmsExecute;
      end;
    HSC_STATUS_RESULT_READY:
      begin
        StartStopState := sssFinished;
        State := hmsResultReady;
      end;
    HSC_STATUS_IDLE:
      begin
        StartStopState := sssReady;
        State := hmsReady;
      end;
    HSC_STATUS_WAIT_START:
      begin
        StartStopState := sssReady;

        if PrevState in [hmsStartWait, hmsMonitorWait] then
          State := PrevState
        else
          State := hmsError;
      end;
  else
    begin
      StartStopState := sssReady;
      State := hmsError;
    end;
  end;
end;


function TFmxModuleHSC_IMP.GetParseChannelCount(
  const Response: ShortString;
  AFirstChannelOffset: Integer;
  ARegistersPerChannel: Integer
): Integer;
var
  DataBytes: Integer;
  ServiceBytes: Integer;
  ChannelDataBytes: Integer;
  BytesPerChannel: Integer;
begin
  Result := 0;

  if Length(Response) < 5 then
    Exit;

  DataBytes := Ord(Response[3]);

  if Length(Response) < DataBytes + 5 then
    Exit;

  // Данные Modbus начинаются с Response[4].
  // Если первый канал начинается с AFirstChannelOffset,
  // значит служебная часть занимает AFirstChannelOffset - 4 байт.
  ServiceBytes := AFirstChannelOffset - 4;

  if ServiceBytes < 0 then
    Exit;

  if DataBytes < ServiceBytes then
    Exit;

  BytesPerChannel := ARegistersPerChannel * 2;

  if BytesPerChannel <= 0 then
    Exit;

  ChannelDataBytes := DataBytes - ServiceBytes;

  Result := ChannelDataBytes div BytesPerChannel;

  if Result > cHSC_IMP_Max_ChannelNumber + 1 then
    Result := cHSC_IMP_Max_ChannelNumber + 1;
end;


procedure TFmxModuleHSC_IMP.ParseStatusResponse(const Response: ShortString);
var
  I: Integer;
  Value: Word;
  Count, Offset: Integer;
begin

  ApplyMeasurementStatus(ReadWordBE(Response, 6));

  Offset:=10;
  Count := GetParseChannelCount(Response, Offset, 1);

  for I := 0 to Count - 1 do
  begin
    Value := ReadWordBE(Response, Offset + I * 2);
    if FlowmeterFrequencies[I] <> Value then
    begin
      FlowmeterFrequencies[I] := Value;
      FMustUpdate := True;
    end;
  end;

  if StartStopState <> sssFinished then
  begin
    Value := ReadWordBE(Response, 4);
    if StartStopTime <> Value then
    begin
      StartStopTime := Value;
      FMustUpdate := True;
    end;
  end;

  ConnectIsOK := fdqGood;
end;


procedure TFmxModuleHSC_IMP.ParseCurrentValuesResponse(const Response: ShortString);
var
  I: Integer;
  Value : Longword;
  Count, Offset : Integer;
begin
  if Length(Response) < cHSC_IMP_CurrentValues_Len then
  begin
    ConnectIsOK := fdqBad;
    MarkCommunicationLost;
    Exit;
  end;

  ConnectIsOK := fdqGood;

  CurrentTime := ReadWordBE(Response, 4);
  StartStopTime := CurrentTime;

  Value := ReadWordBE(Response, 6);
  ApplyMeasurementStatus(Value);

  Offset:= 10;
  Count := GetParseChannelCount(Response, Offset, 1);

  for I := 0 to Count - 1 do
  begin
    Value := ReadWordBE(Response, Offset + I * 2);

    if FlowmeterFrequencies[I] <> Value then
    begin
      FlowmeterFrequencies[I] := Value;
      FMustUpdate := True;
    end;
  end;
end;

procedure TFmxModuleHSC_IMP.ParseImpulsesResponse(const Response: ShortString);
begin
  ParseTotalImpulsesResponse(Response);
end;

procedure TFmxModuleHSC_IMP.ParseFinalTimeResponse(const Response: ShortString);
var
  Value: Single;
begin
  ConnectIsOK := fdqGood;
  Value := ReadSingleBE(Response, 4);
  if StartStopTime <> Value then
  begin
    FResultTime:=Value;
    StartStopTime := Value;
    FMustUpdate := True;
  end;
end;

procedure TFmxModuleHSC_IMP.ParseVersionResponse(const Response: ShortString);
begin
  State := hmsReady;
  StatusQueryCount := 1;
  ConnectIsOK := fdqGood;

  DeviceID := ReadWordBE(Response, 4);
  ProtocolID := ReadWordBE(Response, 6);
  ProtocolVersion := ProtocolID;
  Simulation := ReadWordBE(Response, 10) <> 0;
  Start_Type := ReadWordBE(Response, 12);
  Stop_Type := ReadWordBE(Response, 14);
  LimitStartStopTime := ReadWordBE(Response, 16);
  LimitStartStopImpulse := ReadUInt32BE(Response, 18);
  InternalSyncro := ReadWordBE(Response, 22) <> 0;
  ExternalSyncro := ReadWordBE(Response, 24);
  FMustUpdate := True;
  ApplyMeasurementStatus(ReadWordBE(Response, 38));
end;

procedure TFmxModuleHSC_IMP.ParseFinalImpulsesResponse(const Response: ShortString);
var
  I: Integer;
  Value: Single;
  Count, Offset: Integer;
begin
  ConnectIsOK := fdqGood;
  Offset := 8;
  Count := GetParseChannelCount(Response, Offset, 2);

  for I := 0 to Count - 1 do
  begin
    Value := ReadSingleBE(Response, Offset + I * 4);
    if FinalFlowmeterImpulses[I] <> Value then
    begin
      FlowmeterImpulses[I] := Round(Value);
      FinalFlowmeterImpulses[I] := Value;
      FMustUpdate := True;
    end;
  end;
end;

procedure TFmxModuleHSC_IMP.ParseTotalImpulsesResponse(const Response: ShortString);
var
  I: Integer;
  Value: Longword;
  Count, Offset: Integer;
begin
  if Length(Response) < cHSC_IMP_TotalImpulses_Len then
  begin
    ConnectIsOK := fdqBad;
    MarkCommunicationLost;
    Exit;
  end;

  ConnectIsOK := fdqGood;

  // Первый канал начинается с Response[12]:
  // Response[1]  - адрес
  // Response[2]  - функция
  // Response[3]  - ByteCount
  // Response[4]  - 0x9200, CurrentTime hi
  // Response[5]  - 0x9200, CurrentTime lo
  // Response[6]  - 0x9201, reserved
  // Response[8]  - 0x9202, reserved
  // Response[10] - 0x9203, reserved
  // Response[12] - 0x9204, channel 0 UInt32
  Offset := 12;

  CurrentTime := ReadWordBE(Response, 4);
  StartStopTime := CurrentTime;

  // Offset задаёт начало массива каналов.
  // 2 означает, что один канал занимает 2 регистра = 4 байта.
  Count := GetParseChannelCount(Response, Offset, 2);

  for I := 0 to Count - 1 do
  begin
    Value := ReadUInt32BE(Response, Offset + I * 4);

    if FlowmeterImpulses[I] <> Value then
    begin
      FlowmeterImpulses[I] := Value;
      FMustUpdate := True;
    end;
  end;
end;

procedure TFmxModuleHSC_IMP.ParseChannelStateResponse(const Response: ShortString);
begin
  if StatusQueryCount in [1..(cHSC_IMP_Max_ChannelNumber + 1)] then
  begin
    FTypeOfInputs[StatusQueryCount - 1] := ReadWordBE(Response, 4);
    FAntiShatterFilters[StatusQueryCount - 1] := ReadWordBE(Response, 8) <> 0;
    FAntiShatterFilterTimes[StatusQueryCount - 1] := ReadWordBE(Response, 10);
    FMustUpdate := True;
  end;
  StatusQueryCount := StatusQueryCount + 1;
end;

{
  ReceiveResponse

  Основная точка обработки ответов контроллера HSC_IMP.

  Алгоритм работы:

  1. Проверка таймаута обмена.
  2. Проверка наличия ответа.
  3. Извлечение логической команды из Modbus-запроса.
  4. Извлечение адреса регистра.
  5. Определение типа ответа.
  6. Вызов специализированного обработчика.
  7. Обновление состояния связи.
  8. Уведомление подписчиков об изменении данных.

  Каждому типу ответа соответствует отдельная процедура:

    ParseStatusResponse
    ParseImpulsesResponse
    ParseFinalTimeResponse
    ParseVersionResponse
    ParseFinalImpulsesResponse
    ParseChannelStateResponse

  Низкоуровневый разбор Modbus-пакетов выполняется
  средствами FmxModbusHelper.
}
procedure TFmxModuleHSC_IMP.ReceiveResponse(command, response: ShortString);
var
  Cmd: ShortString;
  Reg: Word;

label end_of_procedure;
begin
  if command = '' then
  begin
    ConnectIsOK := fdqBad;
    MarkCommunicationLost;
    Exit;
  end;

  if response = '' then
    goto end_of_procedure;

  Cmd := ExtractModbusCommand(command);
  Reg := ExtractModbusRegister(command);

  if not Disguise then
  begin
    try
      // Ответ на запрос текущего состояния измерения
      if Cmd = cHSC_IMP_StatusQuery then
        ParseStatusResponse(response)
      // Ответ на команды записи регистров.
      // Для Modbus-функций записи успешное выполнение
      // подтверждается стандартным коротким ответом.
      else if Length(response) = cHSC_IMP_Start_Len then
        ConnectIsOK := fdqGood
      // Ответ на запрос накопленных импульсов
      else if Cmd = cHSC_IMP_CurrentValues then
        ParseCurrentValuesResponse(response)

      else if Cmd = cHSC_IMP_TotalImpulses then
        ParseTotalImpulsesResponse(response)

      else if Cmd = cHSC_IMP_Impulses then
        ParseImpulsesResponse(response)
      // Ответ на запрос итогового времени проливки
      else if Cmd = cHSC_IMP_FinalStartStopTime then
        ParseFinalTimeResponse(response)
      // Ответ на запрос версии устройства и основных настроек
      else if Cmd = cHSC_IMP_Version then
        ParseVersionResponse(response)
      // Ответ на запрос итоговых значений каналов
      else if Cmd = cHSC_IMP_FinalImpulses then
        ParseFinalImpulsesResponse(response)

      // Ответ на запрос параметров отдельного канала.
      // Каналы используют разные адреса, поэтому
      // определение выполняется по адресу регистра.
      else if (Reg >= rHSC_IMP_ChannelStateMin) and
              (Reg <= rHSC_IMP_ChannelStateMax) and
              ((Reg and $000F) = rHSC_IMP_ChannelState) then
        ParseChannelStateResponse(response);
    except
      on E: Exception do
        OutputDebugString(PChar('TFmxModuleHSC_IMP.ReceiveResponse E:' + E.Message));
    end;
  end
  else
    ConnectIsOK := fdqDisguise;

end_of_procedure:
  if MustUpdate or NeedUpdate then
    inherited ReceiveResponse(command, response);
end;

function TFmxModuleHSC_IMP.Reset: Boolean;
var i:integer;
begin
 //Если нет используемых каналов - уходим
 if not HasActiveCounters then Exit;
 result:=TFmxModuleManager(ModuleManager).SendCommand(Self,PreparePack(address,cHSC_IMP_Stop),cHSC_IMP_Stop_Len);
 StartStopTime:=0;
 StartStopState:=sssReady;
 for I := 0 to cHSC_IMP_Max_ChannelNumber do
  begin
    // Количество импульсов на счетчиках
    FlowmeterImpulses[i]:=0;
    // Финальное количество импульсов на счетчиках
    FinalFlowmeterImpulses[i]:=0;
  end;
  FResultTime:=-1;
  FCurrentTime:=-1;
end;


