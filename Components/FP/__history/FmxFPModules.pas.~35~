procedure TFmxModuleLogoDAC.ReceiveResponse(command, response: ShortString);
var
  i: integer;
  s:ShortString;
  dataT:Word;
  tmpB:boolean;
  tmpF:Single;
  dataTBody:array[1..2] of byte absolute dataT;
label end_of_procedure;
begin

 if (command='') then
 begin
   ConnectIsOK := fdqBad;
   Exit;
 end;
 if response='' then goto  end_of_procedure;
 if not Disguise then
 begin
    if response='' then goto  end_of_procedure;
    //разбираем
    if command = StatusQuery then
    begin
      //11:34:25.732[<< USER] D0 03 00 00 00 05 97 88  //статус
      //11:34:25.997[PORT >>] D0 03 0A 00 03 00 01 00 01 00 00 00 00 20 56
      //                               [  0] [  1] [  2] [  3] [  4] [CRC]
      //временно пропускаем первый регистр
      //второй регистр содержит состояние конечников - пока тоже пропускаем
      //третий регистр содержит состояние выходов обтронов по маске 3 - 0 - не замкнут 1 - замкнут
      // 1 бит - канал 1, 2 бит - канал 2
      dataTBody[1]:=Ord(response[5]);
      dataTBody[2]:=Ord(response[4]);
      tmpB:=(dataT and 1) = 1;
      if (FStarted[0] <> tmpB) or NeedUpdate then
      begin
        FStarted[0]:= tmpB;
        FMustUpdate:=True;
      end;
      tmpB:=(dataT and 2) = 2;
      if (FStarted[1] <> tmpB) or NeedUpdate then
      begin
        FStarted[1]:= tmpB;
        FMustUpdate:=True;
      end;
      //4 регистр - значенеи ЦАП1
      dataTBody[1]:=Ord(response[11]);
      dataTBody[2]:=Ord(response[10]);
      if (FDAC[0]<>dataT) or NeedUpdate then//в процентах мощности
      begin
        FDAC[0]:=dataT;//в процентах мощности
        FMustUpdate:=True;
      end;
      //5 регистр - значенеи ЦАП2
      dataTBody[1]:=Ord(response[13]);
      dataTBody[2]:=Ord(response[12]);
      if (FDAC[1]<>dataT) or NeedUpdate then//в процентах мощности
      begin
        FDAC[1]:=dataT;//в процентах мощности
        FMustUpdate:=True;
      end;
    end;
    ConnectIsOK := fdqGood;
 end
 else
  ConnectIsOK := fdqDisguise;
end_of_procedure:
  if  MustUpdate then
    inherited ReceiveResponse(command, response);
end;

