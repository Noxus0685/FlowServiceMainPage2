function TFmxModuleHSC_FCD.SwitchFCD(FCD_number: Byte; in_tank: Boolean): Boolean;
begin
    ActiveChannel:=FCD_number;
    if Debug then
       OutputDebugString(PChar('Переключение УПП'+IntToStr(FCD_number+1)));
    //Прописываем номер активного переключателя -ячейка 0x0c
    UpdateActiveChannelCOM();

    if in_tank then
      case FCD_number of
      0: WritePack(cHSC_FCDSwitchToTank1,8);
      1: WritePack(cHSC_FCDSwitchToTank2,8);
      2: WritePack(cHSC_FCDSwitchToTank3,8);
      3: WritePack(cHSC_FCDSwitchToTank4,8);
      end
    else
      case FCD_number of
      0: WritePack(cHSC_FCDSwitchToPipe1,8);
      1: WritePack(cHSC_FCDSwitchToPipe2,8);
      2: WritePack(cHSC_FCDSwitchToPipe3,8);
      3: WritePack(cHSC_FCDSwitchToPipe4,8);
      end
end;

function TFmxModuleHSC_FCD.SwitchFCDWithSensors(FCD_number: Byte;
  time: Word): Boolean;
begin
    ActiveChannel:=FCD_number;
    WritePack(cHSC_FCDSelectChannel+AnsiChar(FCD_number),8);//Записывается номер активного переключателя потока YY, связанного с текущим Весовым Устройством (ВУ)
end;

function TFmxModuleHSC_FCD.SwitchFCDWithTimer(FCD_number: Byte;
  time: Word): Boolean;
  var
  tmpW:Word;
  tmpB:array[0..1] of byte absolute tmpW;
begin
    //Сброс ошибок
    ClearError();
    ActiveChannel:=FCD_number;
    UpdateActiveChannelCOM();
    WritePack(cHSC_FCDSetupStart,8); //старт по фронту сигнала внутренней синхронизации, останов по спаду
    //time умноженное на 10
    tmpW:=time div 10;
    WritePack(cHSC_FCDSwitchTime+AnsiChar(tmpB[1])+AnsiChar(tmpB[0]),8);//Устанавливаем время
    //Настройка выхода внутренней синхронизации
    WritePack(cHSC_FCDSetupSynchro,8);
    WritePack(cHSC_FCDSelectSynchro+AnsiChar(SynchroChannel),8);//Какие внешние выходы синхронизации задействовать 0x00 - все выходы синхронизации
    WritePack(cHSC_FCDSimulationOff,8);//отключение симуляции
    WritePack(cHSC_FCDSwitchToTank,8);//Производим запуск
end;

