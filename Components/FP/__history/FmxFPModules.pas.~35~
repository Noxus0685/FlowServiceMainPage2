    else if command = PreparePack(address,cVLTStop) then
    begin
        //  cVLTStop =#$06#$C3#$4F#$04#$3C;
        FMustUpdate:=True;
        tmpB:=Ord(response[6])=$3C;
        if (tmpB<>Started) or NeedUpdate then
        begin
           Started := False;
           FMustUpdate:=True;
        end;
    end;
    ConnectIsOK := fdqGood;
 end
 else
