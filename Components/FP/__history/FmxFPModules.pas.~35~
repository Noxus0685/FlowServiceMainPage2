{------------------------------------------------------------------------------
  Sends START command to the HSC-IMP controller.

  Low-level command only. No UI, no MASTER selection, no measurement loop.
------------------------------------------------------------------------------}
function TFmxModuleHSC_IMP.StartMeasurement: Boolean;
begin
  Result :=
    WriteUInt16Register(
      REG_CMD_STARTSTOP,
      HSC_IMP_CMD_START_MES
    );

  if Result then
    State := hmsStartWait;
end;

{------------------------------------------------------------------------------
  Sends MONITOR START command to the HSC-IMP controller.

  Low-level command only: writes value 2 to command register #11 and does not
  perform MASTER selection, UPP/flow-switch control, limits or external sync.
------------------------------------------------------------------------------}
function TFmxModuleHSC_IMP.StartMonitor: Boolean;
begin
  Result :=
    WriteUInt16Register(
      REG_CMD_STARTSTOP,
      HSC_IMP_CMD_START_MONITOR
    );

  if Result then
    State := hmsMonitorWait;
end;

{------------------------------------------------------------------------------
  Sends MONITOR STOP command to the HSC-IMP controller.

  The current firmware uses the same STOP value for measurement and monitor;
  keep this separate API so monitor code does not call measurement stop logic.
------------------------------------------------------------------------------}
function TFmxModuleHSC_IMP.StopMonitor: Boolean;
begin
  Result :=
    WriteUInt16Register(
      REG_CMD_STARTSTOP,
      HSC_IMP_CMD_STOP_MONITOR
    );

  if Result then
    State := hmsStopWait;
end;
