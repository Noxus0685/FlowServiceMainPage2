//============================================================================================================

function TFmxModuleVLT6000.CheckResponse(command, response: ShortString): Boolean;
begin
  Result := false;

  // Функция определяет, ответ на какую именно команду проверяется, а затем проверяет его.

  // Команда инициализации работы с модулем-устройством (она же использыется для обновления статуса).
  if command = StatusQuery then
    Result := response = 'A1061' + Chr(13);

  // Команда установки мощности насоса.
  if LeftStr(command, 9) = '>' + IntToHex(Address, 2) + '720300' then
    Result := response = 'A' + Chr(13);

  // Команда запуска насоса.
  if LeftStr(command, 11) = '>' + IntToHex(Address, 2) + '72040401' then
    Result := response = 'A' + Chr(13);

  // Команда остановки насоса.
  if LeftStr(command, 11) = '>' + IntToHex(Address, 2) + '72040400' then
    Result := response = 'A' + Chr(13);

  if Disguise then Result:=true;
end;

//============================================================================================================

procedure TFmxModuleVLT6000.ReceiveResponse(command, response: ShortString);
label end_of_procedure;
begin
 // Процедура определяет, ответ на какую именно команду пришел, а затем обрабатывает его.
 if not Disguise then
 begin
     if (command='') then
     begin
       //таймаут
       FMustUpdate:=True;
       ConnectIsOK := fdqBad;
       goto end_of_procedure;
     end;
    if response='' then goto  end_of_procedure;
    // Команда инициализации работы с модулем-устройством (она же использыется для обновления статуса).
    if command = StatusQuery then begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда установки мощности насоса.
    if LeftStr(command, 9) = '>' + IntToHex(Address, 2) + '720300' then begin
      Power :=ConvertStringToPower( Copy(command, 10, 8) );
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда запуска насоса.
    if LeftStr(command, 11) = '>' + IntToHex(Address, 2) + '72040401' then begin
      Started := true;
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда остановки насоса.
    if LeftStr(command, 11) = '>' + IntToHex(Address, 2) + '72040400' then begin
      Started := false;
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;
  end
  else begin
    ConnectIsOK := fdqDisguise;
  end;

end_of_procedure:
  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
end;

