function TFmxModuleModbusD.SetOutput(output_number: Byte;
  value: Boolean): Boolean;
  var
    Data: array[0..0] of Word;
    buff:TIdBytes;
    i:Integer;
    requeststr:ShortString;
begin
   //запись в COIL по адресу
   if value then
      { TODO : Надо уточнить, что подойдет для записи }
      Data[0]:=$ff00
   else
      Data[0]:=0;
   //начально
   SetLength(buff,0);
   case Protocol of
     tpProprietary: ;
     tpModbusRTU: begin
       BuildWriteSingleRegisterRequest(Address and $ff,OutputRegister,Data[0],mmRTU,buff,FResponseLength);
     end;
     tpModbusASCII: begin
       BuildWriteSingleRegisterRequest(Address and $ff,OutputRegister,Data[0],mmASCII,buff,FResponseLength);
     end;
     tpModbusTCP: begin
       requeststr:='';
       ResponseLength:=12;
       //с перспективой поддержать и два других протокола
       RequestedModBusFunction:=mbfWriteOneCoil;
       buff:=modbus_tcp_PrepareSendBuff(mbfWriteOneCoil,UnitID,BaseRegister,OutputRegister+output_number+1,GetNewTransactionID(),1,Data);
//       for I := Low(buff) to High(buff) do
//           requeststr:=requeststr+AnsiChar(buff[i]);
     end;
   end;
   requeststr:=IdBytesToStr(buff);
   result:=TFmxModuleManager(ModuleManager).SendCommand(Self,requeststr,ResponseLength);
   //ответ приходит сначала в CheckResponce
   //затем - если последний вернул положительный ответ - в ReceiveResponce
end;




