procedure TFmxModuleATV312.ReceiveResponse(command, response: ShortString);
label end_of_procedure;
begin
  if not Disguise then
  begin
    // Процедура определяет, ответ на какую именно команду пришел, а затем обрабатывает его.
     if (command='') then
     begin
       //таймаут
       ConnectIsOK := fdqBad;
       FMustUpdate:=True;
       goto end_of_procedure;
     end;

    if response='' then goto  end_of_procedure;
    // Команда инициализации работы с модулем-устройством (она же использыется для обновления статуса).
    if command = StatusQuery then begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда установки мощности насоса.
    if command = AddCRCMdbRTU(ShortString(IntToHex(Address, 2))+ShortString('062136')+IntToHex(Round(10*power),4)) then begin
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда запуска насоса.
    if command = AddCRCMdbRTU(ShortString(IntToHex(Address, 2))+ShortString('062135000F')) then begin
      Started := true;
      FMustUpdate:=True;
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;

    // Команда остановки насоса.
    if command = AddCRCMdbRTU(ShortString(IntToHex(Address, 2))+ShortString('0621350006')) then begin
      Started := false;
      FMustUpdate:=True;
      ConnectIsOK := fdqGood;
      goto end_of_procedure;
    end;
  end
  else
    ConnectIsOK := fdqDisguise;
end_of_procedure:
  if MustUpdate or NeedUpdate then
     inherited ReceiveResponse(command, response);
