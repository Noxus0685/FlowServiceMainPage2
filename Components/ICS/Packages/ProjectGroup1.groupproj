<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{26301991-1A11-4DB3-B248-BED63DAA90C5}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="IcsFmxNewRun.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="IcsFmxNewDesign.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="IcsFmxNewRun">
        <MSBuild Projects="IcsFmxNewRun.dproj"/>
    </Target>
    <Target Name="IcsFmxNewRun:Clean">
        <MSBuild Projects="IcsFmxNewRun.dproj" Targets="Clean"/>
    </Target>
    <Target Name="IcsFmxNewRun:Make">
        <MSBuild Projects="IcsFmxNewRun.dproj" Targets="Make"/>
    </Target>
    <Target Name="IcsFmxNewDesign">
        <MSBuild Projects="IcsFmxNewDesign.dproj"/>
    </Target>
    <Target Name="IcsFmxNewDesign:Clean">
        <MSBuild Projects="IcsFmxNewDesign.dproj" Targets="Clean"/>
    </Target>
    <Target Name="IcsFmxNewDesign:Make">
        <MSBuild Projects="IcsFmxNewDesign.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="IcsFmxNewRun;IcsFmxNewDesign"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="IcsFmxNewRun:Clean;IcsFmxNewDesign:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="IcsFmxNewRun:Make;IcsFmxNewDesign:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
